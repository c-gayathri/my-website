---
// Studio shell: fonts, nav, footer. Separate visual universe from the
// research page — shares only the BaseLayout document shell.
import BaseLayout from './BaseLayout.astro';
import StudioNav from '../components/studio/StudioNav.astro';
import { studioConfig } from '../data/studioConfig';
import { externalLinks } from '../data/externalLinks';

import '@fontsource/cormorant-garamond/400.css';
import '@fontsource/cormorant-garamond/500.css';
import '@fontsource/cormorant-garamond/600.css';
import '@fontsource/cormorant-garamond/400-italic.css';
import '@fontsource/space-mono/400.css';
import '@fontsource/space-mono/700.css';
import '../styles/studio.css';

interface Props {
  title: string;
  description?: string;
  /** full-bleed pages (constellation) skip the standard page frame */
  fullBleed?: boolean;
  /** detail pages: one-line header */
  slim?: boolean;
  /** inner section pages: title shown topmost in the header */
  section?: string;
}

const {
  title,
  description = `${studioConfig.name} — studio. Images, words, moving things, experiments.`,
  fullBleed = false,
  slim = false,
  section,
} = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
const elsewhere = Object.entries(externalLinks).filter(
  ([key, href]) => key !== 'research' && href,
);
---

<BaseLayout title={title} description={description}>
  <div class:list={['studio', { 'studio-full': fullBleed }]}>
    <StudioNav variant={slim ? 'slim' : 'full'} section={section} />
    <main class:list={['studio-main', { 's-page': !fullBleed }]}>
      <slot />
    </main>

    <footer class:list={['studio-footer', { 'footer-canvas': fullBleed }]}>
      <a class="footer-wordmark s-link" href={`${base}/studio/`}>STUDIO<span class="dot">.</span></a>
      <div class="elsewhere">
        <span class="s-meta">elsewhere</span>
        {
          elsewhere.map(([key, href]) => (
            <a class="s-link" href={href} rel="external" target="_blank">
              {key} ↗
            </a>
          ))
        }
        <a class="s-link" href={`${base}${externalLinks.research}`} target="_blank">research ↗</a>
      </div>
      {!fullBleed && <span class="s-meta">© {new Date().getFullYear()} {studioConfig.name}</span>}
    </footer>
  </div>
</BaseLayout>

<style>
  .studio {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
  }

  /* full-bleed pages: the canvas owns the viewport; the footer overlays it */
  .studio-full {
    position: relative;
    height: 100vh;
    height: 100dvh;
    overflow: hidden;
  }

  .studio-full .studio-main {
    flex: 1;
    min-height: 0;
    display: flex;
    flex-direction: column;
  }

  .studio-full .studio-main > :global(*) {
    flex: 1;
  }

  .studio-full .studio-footer {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 10;
  }

  /* full-bleed pages manage their own frame */
  .studio-main.s-page {
    padding-top: 12px;
  }

  .studio-footer {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 20px;
    padding: 20px clamp(24px, 4vw, 72px) 26px;
  }

  .footer-wordmark {
    font-family: var(--s-mono);
    font-size: 12px;
    letter-spacing: 0.22em;
    color: var(--s-ink);
  }

  .footer-wordmark .dot {
    color: var(--s-grey);
  }

  .elsewhere {
    display: flex;
    align-items: baseline;
    gap: 20px;
    flex-wrap: wrap;
    margin-left: auto;
    margin-right: auto;
  }
</style>
