---
// Research homepage. All text comes from src/data/ — edit there, not here.
//
// Desktop layout: the whole page fits the first viewport. The projects
// panel and the news list scroll internally; the page itself does not
// scroll. Below 900px this is disabled and the page scrolls normally.
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import Hero from '../components/Hero.astro';
import ProjectEntry from '../components/ProjectEntry.astro';
import Education from '../components/Education.astro';
import NewsList from '../components/NewsList.astro';
import '../styles/research.css';

import { profile, outsideResearch } from '../data/profile';
import { projects } from '../data/projects';

const { name } = profile;
const year = new Date().getFullYear();
---

<BaseLayout
  title={`${name} — AI Researcher`}
  description="Gayathri Neela Chandran is an AI researcher working on theoretically motivated problems in machine learning: large language models, reinforcement learning, and learning theory."
>
  <div class="page">
    <SiteHeader />

    <div class="main">
      <div class="hero-panel">
        <Hero />
      </div>

      <section class="projects" aria-labelledby="projects-heading">
        <h2 class="section-label" id="projects-heading">Research Projects</h2>
        <div class="projects-scroll">
          {projects.map((project) => <ProjectEntry project={project} />)}
        </div>
      </section>
    </div>

    <div class="band">
      <div class="panel education-panel">
        <Education />
      </div>
      <div class="panel news-panel">
        <NewsList />
      </div>
      <div class="panel outside-panel">
        <p class="outside">{outsideResearch}</p>
      </div>
    </div>

    <footer class="site-footer">
      <p>© {year} {name}</p>
    </footer>
  </div>
</BaseLayout>

<style>
  /* Fixed first-screen layout on desktop: header / main / band / footer */
  .page {
    height: 100vh;
    height: 100dvh;
    max-width: 1680px;
    margin: 0 auto;
    padding: 0 clamp(24px, 4vw, 72px);
    display: grid;
    grid-template-rows: auto minmax(0, 1fr) auto auto;
  }

  /* Hero column + scrolling projects column */
  .main {
    display: grid;
    grid-template-columns: minmax(270px, 360px) minmax(0, 1fr);
    gap: clamp(40px, 5vw, 96px);
    min-height: 0;
    padding-top: clamp(12px, 3vh, 40px);
  }

  .hero-panel {
    min-height: 0;
    overflow-y: auto;
    scrollbar-width: thin;
    scrollbar-color: var(--rule-strong) transparent;
  }

  .projects {
    min-height: 0;
    display: flex;
    flex-direction: column;
  }

  .projects .section-label {
    margin-bottom: 18px;
  }

  .projects-scroll {
    flex: 1 1 0;
    min-height: 0;
    overflow-y: auto;
    padding-right: 12px;
    padding-bottom: 8px;
    scrollbar-width: thin;
    scrollbar-color: var(--rule-strong) transparent;
  }

  /* Education | News | outside-research band */
  .band {
    display: grid;
    grid-template-columns: 0.9fr 1.4fr 0.9fr;
    align-items: stretch;
    min-height: clamp(150px, 20vh, 220px);
    border-top: 1px solid var(--rule);
    margin-top: clamp(12px, 3vh, 40px);
  }

  .panel {
    padding: 20px clamp(28px, 3vw, 56px);
  }

  .education-panel {
    padding-left: 0;
  }

  .outside-panel {
    padding-right: 0;
    display: flex;
    align-items: center; /* vertically centre the hobbies text */
  }

  .news-panel,
  .outside-panel {
    border-left: 1px solid var(--rule-strong);
  }

  .outside {
    font-size: 14px;
    line-height: 1.7;
    color: var(--ink-soft);
    margin: 0;
    max-width: 32ch;
  }

  .site-footer {
    padding: 6px 0 12px;
  }

  .site-footer p {
    margin: 0;
    font-size: 12px;
    color: var(--ink-faint);
  }

  /* Slim scrollbars where panels scroll */
  @supports selector(::-webkit-scrollbar) {
    .projects-scroll::-webkit-scrollbar,
    .news-scroll::-webkit-scrollbar {
      width: 6px;
    }

    .projects-scroll::-webkit-scrollbar-thumb,
    .news-scroll::-webkit-scrollbar-thumb {
      background: var(--rule-strong);
      border-radius: 3px;
    }
  }

  /* Mobile: normal document flow, no internal scrolling */
  @media (max-width: 899px) {
    .page {
      height: auto;
      padding: 0 clamp(20px, 6vw, 40px);
    }

    .main {
      grid-template-columns: 1fr;
      gap: 44px;
      padding-top: 28px;
    }

    .hero-panel {
      overflow: visible;
    }

    .projects {
      display: block;
      overflow: visible;
    }

    .projects-scroll {
      overflow: visible;
      padding-right: 0;
      padding-bottom: 0;
    }

    .band {
      grid-template-columns: 1fr;
      margin-top: 48px;
      min-height: 0;
    }

    .panel {
      padding: 26px 0;
    }

    .education-panel {
      padding-top: 0;
    }

    .news-panel,
    .outside-panel {
      border-left: none;
      border-top: 1px solid var(--rule);
    }

    .outside-panel {
      padding-bottom: 0;
      display: block;
    }

    .outside {
      max-width: none;
    }

    .site-footer {
      padding: 8px 0 32px;
    }
  }
</style>
