---
// TEMPORARY placeholder so the "Studio ↗" link on the homepage doesn't 404.
// The real experimental Studio (spatial canvas, project pages, notepad,
// bookshelf, photography) replaces this page entirely later.
import BaseLayout from '../../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
---

<BaseLayout
  title="Studio — Gayathri Neela Chandran"
  description="Creative studio — under construction."
>
  <main class="stub">
    <p>Studio — under construction.</p>
    <p><a href={`${base}/`}>← Research homepage</a></p>
  </main>
</BaseLayout>

<style>
  .stub {
    min-height: 100vh;
    display: grid;
    place-content: center;
    gap: 6px;
    text-align: center;
    font-size: 14px;
    color: #4c4c46;
  }

  p {
    margin: 0;
  }
</style>
