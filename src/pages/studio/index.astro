---
// The Studio homepage — the constellation itself.
// Someone arriving directly here should immediately understand whose site
// this is: the nav carries the name; the constellation is the content.
import { getCollection } from 'astro:content';
import { getImage } from 'astro:assets';
import StudioLayout from '../../layouts/StudioLayout.astro';
import Constellation from '../../components/studio/Constellation';
import { studioConfig } from '../../data/studioConfig';

const clusters = await getCollection('clusters');
const projects = await getCollection('projects');
const base = import.meta.env.BASE_URL.replace(/\/+$/, '');

function hashStr(s: string): number {
  let h = 2166136261;
  for (let i = 0; i < s.length; i++) {
    h ^= s.charCodeAt(i);
    h = Math.imul(h, 16777619);
  }
  return h >>> 0;
}

const data = await Promise.all(
  clusters.map(async (c) => {
    const projs = projects.filter((p) => p.data.clusters.includes(c.id));
    const imgs = projs
      .flatMap((p) => [p.data.thumbnail ?? p.data.hero, ...(p.data.gallery ?? [])])
      .filter((im): im is NonNullable<typeof im> => Boolean(im))
      .slice(0, 5);
    const images = await Promise.all(
      imgs.map(async (im) => {
        const g = await getImage({ src: im, width: 640 });
        return { src: g.src, w: im.width, h: im.height };
      }),
    );
    return {
      id: c.id,
      slug: c.id,
      title: c.data.title,
      x: c.data.desktop.x,
      y: c.data.desktop.y,
      width: c.data.desktop.width,
      driftRadius: c.data.desktop.driftRadius,
      color:
        c.data.hoverColor ??
        studioConfig.palette[hashStr(c.id) % studioConfig.palette.length],
      projectCount: projs.length,
      hoverDescription: c.data.hoverDescription ?? c.data.description,
      featured: c.data.featured,
      images,
      connections: c.data.connections,
    };
  }),
);
---

<StudioLayout title={`Studio — ${studioConfig.name}`} fullBleed>
  <div class="constellation-page">
    <Constellation
      client:load
      clusters={data}
      config={{ seed: studioConfig.layoutSeed, world: { ...studioConfig.world } }}
      basePath={base}
    />
    <p class="s-meta hint">drag to explore · scroll to zoom</p>
  </div>
</StudioLayout>

<style>
  .constellation-page {
    position: relative;
    height: clamp(540px, calc(100dvh - 158px), 1200px);
  }

  .hint {
    position: absolute;
    left: clamp(24px, 4vw, 72px);
    bottom: 14px;
    margin: 0;
    color: var(--s-faint);
  }
</style>

<style is:global>
  /* island styles live here so they can target rendered children */
  .constellation {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
    background: var(--s-bg);
  }

  .constellation-cluster {
    position: absolute;
    display: block;
    text-decoration: none;
    color: inherit;
  }

  .constellation-cluster img {
    position: absolute;
    height: auto;
    display: block;
    box-shadow: 0 2px 16px rgba(20, 18, 10, 0.09);
    transition: transform 0.35s ease;
  }

  .constellation-cluster:hover img:first-child,
  .constellation-cluster:focus-visible img:first-child {
    transform: scale(1.02);
  }
</style>
