---
// The Studio homepage — the constellation itself.
// Someone arriving directly here should immediately understand whose site
// this is: the nav carries the name; the constellation is the content.
import { getCollection } from 'astro:content';
import { getImage } from 'astro:assets';
import StudioLayout from '../../layouts/StudioLayout.astro';
import Constellation from '../../components/studio/Constellation';
import { generateClusterAnchors, studioConfig } from '../../data/studioConfig';
import { clusterOrder } from '../../data/clusterOrder';
import { projectOrder } from '../../data/projectOrder';
import { projectPreviewImages } from '../../utils/projectPreviewImages';
import '../../styles/constellation.css';

const clusters = (await getCollection('clusters')).filter((cluster) => cluster.id !== 'photography');
const projects = (await getCollection('projects')).filter(
  (project) => !project.data.clusters.includes('photography'),
);
const base = import.meta.env.BASE_URL.replace(/\/+$/, '');

// World MUST match generateClusterAnchors() scaling so star-field bounds
// and cluster anchors share the same box. Run `npm run constellation:update`
// after adding/removing a cluster to verify coverage.
const anchorScale = Math.max(1.35, Math.sqrt(Math.max(1, clusters.length) / 6) * 1.38);
const world = {
  width: studioConfig.world.width * anchorScale,
  height: studioConfig.world.height * anchorScale,
};

const generatedAnchors = generateClusterAnchors(
  clusters.map((cluster) => ({
    id: cluster.id,
    title: cluster.data.title,
    description: cluster.data.description,
  })),
  clusterOrder,
);

function hashStr(s: string): number {
  let h = 2166136261;
  for (let i = 0; i < s.length; i++) {
    h ^= s.charCodeAt(i);
    h = Math.imul(h, 16777619);
  }
  return h >>> 0;
}

const data = await Promise.all(
  clusters.map(async (c) => {
    // Order per clusterOrder / projectOrder — featured cap at 5.
    const orderList = projectOrder[c.id] ?? [];
    const allForCluster = projects.filter((p) => p.data.clusters.includes(c.id));
    const byId = new Map(allForCluster.map((p) => [p.id, p]));
    const orderedProjects = orderList
      .map((id) => byId.get(id))
      .filter(Boolean) as typeof allForCluster;
    // Keep explicitly ordered projects first; append unlisted projects using
    // the same featured/name fallback as the cluster page.
    const missing = allForCluster.filter((p) => !orderList.includes(p.id));
    missing.sort((a, b) => {
      const featured = Number(b.data.featured) - Number(a.data.featured);
      return featured || a.id.localeCompare(b.id);
    });
    const fullOrdered = [...orderedProjects, ...missing];

    type ProjectImage = NonNullable<(typeof allForCluster)[number]['data']['hero']>;
    const pickImage = (project: (typeof allForCluster)[number]): ProjectImage | null => {
      const image = projectPreviewImages(project.data)[0];
      return image ? (image as ProjectImage) : null;
    };

    // Keep the first project image as the default cluster preview. Feature
    // flags may affect the rest of the collage, but not its first image.
    const featured = fullOrdered.filter((p) => p.data.featured);
    const firstProject = fullOrdered.find((p) => pickImage(p));
    const remaining = (featured.length ? featured : fullOrdered).filter((p) => p !== firstProject);
    const chosen = [firstProject, ...remaining].filter(Boolean).slice(0, 5) as typeof allForCluster;

    const seen = new Set<string>();
    const imgs: Array<{ projectId: string; image: ProjectImage }> = [];
    for (const project of chosen) {
      const image = pickImage(project);
      if (!image || seen.has((image as any).src)) continue;
      seen.add((image as any).src);
      imgs.push({ projectId: project.id, image });
    }
    const renderedImages = await Promise.all(
      imgs.map(async ({ projectId, image }) => {
        const g = await getImage({ src: image, width: 640 });
        return { src: g.src, w: image.width, h: image.height, projectId };
      }),
    );
    const explicitPreview = c.data.previewImage
      ? await getImage({ src: c.data.previewImage, width: 640 })
      : null;
    const images = explicitPreview
      ? [
          {
            src: explicitPreview.src,
            w: c.data.previewImage!.width,
            h: c.data.previewImage!.height,
            projectId: firstProject?.id ?? '',
          },
          ...renderedImages.filter((image) => image.src !== explicitPreview.src),
        ]
      : renderedImages;
    const generated = generatedAnchors[c.id];
    const legacyOverride = c.data.desktop;
    const normalizedOverride = c.data.generatedThenOverrideable;
    return {
      id: c.id,
      slug: c.id,
      title: c.data.title,
      x: normalizedOverride?.x !== undefined
        ? normalizedOverride.x * world.width
        : legacyOverride?.x ?? generated.x,
      y: normalizedOverride?.y !== undefined
        ? normalizedOverride.y * world.height
        : legacyOverride?.y ?? generated.y,
      width: 1.25 * (normalizedOverride?.width !== undefined
        ? normalizedOverride.width * world.width
        : legacyOverride?.width ?? generated.width * 1.4),
      driftRadius: legacyOverride?.driftRadius ?? 15,
      depth: legacyOverride?.depth ?? 1,
      color: studioConfig.palette[hashStr(c.id) % studioConfig.palette.length],
      projectCount: allForCluster.length,
      // The hover panel repeats the authored cluster description exactly.
      hoverDescription: c.data.description,
      featured: clusterOrder.slice(0, 6).includes(c.id),
      images,
    };
  }),
);
---

<StudioLayout
  title={`Studio — ${studioConfig.name}`}
  fullBleed
  hint="drag to explore · scroll to zoom · click a cluster to open"
>
  <div class="constellation-page">
    <Constellation
      client:load
      clusters={data}
      config={{
        seed: studioConfig.layoutSeed,
        world: { ...world },
        zoom: { ...studioConfig.zoom },
        drift: {
          periodSeconds: studioConfig.drift.periodSeconds,
          hoverMultiplier: studioConfig.drift.hoverMultiplier,
        },
      }}
      basePath={base}
    />
  </div>
</StudioLayout>

<style>
  .constellation-page {
    position: relative;
    width: 100%;
    height: 100%;
    min-height: 540px;
  }
</style>
