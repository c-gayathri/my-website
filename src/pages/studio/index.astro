---
// The Studio homepage — the constellation itself.
// Someone arriving directly here should immediately understand whose site
// this is: the nav carries the name; the constellation is the content.
import { getCollection } from 'astro:content';
import { getImage } from 'astro:assets';
import StudioLayout from '../../layouts/StudioLayout.astro';
import Constellation from '../../components/studio/Constellation';
import { studioConfig } from '../../data/studioConfig';

const clusters = await getCollection('clusters');
const projects = await getCollection('projects');
const base = import.meta.env.BASE_URL.replace(/\/+$/, '');

function hashStr(s: string): number {
  let h = 2166136261;
  for (let i = 0; i < s.length; i++) {
    h ^= s.charCodeAt(i);
    h = Math.imul(h, 16777619);
  }
  return h >>> 0;
}

const data = await Promise.all(
  clusters.map(async (c) => {
    const projs = projects.filter((p) => p.data.clusters.includes(c.id));
    const imgs = projs
      .flatMap((p) => [p.data.thumbnail ?? p.data.hero, ...(p.data.gallery ?? [])])
      .filter((im): im is NonNullable<typeof im> => Boolean(im))
      .slice(0, 5);
    const images = await Promise.all(
      imgs.map(async (im) => {
        const g = await getImage({ src: im, width: 640 });
        return { src: g.src, w: im.width, h: im.height };
      }),
    );
    return {
      id: c.id,
      slug: c.id,
      title: c.data.title,
      x: c.data.desktop.x,
      y: c.data.desktop.y,
      width: c.data.desktop.width,
      driftRadius: c.data.desktop.driftRadius,
      depth: c.data.desktop.depth,
      color:
        c.data.hoverColor ??
        studioConfig.palette[hashStr(c.id) % studioConfig.palette.length],
      projectCount: projs.length,
      hoverDescription: c.data.hoverDescription ?? c.data.description,
      featured: c.data.featured,
      images,
      connections: c.data.connections,
    };
  }),
);
---

<StudioLayout title={`Studio — ${studioConfig.name}`} fullBleed>
  <div class="constellation-page">
    <Constellation
      client:load
      clusters={data}
      config={{
        seed: studioConfig.layoutSeed,
        world: { ...studioConfig.world },
        zoom: { ...studioConfig.zoom },
        drift: {
          periodSeconds: studioConfig.drift.periodSeconds,
          hoverMultiplier: studioConfig.drift.hoverMultiplier,
        },
      }}
      basePath={base}
    />
    <p class="s-meta hint">drag to explore · scroll to zoom · click a cluster to open</p>
  </div>
</StudioLayout>

<style>
  .constellation-page {
    position: relative;
    width: 100%;
    height: 100%;
    min-height: 540px;
  }

  .hint {
    position: absolute;
    left: clamp(24px, 4vw, 72px);
    bottom: 14px;
    margin: 0;
    color: var(--s-faint);
  }
</style>

<style is:global>
  /* island styles live here so they can target rendered children */

  .constellation {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
    background: var(--s-bg);
    cursor: grab;
    touch-action: pan-y;
  }

  .constellation.grabbing {
    cursor: grabbing;
  }

  .star-layer,
  .twinkle-layer,
  .splotch-layer {
    position: absolute;
    inset: 0;
  }

  .star-layer {
    color: var(--s-ink);
    transition: color 0.45s ease;
  }

  .twinkle-layer {
    color: #fff;
    pointer-events: none;
    z-index: 2;
  }

  .splotch-layer {
    pointer-events: none;
    z-index: 1;
    overflow: visible;
  }

  .splotch-layer path {
    opacity: 0;
    transition:
      transform 0.72s cubic-bezier(0.22, 1, 0.36, 1),
      opacity 0.3s ease;
    will-change: transform;
  }

  .splotch-layer path.open {
    opacity: 1;
  }

  /* hovered state: geometry turns white, lines shimmer, stars pulse */
  .constellation.hovered {
    cursor: pointer;
  }

  .constellation.hovered .star-layer {
    color: #fff;
  }

  .constellation.hovered .star-layer path.ln {
    stroke-dasharray: 5 9;
    animation: line-shimmer 2.4s linear infinite;
  }

  @keyframes line-shimmer {
    to {
      stroke-dashoffset: -56;
    }
  }

  .constellation.hovered .star-layer g.pulse {
    animation: star-pulse 2.2s ease-in-out infinite alternate;
  }

  .constellation.hovered .star-layer g.pulse:nth-child(3n) {
    animation-delay: -0.9s;
  }

  .constellation.hovered .star-layer g.pulse:nth-child(4n) {
    animation-delay: -1.5s;
  }

  @keyframes star-pulse {
    from {
      opacity: 0.72;
    }
    to {
      opacity: 1;
    }
  }

  /* pointillist spawn/despawn */
  .twinkle-layer .tw {
    opacity: 0;
    animation-name: twinkle-blink;
    animation-timing-function: linear;
    animation-iteration-count: infinite;
    animation-play-state: paused;
  }

  .constellation.hovered .twinkle-layer .tw {
    animation-play-state: running;
  }

  @keyframes twinkle-blink {
    0% {
      opacity: 0;
    }
    4% {
      opacity: 0.95;
    }
    16% {
      opacity: 0.85;
    }
    22% {
      opacity: 0;
    }
    100% {
      opacity: 0;
    }
  }

  /* clusters */
  .constellation-cluster {
    position: absolute;
    top: 0;
    left: 0;
    display: block;
    text-decoration: none;
    color: inherit;
    transform-origin: 50% 50%;
    transition: opacity 0.45s ease;
    will-change: transform;
  }

  .constellation-cluster.dimmed {
    opacity: 0;
    pointer-events: none;
  }

  .constellation-cluster.active {
    z-index: 5;
  }

  .constellation-cluster img {
    position: absolute;
    height: auto;
    display: block;
    box-shadow: 0 2px 16px rgba(20, 18, 10, 0.09);
  }

  /* title plate — visible at rest and in map view, gone while hovering */
  .constellation-cluster .plate {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    z-index: 30;
    background: var(--s-bg);
    color: var(--s-ink);
    font-family: var(--s-mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    padding: 5px 11px;
    white-space: nowrap;
    transition: opacity 0.4s ease;
  }

  .constellation.hovered .constellation-cluster .plate {
    opacity: 0;
  }

  /* map mode — zoomed out: images fade, title plates remain */
  .constellation.map .constellation-cluster img {
    opacity: 0;
  }

  .constellation.map .constellation-cluster.active img {
    opacity: 1;
  }

  /* map margins dissolve */
  .constellation.map .star-layer {
    -webkit-mask-image: radial-gradient(115% 115% at 50% 50%, #000 52%, transparent 88%);
    mask-image: radial-gradient(115% 115% at 50% 50%, #000 52%, transparent 88%);
    opacity: 0.65;
  }

  .constellation.map .twinkle-layer {
    opacity: 0;
  }

  /* view controls — focus / map */
  .view-controls {
    position: absolute;
    right: clamp(18px, 2.6vw, 40px);
    top: 50%;
    transform: translateY(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    z-index: 9;
  }

  .view-controls button {
    font-family: var(--s-mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    color: var(--s-grey);
    background: none;
    border: none;
    padding: 4px 2px;
    cursor: pointer;
  }

  .view-controls button:hover {
    color: var(--s-ink);
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .view-controls button[aria-pressed='true'] {
    color: var(--s-ink);
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .view-controls span {
    color: var(--s-faint);
    font-size: 10px;
  }

  /* cluster info block (anchored to the active cluster) */
  .cluster-info {
    position: absolute;
    z-index: 8;
    color: #fff;
    max-width: 360px;
    pointer-events: none;
    animation: info-in 0.5s cubic-bezier(0.22, 1, 0.36, 1);
  }

  @keyframes info-in {
    from {
      opacity: 0;
      translate: 0 10px;
    }
    to {
      opacity: 1;
      translate: 0 0;
    }
  }

  .cluster-info .ci-kicker {
    font-family: var(--s-mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    margin: 0 0 10px;
    opacity: 0.85;
  }

  .cluster-info .ci-title {
    font-family: var(--s-serif);
    font-weight: 500;
    font-size: clamp(30px, 3.4vw, 46px);
    line-height: 1.02;
    margin: 0 0 12px;
  }

  .cluster-info .ci-desc {
    font-family: var(--s-mono);
    font-size: 12.5px;
    line-height: 1.7;
    margin: 0 0 14px;
    opacity: 0.95;
    max-width: 40ch;
  }

  .cluster-info .ci-meta {
    font-family: var(--s-mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    margin: 0 0 10px;
  }

  .cluster-info .ci-link {
    font-family: var(--s-mono);
    font-size: 12px;
    color: #fff;
    text-decoration: underline;
    text-underline-offset: 4px;
    pointer-events: auto;
  }

  /* hover: the colour reaches the header — so the header reads white */
  body[data-studio-hover] .studio-nav a,
  body[data-studio-hover] .studio-nav .name,
  body[data-studio-hover] .studio-nav .tagline {
    color: #fff;
  }

  /* while hovering, the studio chrome steps back */
  body[data-studio-hover] .studio-footer,
  body[data-studio-hover] .hint {
    opacity: 0;
    pointer-events: none;
  }

  .studio-footer,
  .hint {
    transition: opacity 0.4s ease;
  }

  @media (prefers-reduced-motion: reduce) {
    .constellation *,
    .constellation {
      transition: none !important;
      animation: none !important;
    }
  }
</style>
