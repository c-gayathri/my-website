---
// The Studio homepage — the constellation itself.
// Someone arriving directly here should immediately understand whose site
// this is: the nav carries the name; the constellation is the content.
import { getCollection } from 'astro:content';
import { getImage } from 'astro:assets';
import StudioLayout from '../../layouts/StudioLayout.astro';
import Constellation from '../../components/studio/Constellation';
import { generateClusterAnchors, studioConfig } from '../../data/studioConfig';
import { clusterOrder } from '../../data/clusterOrder';
import { projectOrder } from '../../data/projectOrder';
import '../../styles/constellation.css';

const clusters = await getCollection('clusters');
const projects = await getCollection('projects');
const base = import.meta.env.BASE_URL.replace(/\/+$/, '');

// World grows as sqrt(N) so area scales linearly.
const worldScale = Math.sqrt(Math.max(1, clusters.length / 10));
const world = {
  width: studioConfig.world.width * (clusters.length > 10 ? worldScale : 1),
  height: studioConfig.world.height * (clusters.length > 10 ? worldScale : 1),
};

const generatedAnchors = generateClusterAnchors(
  clusters.map((cluster) => ({
    id: cluster.id,
    title: cluster.data.title,
    description: cluster.data.description,
  })),
  clusterOrder,
);

function hashStr(s: string): number {
  let h = 2166136261;
  for (let i = 0; i < s.length; i++) {
    h ^= s.charCodeAt(i);
    h = Math.imul(h, 16777619);
  }
  return h >>> 0;
}

const data = await Promise.all(
  clusters.map(async (c) => {
    // Order per clusterOrder / projectOrder — featured cap at 5.
    const orderList = projectOrder[c.id] ?? [];
    const allForCluster = projects.filter((p) => p.data.clusters.includes(c.id));
    const byId = new Map(allForCluster.map((p) => [p.id, p]));
    const orderedProjects = orderList
      .map((id) => byId.get(id))
      .filter(Boolean) as typeof allForCluster;
    // Append any missing projects (new ones) to top, dedup
    const missing = allForCluster.filter((p) => !orderList.includes(p.id));
    const fullOrdered = [...missing, ...orderedProjects];

    // Prefer featured (≤5), else first 5 in order
    const featured = fullOrdered.filter((p) => p.data.featured);
    const chosen = (featured.length ? featured : fullOrdered).slice(0, 5);

    type ProjectImage = NonNullable<(typeof chosen)[number]['data']['hero']>;
    const pickImage = (project: (typeof chosen)[number]): ProjectImage | null => {
      const feat = project.data.featuredImage;
      if (feat) {
        const pool = [project.data.hero, project.data.thumbnail, project.data.videoPoster, ...project.data.gallery].filter(Boolean) as ProjectImage[];
        const hit = pool.find((img: any) => String(img.src).includes(feat));
        if (hit) return hit as ProjectImage;
      }
      const image = project.data.thumbnail ?? project.data.hero ?? project.data.videoPoster ?? project.data.gallery[0];
      return image ? (image as ProjectImage) : null;
    };

    const seen = new Set<string>();
    const imgs: Array<{ projectId: string; image: ProjectImage }> = [];
    for (const project of chosen) {
      const image = pickImage(project);
      if (!image || seen.has((image as any).src)) continue;
      seen.add((image as any).src);
      imgs.push({ projectId: project.id, image });
    }
    const images = await Promise.all(
      imgs.map(async ({ projectId, image }) => {
        const g = await getImage({ src: image, width: 640 });
        return { src: g.src, w: image.width, h: image.height, projectId };
      }),
    );
    const generated = generatedAnchors[c.id];
    const legacyOverride = c.data.desktop;
    const normalizedOverride = c.data.generatedThenOverrideable;
    return {
      id: c.id,
      slug: c.id,
      title: c.data.title,
      x: normalizedOverride?.x !== undefined
        ? normalizedOverride.x * world.width
        : legacyOverride?.x ?? generated.x,
      y: normalizedOverride?.y !== undefined
        ? normalizedOverride.y * world.height
        : legacyOverride?.y ?? generated.y,
      width: normalizedOverride?.width !== undefined
        ? normalizedOverride.width * world.width
        : legacyOverride?.width ?? generated.width * 1.4,
      driftRadius: legacyOverride?.driftRadius ?? 10,
      depth: legacyOverride?.depth ?? 1,
      color:
        c.data.hoverColor ??
        studioConfig.palette[hashStr(c.id) % studioConfig.palette.length],
      projectCount: allForCluster.length,
      hoverDescription: c.data.hoverDescription ?? c.data.description,
      featured: clusterOrder.slice(0, 6).includes(c.id),
      images,
    };
  }),
);
---

<StudioLayout
  title={`Studio — ${studioConfig.name}`}
  fullBleed
  hint="drag to explore · scroll to zoom · click a cluster to open"
>
  <div class="constellation-page">
    <Constellation
      client:load
      clusters={data}
      config={{
        seed: studioConfig.layoutSeed,
        world: { ...world },
        zoom: { ...studioConfig.zoom },
        drift: {
          periodSeconds: studioConfig.drift.periodSeconds,
          hoverMultiplier: studioConfig.drift.hoverMultiplier,
        },
      }}
      basePath={base}
    />
  </div>
</StudioLayout>

<style>
  .constellation-page {
    position: relative;
    width: 100%;
    height: 100%;
    min-height: 540px;
  }
</style>
