---
// One project page. Three levels:
//   simple — left meta rail + dominant artwork (fits the viewport)
//   mdx    — left rail + block composition in the remaining space
//   custom — customComponent registry (checkpoint 6)
import { getCollection, render } from 'astro:content';
import StudioLayout from '../../../layouts/StudioLayout.astro';
import { studioBlocks } from '../../../components/studio/blocks';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({ params: { slug: project.id }, props: { project } }));
}

const { project } = Astro.props;
const d = project.data;
const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
const allClusters = await getCollection('clusters');
const clusterLinks = allClusters.filter((c) => d.clusters.includes(c.id));
const primaryCluster = clusterLinks[0];
const siblings = primaryCluster
  ? (await getCollection('projects')).filter((p) => p.data.clusters.includes(primaryCluster.id))
  : [];
const sibIndex = siblings.findIndex((p) => p.id === project.id);
const prev = siblings[(sibIndex - 1 + siblings.length) % siblings.length];
const next = siblings[(sibIndex + 1) % siblings.length];
const img = d.thumbnail ?? d.hero;
const { Content } = await render(project);
const isModular = d.pageType === 'mdx';
const videoSrc = d.videoSrc ? `${base}${d.videoSrc}` : undefined;

function youtubeEmbedUrl(value: string): string {
  const url = new URL(value);
  const host = url.hostname.replace(/^www\./, '');
  let id: string | null = null;

  if (host === 'youtu.be') {
    id = url.pathname.split('/').filter(Boolean)[0] ?? null;
  } else if (host === 'youtube.com' || host === 'm.youtube.com' || host === 'youtube-nocookie.com') {
    const parts = url.pathname.split('/').filter(Boolean);
    id = url.pathname === '/watch' ? url.searchParams.get('v') : parts[1] ?? null;
  }

  if (!id || !/^[A-Za-z0-9_-]{11}$/.test(id)) {
    throw new Error(`Invalid YouTube URL in project "${d.title}": ${value}`);
  }

  return `https://www.youtube-nocookie.com/embed/${id}`;
}

const youtubeEmbeds = d.youtubeUrls.map((url, index) => ({
  src: youtubeEmbedUrl(url),
  title: d.youtubeUrls.length > 1 ? `${d.title} — video ${index + 1}` : `${d.title} — video`,
}));
---

<StudioLayout title={`${d.title} — Studio`} slim>
  <article class="project">
    <aside class="rail">
      <nav class="crumbs s-meta" aria-label="Breadcrumb">
        <a href={`${base}/studio/`}>← constellation</a>
        {
          clusterLinks.map((c) => (
            <a href={`${base}/studio/clusters/${c.id}/`}>{c.data.title}</a>
          ))
        }
      </nav>

      <h1>{d.title}</h1>

      <dl class="meta s-meta">
        {d.medium.length > 0 && <div><dt>media</dt><dd>{d.medium.join(', ')}</dd></div>}
        <div><dt>year</dt><dd>{d.year}</dd></div>
        {d.types.length > 0 && <div><dt>form</dt><dd>{d.types.join(', ')}</dd></div>}
      </dl>

      {d.summary && <p class="note">{d.summary}</p>}

      <div class="pn">
        {
          prev && prev.id !== project.id && (
            <a class="s-meta" href={`${base}/studio/projects/${prev.id}/`}>
              ← {prev.data.title}
            </a>
          )
        }
        {
          next && next.id !== project.id && (
            <a class="s-meta" href={`${base}/studio/projects/${next.id}/`}>
              {next.data.title} →
            </a>
          )
        }
      </div>

      <a class="s-meta all" href={primaryCluster ? `${base}/studio/clusters/${primaryCluster.id}/` : `${base}/studio/`}>
        view all projects
      </a>

      {
        d.relatedWriting.length > 0 && (
          <div class="related">
            <span class="s-meta">related writing</span>
            {d.relatedWriting.map((slug) => (
              <a class="s-meta" href={`${base}/studio/writing/${slug}/`}>
                {slug.replace(/-/g, ' ')}
              </a>
            ))}
          </div>
        )
      }
    </aside>

    <div class="stage">
      {
        isModular ? (
          <div class="mdx-body">
            <Content components={studioBlocks} />
          </div>
        ) : d.previewType === 'text' ? (
          <blockquote class="text-piece">
            <p>“{d.textExcerpt ?? d.summary}”</p>
            {Content && (
              <div class="body">
                <Content />
              </div>
            )}
          </blockquote>
        ) : videoSrc ? (
          <video src={videoSrc} poster={d.videoPoster?.src} controls preload="metadata" />
        ) : (
          img && (
            <img
              src={img.src}
              alt={d.title}
              width={img.width}
              height={img.height}
              loading="eager"
              fetchpriority="high"
            />
          )
        )
      }

      {
        youtubeEmbeds.length > 0 && (
          <div class="youtube-list">
            {youtubeEmbeds.map((video) => (
              <div class="youtube-embed">
                <iframe
                  src={video.src}
                  title={video.title}
                  loading="lazy"
                  referrerpolicy="strict-origin-when-cross-origin"
                  allow="encrypted-media; picture-in-picture; web-share"
                  allowfullscreen
                />
              </div>
            ))}
          </div>
        )
      }

      {
        !isModular && d.gallery && d.gallery.length > 0 && (
          <div class="gallery">
            {d.gallery.map((g) => (
              <img
                src={g.src}
                alt={`${d.title} — detail`}
                width={g.width}
                height={g.height}
                loading="lazy"
              />
            ))}
          </div>
        )
      }
    </div>
  </article>
</StudioLayout>

<style>
  .project {
    display: grid;
    grid-template-columns: minmax(220px, 280px) minmax(0, 860px);
    gap: clamp(28px, 4vw, 64px);
    align-items: stretch;
    justify-content: center;
    width: 100%;
    max-width: 1220px;
    min-height: min(760px, calc(100dvh - 120px));
    margin: 0 auto;
    padding-bottom: 32px;
  }

  /* left rail */
  .rail {
    display: flex;
    flex-direction: column;
    gap: 0;
    padding-top: 34px;
  }

  .crumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 18px;
  }

  .crumbs a {
    color: var(--s-grey);
    text-decoration: none;
  }

  .crumbs a:hover {
    text-decoration: underline;
  }

  h1 {
    font-family: var(--s-serif);
    font-weight: 500;
    font-size: clamp(28px, 2.8vw, 40px);
    line-height: 1.05;
    text-transform: uppercase;
    letter-spacing: 0.015em;
    margin: 30px 0 0;
  }

  .meta {
    margin: 26px 0 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .meta div {
    display: grid;
    grid-template-columns: 74px 1fr;
    gap: 10px;
  }

  .meta dt {
    color: var(--s-faint);
  }

  .meta dd {
    margin: 0;
    color: var(--s-ink);
  }

  .note {
    font-family: var(--s-mono);
    font-size: 12.5px;
    line-height: 1.8;
    color: var(--s-grey);
    margin: 26px 0 0;
    max-width: 40ch;
  }

  .pn {
    margin-top: auto;
    padding-top: 40px;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .pn a {
    color: var(--s-ink);
    text-decoration: none;
  }

  .pn a:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .all {
    margin-top: 22px;
    color: var(--s-grey);
  }

  .related {
    margin-top: 26px;
    display: flex;
    flex-direction: column;
    gap: 5px;
    align-items: flex-start;
  }

  .related a {
    color: var(--s-grey);
    text-decoration: none;
  }

  .related a:hover {
    text-decoration: underline;
  }

  /* right stage — artwork centred, fits the viewport */
  .stage {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 24px 0;
    min-width: 0;
  }

  .stage > img,
  .stage > video {
    display: block;
    max-width: 100%;
    max-height: calc(100dvh - 190px);
    width: auto;
    height: auto;
    margin: 0 auto;
    box-shadow: 0 3px 30px rgba(20, 18, 10, 0.13);
  }

  .youtube-list {
    display: grid;
    gap: 18px;
    width: 100%;
    max-width: 860px;
    margin: 18px auto 0;
  }

  .youtube-list:first-child {
    margin-top: 0;
  }

  .youtube-embed {
    position: relative;
    overflow: hidden;
    width: 100%;
    aspect-ratio: 16 / 9;
    background: #111;
    box-shadow: 0 3px 30px rgba(20, 18, 10, 0.13);
  }

  .youtube-embed iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  /* size: full opts into a larger, scrollable presentation */
  .size-full .stage > img,
  .size-full .stage > video {
    max-height: none;
    width: 100%;
  }

  .text-piece {
    margin: 0;
  }

  .text-piece p {
    margin: 0;
    font-family: var(--s-serif);
    font-size: clamp(26px, 2.6vw, 36px);
    font-style: italic;
    line-height: 1.5;
    max-width: 30ch;
  }

  .body {
    margin-top: 22px;
    font-family: var(--s-mono);
    font-size: 12.5px;
    line-height: 1.85;
    color: var(--s-grey);
  }

  .gallery {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
    margin-top: 26px;
    justify-content: center;
  }

  .gallery img {
    height: 120px;
    width: auto;
  }

  /* modular projects: blocks fill the stage on the studio grid */
  .mdx-body {
    display: grid;
    grid-template-columns: repeat(10, 1fr);
    column-gap: 24px;
    row-gap: 44px;
    align-content: center;
    min-height: calc(100dvh - 210px);
  }

  .mdx-body :global(.place) {
    grid-column: auto / span 10;
  }

  .mdx-body :global(img) {
    max-height: 40vh;
    width: auto;
    max-width: 100%;
    margin: 0 auto;
  }

  .mdx-body :global(.pair img),
  .mdx-body :global(.gallery img) {
    max-height: 26vh;
  }

  @media (max-width: 820px) {
    .project {
      grid-template-columns: 1fr;
      min-height: 0;
      gap: 28px;
    }

    .rail {
      padding-top: 8px;
    }

    .pn {
      padding-top: 24px;
    }

    .stage {
      padding: 0;
    }

    .stage > img,
    .stage > video {
      max-height: 72vh;
    }

    .mdx-body :global(img) {
      max-height: none;
      width: 100%;
    }
  }
</style>
