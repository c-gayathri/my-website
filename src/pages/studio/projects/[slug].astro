---
// One project page. Three levels:
//   simple — dominant artwork + caption (artwork fits the viewport)
//   mdx    — body composed from studioBlocks on the 12-column grid
//   custom — customComponent registry (checkpoint 6)
import { getCollection, render } from 'astro:content';
import StudioLayout from '../../../layouts/StudioLayout.astro';
import { studioBlocks } from '../../../components/studio/blocks';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({ params: { slug: project.id }, props: { project } }));
}

const { project } = Astro.props;
const d = project.data;
const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
const clusterLinks = (await getCollection('clusters')).filter((c) =>
  d.clusters.includes(c.id),
);
const img = d.thumbnail ?? d.hero;
const { Content } = await render(project);
const isModular = d.pageType === 'mdx';
const videoSrc = d.videoSrc ? `${base}${d.videoSrc}` : undefined;

const sizeClass = `size-${d.size}`;
---

<StudioLayout title={`${d.title} — Studio`} slim>
  <article class:list={['project', sizeClass, { modular: isModular }]}>
    <nav class="crumbs s-meta" aria-label="Breadcrumb">
      <a href={`${base}/studio/`}>← constellation</a>
      {
        clusterLinks.map((c) => (
          <a href={`${base}/studio/clusters/${c.id}/`}>{c.data.title}</a>
        ))
      }
    </nav>

    <header class="proj-header">
      <h1>{d.title}</h1>
      <p class="s-meta">
        {[d.medium.join(', '), d.year ? String(d.year) : ''].filter(Boolean).join(' · ')}
      </p>
    </header>

    {
      isModular ? (
        <div class="mdx-body">
          <Content components={studioBlocks} />
        </div>
      ) : (
        <>
          {d.previewType === 'text' ? (
            <blockquote class="text-piece">
              <p>“{d.textExcerpt ?? d.summary}”</p>
            </blockquote>
          ) : videoSrc ? (
            <figure class="artwork">
              <video src={videoSrc} poster={d.videoPoster?.src} controls />
            </figure>
          ) : (
            img && (
              <figure class="artwork">
                <img
                  src={img.src}
                  alt={d.title}
                  width={img.width}
                  height={img.height}
                  loading="eager"
                  fetchpriority="high"
                />
              </figure>
            )
          )}

          {d.summary && <p class="summary">{d.summary}</p>}

          {d.gallery && d.gallery.length > 0 && (
            <div class="gallery">
              {d.gallery.map((g) => (
                <img
                  src={g.src}
                  alt={`${d.title} — detail`}
                  width={g.width}
                  height={g.height}
                  loading="lazy"
                />
              ))}
            </div>
          )}

          {Content && (
            <div class="body">
              <Content />
            </div>
          )}

          {d.relatedWriting.length > 0 && (
            <aside class="related">
              <span class="s-meta">related writing</span>
              {d.relatedWriting.map((slug) => (
                <a class="s-link" href={`${base}/studio/writing/${slug}/`}>
                  {slug.replace(/-/g, ' ')}
                </a>
              ))}
            </aside>
          )}
        </>
      )
    }
  </article>
</StudioLayout>

<style>
  .crumbs {
    display: flex;
    gap: 20px;
    margin-top: 4px;
  }

  .crumbs a {
    color: var(--s-grey);
    text-decoration: none;
  }

  .crumbs a:hover {
    text-decoration: underline;
  }

  .proj-header h1 {
    font-family: var(--s-serif);
    font-weight: 500;
    font-size: clamp(26px, 3vw, 38px);
    line-height: 1.05;
    margin: 14px 0 4px;
  }

  .proj-header p {
    margin: 0;
  }

  /* artwork fits the first screen unless the project opts out */
  .artwork {
    margin: 22px 0 0;
    display: flex;
    justify-content: center;
    position: relative;
  }

  .artwork img,
  .artwork video {
    display: block;
    max-width: 100%;
    max-height: calc(100dvh - 210px);
    width: auto;
    height: auto;
    box-shadow: 0 3px 26px rgba(20, 18, 10, 0.12);
  }

  /* size: full allows a scrollable, larger presentation */
  .size-full .artwork img,
  .size-full .artwork video {
    max-height: none;
    width: 100%;
  }

  .summary,
  .body {
    font-family: var(--s-mono);
    font-size: 13px;
    line-height: 1.8;
    color: var(--s-grey);
    max-width: 62ch;
  }

  .summary {
    margin-top: 22px;
  }

  .body {
    margin-top: 18px;
  }

  .text-piece {
    margin: 36px 0 0;
  }

  .text-piece p {
    margin: 0;
    font-family: var(--s-serif);
    font-size: 30px;
    font-style: italic;
    line-height: 1.5;
  }

  .gallery {
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
    margin-top: 18px;
  }

  .gallery img {
    width: calc(25% - 12px);
    height: auto;
  }

  .mdx-body {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    column-gap: 28px;
    row-gap: 48px;
    margin-top: 30px;
    padding-bottom: 40px;
  }

  .related {
    margin-top: 40px;
    display: flex;
    flex-direction: column;
    gap: 6px;
    align-items: flex-start;
  }

  @media (max-width: 820px) {
    .gallery img {
      width: calc(50% - 8px);
    }

    .artwork img,
    .artwork video {
      max-height: calc(100dvh - 260px);
    }
  }
</style>
