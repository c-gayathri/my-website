---
// One project page. Three levels:
//   simple — left meta rail + dominant artwork (fits the viewport)
//   mdx    — left rail + block composition in the remaining space
//   custom — customComponent registry (checkpoint 6)
import { getCollection, render } from 'astro:content';
import StudioLayout from '../../../layouts/StudioLayout.astro';
import Lightbox from '../../../components/studio/Lightbox.astro';
import { studioBlocks } from '../../../components/studio/blocks';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({ params: { slug: project.id }, props: { project } }));
}

const { project } = Astro.props;
const d = project.data;
const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
const allClusters = await getCollection('clusters');
const clusterLinks = allClusters.filter((c) => d.clusters.includes(c.id));
const primaryCluster = clusterLinks[0];
const siblings = primaryCluster
  ? (await getCollection('projects')).filter((p) => p.data.clusters.includes(primaryCluster.id))
  : [];
const sibIndex = siblings.findIndex((p) => p.id === project.id);
const prev = siblings[(sibIndex - 1 + siblings.length) % siblings.length];
const next = siblings[(sibIndex + 1) % siblings.length];
const img = d.thumbnail ?? d.hero;
const { Content } = await render(project);
const isModular = d.pageType === 'mdx';
const isWritingFirst = d.layoutMode === 'writing-first';
const videoSrc = d.videoSrc ? `${base}${d.videoSrc}` : undefined;
const audioSrc = d.audioSrc ? `${base}${d.audioSrc}` : undefined;
const allGalleryImages = [...(img ? [img] : []), ...d.gallery] as Array<(typeof d.gallery)[number]>;
const uniqGallery = [...new Map(allGalleryImages.map((im) => [im.src, im])).values()] as Array<(typeof d.gallery)[number]>;

function youtubeEmbedUrl(value: string): string {
  const url = new URL(value);
  const host = url.hostname.replace(/^www\./, '');
  let id: string | null = null;

  if (host === 'youtu.be') {
    id = url.pathname.split('/').filter(Boolean)[0] ?? null;
  } else if (host === 'youtube.com' || host === 'm.youtube.com' || host === 'youtube-nocookie.com') {
    const parts = url.pathname.split('/').filter(Boolean);
    id = url.pathname === '/watch' ? url.searchParams.get('v') : parts[1] ?? null;
  }

  if (!id || !/^[A-Za-z0-9_-]{11}$/.test(id)) {
    throw new Error(`Invalid YouTube URL in project "${d.title}": ${value}`);
  }

  return `https://www.youtube-nocookie.com/embed/${id}`;
}

const youtubeEmbeds = d.youtubeUrls.map((url, index) => ({
  src: youtubeEmbedUrl(url),
  title: d.youtubeUrls.length > 1 ? `${d.title} — video ${index + 1}` : `${d.title} — video`,
}));
---

<StudioLayout title={`${d.title} — Studio`} slim>
  <article class:list={['project', `size-${d.size}`, `layout-${d.pageLayout}`]}>
    <aside class="rail">
      <nav class="crumbs s-meta" aria-label="Breadcrumb">
        <a href={`${base}/studio/`}>← constellation</a>
      </nav>
      {clusterLinks.length > 0 && (
        <div class="cluster-list s-meta">
          <span>In: </span>
          {clusterLinks.map((c, i) => (
            <a href={`${base}/studio/clusters/${c.id}/`}>{c.data.title}{i < clusterLinks.length - 1 ? ' · ' : ''}</a>
          ))}
        </div>
      )}

      <h1>{d.title}</h1>

      <dl class="meta s-meta">
        {d.medium.length > 0 && <div><dt>media</dt><dd>{d.medium.join(', ')}</dd></div>}
        <div><dt>year</dt><dd>{d.year}</dd></div>
        {d.types.length > 0 && <div><dt>form</dt><dd>{d.types.join(', ')}</dd></div>}
      </dl>

      {d.summary && <p class="note">{d.summary}</p>}

      <div class="pn">
        {
          prev && prev.id !== project.id && (
            <a class="s-meta" href={`${base}/studio/projects/${prev.id}/`}>
              ← {prev.data.title}
            </a>
          )
        }
        {
          next && next.id !== project.id && (
            <a class="s-meta" href={`${base}/studio/projects/${next.id}/`}>
              {next.data.title} →
            </a>
          )
        }
      </div>

      <a class="s-meta all" href={primaryCluster ? `${base}/studio/clusters/${primaryCluster.id}/` : `${base}/studio/`}>
        view all projects
      </a>

      {
        d.relatedWriting.length > 0 && (
          <div class="related">
            <span class="s-meta">related writing</span>
            {d.relatedWriting.map((slug) => (
              <a class="s-meta" href={`${base}/studio/writing/${slug}/`}>
                {slug.replace(/-/g, ' ')}
              </a>
            ))}
          </div>
        )
      }
    </aside>

    <div class="stage">
      {isWritingFirst ? (
        <div class="mdx-body">
          <Content components={studioBlocks} />
        </div>
      ) : isModular && d.layoutMode !== 'image-first' ? (
        <div class="mdx-body">
          <Content components={studioBlocks} />
        </div>
      ) : d.previewType === 'text' ? (
        <blockquote class="text-piece">
          <p>“{d.textExcerpt ?? d.summary}”</p>
          {Content && (
            <div class="body">
              <Content />
            </div>
          )}
        </blockquote>
      ) : videoSrc ? (
        <video src={videoSrc} poster={d.videoPoster?.src} controls preload="metadata" />
      ) : (uniqGallery.length > 0) ? (
        <div
          class:list={[
            'gallery',
            uniqGallery.length === 1 ? 'gallery--one' : uniqGallery.length === 2 ? 'gallery--two' : d.galleryColumns === '2' ? 'gallery--two-col' : 'gallery--three',
            uniqGallery.length > 2 && uniqGallery.length < 9 ? 'gallery--centered' : '',
          ]}
        >
          <Lightbox images={uniqGallery.map((g) => ({ src: g.src, width: g.width, height: g.height }))} title={d.title} />
        </div>
      ) : (
        img && (
          <img
            src={img.src}
            alt={d.title}
            width={img.width}
            height={img.height}
            loading="eager"
            fetchpriority="high"
          />
        )
      )}

      {youtubeEmbeds.length > 0 && (
        <div class="youtube-list">
          {youtubeEmbeds.map((video) => (
            <div class="youtube-embed">
              <iframe
                src={video.src}
                title={video.title}
                loading="lazy"
                referrerpolicy="strict-origin-when-cross-origin"
                allow="encrypted-media; picture-in-picture; web-share"
                allowfullscreen
              />
            </div>
          ))}
        </div>
      )}

      {audioSrc && (
        <div class="audio-block">
          <audio controls src={audioSrc} preload="metadata" />
        </div>
      )}
      {d.audioUrls.length > 0 && (
        <div class="audio-list">
          {d.audioUrls.map((url) => (
            <audio controls src={url} preload="metadata" />
          ))}
        </div>
      )}
    </div>
  </article>
</StudioLayout>

<style>
  .project {
    display: grid;
    grid-template-columns: minmax(220px, 280px) minmax(0, 1fr);
    gap: clamp(28px, 4vw, 64px);
    align-items: stretch;
    justify-content: center;
    width: 100%;
    max-width: min(1680px, 94vw);
    min-height: min(760px, calc(100dvh - 120px));
    margin: 0 auto;
    padding-bottom: 32px;
  }

  /* left rail */
  .rail {
    display: flex;
    flex-direction: column;
    gap: 0;
    padding-top: 34px;
  }

  .crumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 18px;
  }

  .crumbs a {
    color: var(--s-grey);
    text-decoration: none;
  }

  .crumbs a:hover {
    text-decoration: underline;
  }

  h1 {
    font-family: var(--s-serif);
    font-weight: 500;
    font-size: clamp(28px, 2.8vw, 40px);
    line-height: 1.05;
    text-transform: uppercase;
    letter-spacing: 0.015em;
    margin: 30px 0 0;
  }

  .meta {
    margin: 26px 0 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .meta div {
    display: grid;
    grid-template-columns: 74px 1fr;
    gap: 10px;
  }

  .meta dt {
    color: var(--s-faint);
  }

  .meta dd {
    margin: 0;
    color: var(--s-ink);
  }

  .note {
    font-family: var(--s-mono);
    font-size: 12.5px;
    line-height: 1.8;
    color: var(--s-grey);
    margin: 26px 0 0;
    max-width: 40ch;
  }

  .pn {
    margin-top: auto;
    padding-top: 40px;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .pn a {
    color: var(--s-ink);
    text-decoration: none;
  }

  .pn a:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .all {
    margin-top: 22px;
    color: var(--s-grey);
  }

  .related {
    margin-top: 26px;
    display: flex;
    flex-direction: column;
    gap: 5px;
    align-items: flex-start;
  }

  .related a {
    color: var(--s-grey);
    text-decoration: none;
  }

  .related a:hover {
    text-decoration: underline;
  }

  /* right stage — artwork centred, fits the viewport */
  .stage {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 24px 0;
    min-width: 0;
  }

  .stage > img,
  .stage > video {
    display: block;
    max-width: 100%;
    max-height: calc(100dvh - 190px);
    width: auto;
    height: auto;
    margin: 0 auto;
    box-shadow: 0 3px 30px rgba(20, 18, 10, 0.13);
  }

  .youtube-list {
    display: grid;
    gap: 18px;
    width: 100%;
    max-width: 860px;
    margin: 18px auto 0;
  }

  .youtube-list:first-child {
    margin-top: 0;
  }

  .youtube-embed {
    position: relative;
    overflow: hidden;
    width: 100%;
    aspect-ratio: 16 / 9;
    background: #111;
    box-shadow: 0 3px 30px rgba(20, 18, 10, 0.13);
  }

  .youtube-embed iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  /* size variants — use frontmatter `size: small | medium | large` */
  .size-small .stage > img,
  .size-small .stage > video {
    max-height: calc(100dvh - 280px);
    max-width: 560px;
  }

  .size-large .stage > img,
  .size-large .stage > video,
  .size-full .stage > img,
  .size-full .stage > video {
    max-height: none;
    width: 100%;
  }

  .text-piece {
    margin: 0;
  }

  .text-piece p {
    margin: 0;
    font-family: var(--s-serif);
    font-size: clamp(26px, 2.6vw, 36px);
    font-style: italic;
    line-height: 1.5;
    max-width: 30ch;
  }

  .body {
    margin-top: 22px;
    font-family: var(--s-mono);
    font-size: 12.5px;
    line-height: 1.85;
    color: var(--s-grey);
  }

  /* image-first gallery: natural heights retained, click any image to open */
  .gallery {
    display: grid;
    gap: clamp(14px, 1.5vw, 22px);
    margin-top: 26px;
    align-content: start;
    align-items: start;
    width: 100%;
  }

  .gallery--three { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .gallery--two-col { grid-template-columns: repeat(2, minmax(0, 1fr)); }

  .gallery--centered {
    align-content: center;
    min-height: 360px;
  }

  /* lightbox thumbs fill their cell, keep native aspect — never cropped */
  .gallery :global(.lightbox) { display: contents; }
  .gallery :global(.thumbs) { display: contents; }
  .gallery :global(.thumb img) {
    width: 100%;
    height: auto;
    object-fit: contain;
    display: block;
  }

  /* 2-image case: side by side, full width */
  .gallery--two {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    width: 100%;
  }

  .gallery--one {
    grid-template-columns: 1fr;
    width: min(100%, 720px);
    margin-inline: auto;
  }

  .gallery--one :global(.thumb img) {
    height: auto;
    max-height: min(80vh, 720px);
    object-fit: contain;
  }

  @media (min-width: 1400px) {
    .project { max-width: min(1780px, 94vw); }
    .gallery { gap: 20px; }
  }

  @media (min-width: 1900px) {
    .project { max-width: min(1960px, 92vw); }
    .gallery { gap: 24px; }
  }

  /* writing-first: readable prose column; blocks stack full stage width
     with natural image heights (fixes SUBLIMINAL narrow-split + cutoff) */
  .mdx-body {
    display: flex;
    flex-direction: column;
    gap: 30px;
    align-content: start;
    width: 100%;
    max-width: 860px;
    margin: 0 auto;
    font-family: var(--s-serif);
    font-size: 19px;
    line-height: 1.75;
    color: var(--s-ink);
  }

  .mdx-body :global(p) { margin: 0; max-width: 62ch; }
  .mdx-body :global(.place) { grid-column: auto; width: 100%; }

  .mdx-body :global(img) {
    width: 100%;
    height: auto;
    max-height: none;
    max-width: 100%;
    margin: 0 auto;
    object-fit: contain;
  }

  .mdx-body :global(.pair) { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; }
  .mdx-body :global(.pair img) { max-height: none; width: 100%; }
  .mdx-body :global(figure) { margin: 0; }
  .mdx-body :global(figcaption) { margin-top: 8px; }

  @media (max-width: 1100px) {
    .gallery--three { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  @media (max-width: 820px) {
    .project {
      grid-template-columns: 1fr;
      min-height: 0;
      gap: 28px;
    }

    .rail {
      padding-top: 8px;
    }

    .pn {
      padding-top: 24px;
    }

    .stage {
      padding: 0;
    }

    .stage > img,
    .stage > video {
      max-height: 72vh;
    }

    .gallery,
    .gallery--two,
    .gallery--two-col,
    .gallery--three,
    .gallery--one {
      grid-template-columns: 1fr !important;
      width: 100% !important;
      max-width: none !important;
    }

    .gallery :global(.thumb img) {
      height: auto;
    }

    .mdx-body :global(.pair) { grid-template-columns: 1fr; }

    .mdx-body :global(img) {
      max-height: none;
      width: 100%;
    }
  }
</style>
