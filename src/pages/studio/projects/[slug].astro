---
// One project page. Three levels:
//   simple — left meta rail + dominant artwork (fits the viewport)
//   mdx    — left rail + block composition in the remaining space
//   custom — customComponent registry (checkpoint 6)
import { getCollection, render } from 'astro:content';
import StudioLayout from '../../../layouts/StudioLayout.astro';
import Lightbox from '../../../components/studio/Lightbox.astro';
import { studioBlocks } from '../../../components/studio/blocks';
import { clusterOrder } from '../../../data/clusterOrder';
import { projectOrder } from '../../../data/projectOrder';
import { sortPhotographyProjects } from '../../../data/photographyOrder';
import { hiddenPhotographyProjectIds } from '../../../data/hiddenPhotographyProjects';
import { summaryParts } from '../../../utils/summaryLinks';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.filter((project) => !hiddenPhotographyProjectIds.has(project.id)).map((project) => ({ params: { slug: project.id }, props: { project } }));
}

const { project } = Astro.props;
const d = project.data;
const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
const allClusters = await getCollection('clusters');
const relatedClusters = allClusters.filter((c) => d.clusters.includes(c.id)).sort((a, b) => {
  const aPriority = clusterOrder.indexOf(a.id);
  const bPriority = clusterOrder.indexOf(b.id);
  return (aPriority < 0 ? Infinity : aPriority) - (bPriority < 0 ? Infinity : bPriority);
});
const clusterLinks = relatedClusters.filter((c) => c.id !== 'photography');
const primaryCluster = relatedClusters[0];
const allProjects = await getCollection('projects');
const relatedProjects = allProjects.filter((p) => d.relatedProjects.includes(p.id));
const allWriting = await getCollection('writing');
const writingById = new Map(allWriting.map((entry) => [entry.id, entry]));
const siblings = primaryCluster
  ? primaryCluster.id === 'photography'
    ? sortPhotographyProjects(allProjects.filter((p) => p.data.clusters.includes('photography') && !hiddenPhotographyProjectIds.has(p.id)))
    : allProjects.filter((p) => p.data.clusters.includes(primaryCluster.id)).sort((a, b) => {
      const order = projectOrder[primaryCluster.id] ?? [];
      const ai = order.indexOf(a.id);
      const bi = order.indexOf(b.id);
      if (ai >= 0 || bi >= 0) return ai < 0 ? 1 : bi < 0 ? -1 : ai - bi;
      return Number(b.data.featured) - Number(a.data.featured) || a.id.localeCompare(b.id);
    })
  : [];
const sibIndex = siblings.findIndex((p) => p.id === project.id);
const prev = siblings[(sibIndex - 1 + siblings.length) % siblings.length];
const next = siblings[(sibIndex + 1) % siblings.length];
const img = d.previewType === 'video' ? d.hero : d.thumbnail ?? d.hero;
const { Content } = await render(project);
const isModular = d.pageType === 'mdx';
const isWritingFirst = d.layoutMode === 'writing-first';
const videoSrc = d.videoSrc ? `${base}${d.videoSrc}` : undefined;
const audioSrc = d.audioSrc ? `${base}${d.audioSrc}` : undefined;
const allGalleryImages = [...(img ? [img] : []), ...d.gallery] as Array<(typeof d.gallery)[number]>;
const uniqGallery = [...new Map(allGalleryImages.map((im) => [im.src, im])).values()] as Array<(typeof d.gallery)[number]>;
const captionBySrc = new Map(d.gallery.map((image, index) => [image.src, d.galleryCaptions?.[index] ?? '']));
const lightboxImages = uniqGallery.map((image) => ({
  src: image.src,
  width: image.width,
  height: image.height,
  caption: image.src === img?.src && d.heroCaption?.trim()
    ? d.heroCaption
    : captionBySrc.get(image.src),
}));

function youtubeAspectRatio(value: string, index: number): number {
  const specified = d.youtubeAspectRatios[index];
  if (specified) return specified;
  return new URL(value).pathname.startsWith('/shorts/') ? 9 / 16 : 16 / 9;
}

function youtubeEmbedUrl(value: string): string {
  const url = new URL(value);
  const host = url.hostname.replace(/^www\./, '');
  let id: string | null = null;

  if (host === 'youtu.be') {
    id = url.pathname.split('/').filter(Boolean)[0] ?? null;
  } else if (host === 'youtube.com' || host === 'm.youtube.com' || host === 'youtube-nocookie.com') {
    const parts = url.pathname.split('/').filter(Boolean);
    id = url.pathname === '/watch' ? url.searchParams.get('v') : parts[1] ?? null;
  }

  if (!id || !/^[A-Za-z0-9_-]{11}$/.test(id)) {
    throw new Error(`Invalid YouTube URL in project "${d.title}": ${value}`);
  }

  return `https://www.youtube-nocookie.com/embed/${id}`;
}

const youtubeEmbeds = d.youtubeUrls.map((url, index) => ({
  src: `${youtubeEmbedUrl(url)}?autoplay=1&mute=0&loop=1&playlist=${youtubeEmbedUrl(url).split('/').at(-1)}&controls=0&playsinline=1&modestbranding=1&rel=0`,
  title: d.youtubeUrls.length > 1 ? `${d.title} — video ${index + 1}` : `${d.title} — video`,
  aspect: youtubeAspectRatio(url, index),
}));
const masonryYoutubeEmbeds = d.collageMode === 'masonry' ? youtubeEmbeds : [];
const masonryItems = [
  ...uniqGallery.map((image, index) => ({
    kind: 'image' as const,
    image,
    index,
    ratio: image.width / image.height,
  })),
  ...masonryYoutubeEmbeds.map((video, index) => ({
    kind: 'video' as const,
    video,
    index,
    ratio: youtubeAspectRatio(d.youtubeUrls[index], index),
  })),
];
const masonryColumnCount = d.collageColumns ?? (d.galleryColumns === '2' ? 2 : 3);
const masonryColumns = Array.from({ length: masonryColumnCount }, () => [] as typeof masonryItems);
const masonryHeights = Array.from({ length: masonryColumnCount }, () => 0);
for (const item of masonryItems) {
  const requestedColumn = d.masonryColumns?.[masonryItems.indexOf(item)];
  const target = requestedColumn !== undefined && requestedColumn < masonryColumnCount
    ? requestedColumn
    : masonryHeights.indexOf(Math.min(...masonryHeights));
  masonryColumns[target].push(item);
  masonryHeights[target] += 1 / item.ratio;
}
const customTiles = d.collageTiles.map((tile) => {
  const image = tile.type === 'image' && tile.imageIndex !== undefined ? d.gallery[tile.imageIndex] : undefined;
  return { ...tile, image, video: tile.videoSrc ? `${base}${tile.videoSrc}` : undefined,
    embed: tile.youtubeUrl ? `${youtubeEmbedUrl(tile.youtubeUrl)}?autoplay=1&mute=0&loop=1&playlist=${youtubeEmbedUrl(tile.youtubeUrl).split('/').at(-1)}&controls=0&playsinline=1&modestbranding=1&rel=0` : undefined,
  aspect: tile.youtubeUrl ? youtubeAspectRatio(tile.youtubeUrl, d.youtubeUrls.indexOf(tile.youtubeUrl)) : 16 / 9 };
}).filter((tile) => tile.type === 'video' || tile.image);
const isPhotography = d.clusters.includes('photography');
const landscapeVideo = d.youtubeUrls.some((url, index) => youtubeAspectRatio(url, index) > 1.1);
const collageStyle = `--collage-width:${d.collageWidthPercent}%;--collage-columns:${d.collageColumns ?? (d.galleryColumns === '2' ? 2 : 3)};${d.singleImageWidthPx ? `--single-image-width:${d.singleImageWidthPx}px;` : ''}${d.collageColumnRatios?.length ? `--collage-tracks:${d.collageColumnRatios.map((n) => `${n}fr`).join(' ')};` : ''}${d.collageRowRatios?.length ? `--collage-rows:${d.collageRowRatios.map((n) => `${n}fr`).join(' ')};` : ''}`;
---

<StudioLayout title={`${d.title} — Studio`} slim dark={isPhotography} section={isPhotography ? 'Photography' : undefined}>
  <article class:list={['project', `size-${d.size}`, `layout-${d.pageLayout}`, d.preserveBreaks ? 'preserve-breaks' : '', d.viewportFitImage ? 'project--viewport-image' : '', isPhotography ? 'project--photography' : '', landscapeVideo ? 'project--video-landscape' : '']} style={`--project-image-background:${d.whiteBackground ? '#fff' : 'transparent'}`}>
    <aside class="rail">
      <nav class="crumbs top-crumbs s-meta" aria-label="Breadcrumb">
        {isPhotography ? (
          <a href={`${base}/studio/photography/`}>← all photography</a>
        ) : (
          <>
            <a href={`${base}/studio/`}>← constellation</a>
            <a href={`${base}/studio/index/projects/`}>← all projects</a>
          </>
        )}
      </nav>
      <h1>{d.title}</h1>

      <dl class="meta s-meta">
        {!isPhotography && d.medium.length > 0 && <div><dt>media</dt><dd>{d.medium.join(', ')}</dd></div>}
        {clusterLinks.length > 0 && (
          <div class="meta-clusters">
            <dt>clusters</dt>
            <dd>
              {clusterLinks.map((c, i) => (
                <><a href={`${base}/studio/clusters/${c.id}/`}>{c.data.title}</a>{i < clusterLinks.length - 1 ? ' · ' : ''}</>
              ))}
            </dd>
          </div>
        )}
        <div><dt>year</dt><dd>{d.year}</dd></div>
      </dl>

      {d.summary && <p class="note">{summaryParts(d.summary).map((part) => part.href ? <a href={part.href} target="_blank" rel="noopener noreferrer">{part.text}</a> : part.text)}</p>}

      {
        d.relatedWriting.length > 0 && (
          <div class="related">
            <span class="s-meta">related writing</span>
            {d.relatedWriting.map((slug) => (
              <a class="s-meta" href={`${base}/studio/writing/${slug}/`}>
                {writingById.get(slug)?.data.title ?? slug.replace(/-/g, ' ')}
              </a>
            ))}
          </div>
        )
      }
      {
        relatedProjects.length > 0 && (
          <div class="related">
            <span class="s-meta">related projects</span>
            {relatedProjects.map((relatedProject) => (
              <a class="s-meta" href={`${base}/studio/projects/${relatedProject.id}/`}>
                {relatedProject.data.title}
              </a>
            ))}
          </div>
        )
      }
      <div class="pn">
        {
          prev && prev.id !== project.id && (
            <a class="s-meta" href={`${base}/studio/projects/${prev.id}/`}>
              ← {prev.data.title}
            </a>
          )
        }
        {
          next && next.id !== project.id && (
            <a class="s-meta" href={`${base}/studio/projects/${next.id}/`}>
              {next.data.title} →
            </a>
          )
        }
      </div>
      <nav class="crumbs bottom-crumbs s-meta" aria-label="More project navigation">
        {isPhotography ? (
          <a href={`${base}/studio/photography/`}>← all photography</a>
        ) : (
          <>
            <a href={`${base}/studio/`}>← constellation</a>
            <a href={`${base}/studio/index/projects/`}>← all projects</a>
          </>
        )}
      </nav>
    </aside>

    <div class="stage">
      {isWritingFirst ? (
        <div class="mdx-body">
          <Content components={studioBlocks} />
        </div>
      ) : isModular && d.layoutMode !== 'image-first' ? (
        <div class="mdx-body">
          <Content components={studioBlocks} />
        </div>
      ) : d.collageMode === 'custom' && customTiles.length > 0 ? (
        <div class="custom-collage" style={collageStyle}>
          {customTiles.map((tile) => (
            <figure class="custom-tile" style={`--tile-row:${tile.row};--tile-column:${tile.column};--tile-row-span:${tile.rowSpan};--tile-column-span:${tile.columnSpan};`}>
              {tile.type === 'image' && tile.image ? <img src={tile.image.src} alt={tile.name} width={tile.image.width} height={tile.image.height} loading="lazy" /> : tile.video ? <video src={tile.video} poster={d.videoPoster?.src} controls autoplay loop playsinline preload="auto" /> : tile.embed ? <div class:list={['youtube-embed', tile.aspect < 1 ? 'youtube-embed--portrait' : '']} style={`--embed-aspect:${tile.aspect}`}><iframe src={tile.embed} title={`${d.title} — ${tile.name}`} loading="eager" allow="autoplay; encrypted-media; picture-in-picture; web-share" allowfullscreen /></div> : null}
              <figcaption class="s-meta">{tile.name}</figcaption>
            </figure>
          ))}
        </div>
      ) : d.previewType === 'text' ? (
        <blockquote class="text-piece">
          <p>“{d.textExcerpt ?? d.summary}”</p>
          {Content && (
            <div class="body">
              <Content />
            </div>
          )}
        </blockquote>
      ) : videoSrc ? (
        <video src={videoSrc} poster={d.videoPoster?.src} controls autoplay loop playsinline preload="auto" />
      ) : (uniqGallery.length > 0) ? (
        <div
          class:list={[
            'gallery',
            d.collageMode === 'masonry' ? 'gallery--masonry' : '',
            uniqGallery.length === 1 ? 'gallery--one' : uniqGallery.length === 2 ? 'gallery--two' : d.galleryColumns === '2' ? 'gallery--two-col' : 'gallery--three',
            uniqGallery.length === 1 && d.singleImageWidthPx ? 'gallery--scaled-single' : '',
            d.collageColumns ? 'gallery--explicit-columns' : '',
            uniqGallery.length > 1 && uniqGallery.length <= (d.collageColumns ?? (d.galleryColumns === '2' ? 2 : 3)) ? 'gallery--single-row' : '',
            uniqGallery.length > 2 && uniqGallery.length < 9 ? 'gallery--centered' : '',
          ]}
          style={collageStyle}
        >
          {d.collageMode === 'masonry' ? (
            <div class="masonry-grid" style={`--masonry-columns:${masonryColumnCount}`}>
              {masonryColumns.map((column) => (
                <div class="masonry-column">
                  {column.map((item) => item.kind === 'image' ? (
                    <figure class="masonry-item">
                      <img src={item.image.src} alt={captionBySrc.get(item.image.src) || `${d.title}, image ${item.index + 1}`} width={item.image.width} height={item.image.height} loading={item.index === 0 ? 'eager' : 'lazy'} />
                    </figure>
                  ) : (
                    <div class:list={[(item.video.aspect < 1 ? 'youtube-embed--portrait' : ''), 'youtube-embed', 'masonry-item']} style={`--embed-aspect:${item.ratio}`}>
                      <iframe src={item.video.src} title={item.video.title} loading="eager" referrerpolicy="strict-origin-when-cross-origin" allow="autoplay; encrypted-media; picture-in-picture; web-share" allowfullscreen />
                    </div>
                  ))}
                </div>
              ))}
            </div>
          ) : <Lightbox images={lightboxImages} title={d.title} />}
        </div>
      ) : (
        img && (
          <img
            src={img.src}
            alt={d.title}
            width={img.width}
            height={img.height}
            loading="eager"
            fetchpriority="high"
            style={d.singleImageWidthPx ? `width:min(100%, ${d.singleImageWidthPx}px)` : undefined}
          />
        )
      )}
      {uniqGallery.length > 0 && d.galleryCaption && <p class="gallery-caption s-meta">{d.galleryCaption}</p>}

      {youtubeEmbeds.length > 0 && d.collageMode !== 'masonry' && (
        <div class="youtube-list">
          {youtubeEmbeds.map((video) => (
            <div class:list={[(video.aspect < 1 ? 'youtube-embed--portrait' : ''), 'youtube-embed']} style={`--embed-aspect:${video.aspect}`}>
              <iframe
                src={video.src}
                title={video.title}
                loading="eager"
                referrerpolicy="strict-origin-when-cross-origin"
                allow="autoplay; encrypted-media; picture-in-picture; web-share"
                allowfullscreen
              />
            </div>
          ))}
        </div>
      )}

      {audioSrc && (
        <div class="audio-block">
          <audio controls src={audioSrc} preload="metadata" />
        </div>
      )}
      {d.audioUrls.length > 0 && (
        <div class="audio-list">
          {d.audioUrls.map((url) => (
            <audio controls src={url} preload="metadata" />
          ))}
        </div>
      )}
    </div>
  </article>
  <dialog class="project-zoom" aria-label={`${d.title} image viewer`}>
    <img alt="" />
    <div class="project-zoom-controls">
      <button type="button" data-previous aria-label="Previous image">←</button>
      <span class="s-meta" data-count></span>
      <button type="button" data-next aria-label="Next image">→</button>
      <button type="button" data-close aria-label="Close image">✕</button>
    </div>
  </dialog>
</StudioLayout>

<script>
  const stage = document.querySelector<HTMLElement>('.project .stage');
  const viewer = document.querySelector<HTMLDialogElement>('.project-zoom');
  const viewerImage = viewer?.querySelector<HTMLImageElement>('img');
  const images = Array.from(stage?.querySelectorAll<HTMLImageElement>('img') ?? [])
    .filter((image) => !image.closest('.thumb') && !image.closest('dialog'));
  let shown = 0;
  const show = (index: number) => {
    if (!viewer || !viewerImage || images.length === 0) return;
    shown = (index + images.length) % images.length;
    const source = images[shown];
    viewerImage.src = source.currentSrc || source.src;
    viewerImage.alt = source.alt;
    const count = viewer.querySelector<HTMLElement>('[data-count]');
    if (count) count.textContent = `${shown + 1} / ${images.length}`;
    if (!viewer.open) viewer.showModal();
  };
  images.forEach((image, index) => {
    image.tabIndex = 0;
    image.setAttribute('role', 'button');
    image.setAttribute('aria-label', `Open image ${index + 1} of ${images.length}`);
    image.addEventListener('click', () => show(index));
    image.addEventListener('keydown', (event) => {
      if (event.key === 'Enter' || event.key === ' ') {
        event.preventDefault();
        show(index);
      }
    });
  });
  viewer?.querySelector('[data-previous]')?.addEventListener('click', () => show(shown - 1));
  viewer?.querySelector('[data-next]')?.addEventListener('click', () => show(shown + 1));
  viewer?.querySelector('[data-close]')?.addEventListener('click', () => viewer.close());
  viewer?.addEventListener('click', (event) => { if (event.target === viewer) viewer.close(); });
  viewer?.addEventListener('keydown', (event) => {
    if (event.key === 'ArrowLeft') show(shown - 1);
    if (event.key === 'ArrowRight') show(shown + 1);
  });
</script>

<style>
  .project {
    display: grid;
    grid-template-columns: minmax(220px, 280px) minmax(0, 1fr);
    gap: clamp(28px, 4vw, 64px);
    align-items: stretch;
    justify-content: center;
    width: 100%;
    max-width: min(1680px, 94vw);
    height: calc(100dvh - var(--studio-header-height) - var(--studio-footer-height) - 12px);
    min-height: 0;
    margin: 0 auto;
    overflow: hidden;
  }

  /* left rail */
  .rail {
    display: flex;
    flex-direction: column;
    gap: 0;
    padding-top: 34px;
    min-height: 0;
    overflow: hidden;
  }

  .crumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 18px;
    margin-bottom: 4px;
  }

  .crumbs a {
    color: var(--s-grey);
    text-decoration: none;
  }

  .crumbs a:hover {
    text-decoration: underline;
  }

  h1 {
    font-family: var(--s-serif);
    font-weight: 500;
    font-size: clamp(28px, 2.8vw, 40px);
    line-height: 1.05;
    letter-spacing: 0.015em;
    margin: 30px 0 0;
  }

  .meta {
    margin: 26px 0 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .meta div {
    display: grid;
    grid-template-columns: 74px 1fr;
    gap: 10px;
  }

  .meta dt {
    color: var(--s-faint);
  }

  .meta dd {
    margin: 0;
    color: var(--s-ink);
  }

  .meta-clusters dd { line-height: 1.7; }
  .meta-clusters a {
    color: inherit;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
    text-decoration-color: color-mix(in srgb, currentColor 38%, transparent);
    transition: text-decoration-color 150ms ease, text-decoration-thickness 150ms ease;
  }

  .meta-clusters a:hover,
  .meta-clusters a:focus-visible {
    text-decoration-color: currentColor;
    text-decoration-thickness: 1px;
  }

  .note {
    font-family: var(--s-mono);
    font-size: 12.5px;
    line-height: 1.8;
    color: var(--s-grey);
    margin: 26px 0 0;
    max-width: 40ch;
    flex: 1 1 auto;
    min-height: 0;
    max-height: none;
    overflow-y: auto;
    overscroll-behavior: contain;
    white-space: pre-line;
  }

  .note a {
    color: inherit;
    text-decoration-line: underline;
    text-decoration-style: solid;
    text-decoration-color: color-mix(in srgb, currentColor 42%, transparent);
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
    transition: text-decoration-color 150ms ease, text-decoration-thickness 150ms ease;
  }

  .note a:hover,
  .note a:focus-visible {
    text-decoration-color: currentColor;
    text-decoration-thickness: 2px;
  }

  .pn {
    margin-top: auto;
    padding-top: 24px;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .pn a {
    color: var(--s-ink);
    text-decoration: none;
  }

  .top-crumbs { display:flex; }
  .bottom-crumbs { margin-top: 18px; }
  .bottom-crumbs { display:none; }

  .pn a:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .all {
    margin-top: 22px;
    color: var(--s-grey);
  }

  .related {
    margin-top: 22px;
    display: flex;
    flex-direction: column;
    gap: 5px;
    align-items: flex-start;
  }

  .related a {
    color: var(--s-grey);
    text-decoration-line: underline;
    text-decoration-style: solid;
    text-decoration-color: color-mix(in srgb, var(--s-grey) 52%, transparent);
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
  }

  .related a:hover {
    text-decoration-style: solid;
    text-decoration-color: var(--s-ink);
    text-decoration-thickness: 1px;
  }

  /* right stage — artwork centred, fits the viewport */
  .stage {
    display: flex;
    flex-direction: column;
    /* Tall work starts at the top. Centering a taller-than-viewport flex item
       overflowed equally above and below the stage, cutting off its first row. */
    justify-content: flex-start;
    padding: 24px 0;
    min-width: 0;
    min-height: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
    scrollbar-gutter: stable;
  }

  @media (min-width: 821px) {
    .project--video-landscape .stage { justify-content: center; }
  }

  .stage > img,
  .stage > video {
    display: block;
    max-width: 100%;
    max-height: calc(100dvh - 190px);
    width: auto;
    height: auto;
    margin: 0 auto;
    box-shadow: 0 3px 30px rgba(20, 18, 10, 0.13);
  }

  .stage > img { background: var(--project-image-background, #fff); }

  .youtube-list {
    display: grid;
    gap: 18px;
    width: 100%;
    max-width: 860px;
    margin: 18px auto 0;
  }

  .youtube-list:first-child {
    margin-top: 0;
  }

  .youtube-embed {
    position: relative;
    overflow: hidden;
    width: min(100%, 720px);
    aspect-ratio: var(--embed-aspect, 16 / 9);
    margin-inline: auto;
    background: #111;
    box-shadow: 0 3px 30px rgba(20, 18, 10, 0.13);
  }

  .youtube-embed--square { aspect-ratio: 1; width: min(100%, 720px); margin-inline: auto; }
  .youtube-embed--portrait { width:min(100%, 420px, 40dvh); }

  .youtube-embed iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  /* size variants — use frontmatter `size: small | medium | large` */
  .size-small .stage > img,
