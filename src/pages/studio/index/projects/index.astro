---
import { getCollection } from 'astro:content';
import { getImage } from 'astro:assets';
import StudioLayout from '../../../../layouts/StudioLayout.astro';
import { studioConfig } from '../../../../data/studioConfig';
import { clusterOrder } from '../../../../data/clusterOrder';
import { projectOrder } from '../../../../data/projectOrder';
import { summaryParts } from '../../../../utils/summaryLinks';
import { projectPreviewImages } from '../../../../utils/projectPreviewImages';

const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
const allProjects = (await getCollection('projects')).filter(
  (project) => !project.data.clusters.includes('photography'),
);
const allClusters = await getCollection('clusters');
const clusterTitles = new Map(allClusters.map((cluster) => [cluster.id, cluster.data.title]));
const seen = new Set<string>();
const projects: typeof allProjects = [];
for (const cid of clusterOrder) {
  const list = projectOrder[cid] ?? [];
  const clusterProjects = allProjects
    .filter((p) => p.data.clusters.includes(cid))
    .sort((a, b) => {
      const ia = list.indexOf(a.id);
      const ib = list.indexOf(b.id);
      if (ia !== -1 || ib !== -1) {
        if (ia === -1) return 1;
        if (ib === -1) return -1;
        if (ia !== ib) return ia - ib;
      }
      return b.data.year - a.data.year
        || a.data.title.localeCompare(b.data.title)
        || a.id.localeCompare(b.id);
    });
  for (const project of clusterProjects) {
    if (!seen.has(project.id)) {
      seen.add(project.id);
      projects.push(project);
    }
  }
}
for (const p of allProjects) {
  if (!seen.has(p.id)) {
    projects.push(p);
    seen.add(p.id);
  }
}
const items = await Promise.all(projects.map(async (project) => {
  const d = project.data;
  const youtubeId = project.data.youtubeUrls[0]?.match(/(?:youtu\.be\/|[?&]v=|\/shorts\/|\/embed\/)([A-Za-z0-9_-]{11})/)?.[1];
  const youtubePoster = youtubeId ? { src: `https://i.ytimg.com/vi/${youtubeId}/hqdefault.jpg`, width: 480, height: 360, remote: true } : undefined;
  const shortVideo = project.data.youtubeUrls[0]?.includes('/shorts/');
  const candidates = projectPreviewImages(d);
  const unique = candidates.filter((image, index) => candidates.findIndex((other) => other?.src === image?.src) === index).slice(0, 4);
  const previews = await Promise.all(unique.map(async (media) => {
    const image = await getImage({ src: media!, width: 420, height: 420, fit: 'cover' });
    return { src: image.src, width: image.attributes.width, height: image.attributes.height };
  }));
  const youtubeOnlyPreview = previews.length === 0 && Boolean(youtubePoster);
  if (youtubeOnlyPreview && youtubePoster) previews.push(youtubePoster);
  const previewText = summaryParts(d.summary ?? d.textExcerpt ?? '').map((part) => part.text).join('').trim();
  return { project, previews, previewText, shortVideo: shortVideo && youtubeOnlyPreview };
}));
---

<StudioLayout title={`Projects — ${studioConfig.name}`} section="Projects">
  <article class="listing">
    <header class="listing-head">
      <div><h1>Projects</h1></div>
      <a class="s-link" href={`${base}/studio/index/`}>← index</a>
    </header>
    <div class="project-grid">
      {items.map(({ project, previews, previewText, shortVideo }) => (
        <article class:list={['project', { 'has-writing': Boolean(previewText), 'video-short': shortVideo }]}>
          <a class="image-frame" style={`--project-image-background:${project.data.whiteBackground ? '#fff' : 'transparent'}`} href={`${base}/studio/projects/${project.id}/`} aria-label={`Open ${project.data.title}`}>
            {previews.length === 1 ? (
              <img src={previews[0].src} alt="" width={previews[0].width} height={previews[0].height} loading="lazy" />
            ) : previews.length > 1 ? (
              <span class:list={['preview-grid', `count-${previews.length}`]}>
                {previews.map((preview) => <img src={preview.src} alt="" width={preview.width} height={preview.height} loading="lazy" />)}
              </span>
            ) : project.data.previewType === 'text' ? (
              <span class="text-preview">“{project.data.textExcerpt ?? project.data.summary ?? project.data.title}”</span>
            ) : <span class="placeholder" />}
          </a>
          <div class="caption">
            <h2><a href={`${base}/studio/projects/${project.id}/`}>{project.data.title}</a></h2>
            <time class="s-meta">{project.data.year}</time>
          </div>
          <p class="details s-meta">{project.data.medium.join(', ')}</p>
          {project.data.clusters.length > 0 && (
            <p class="clusters s-meta">
              <span>Clusters:</span>{' '}
              {project.data.clusters.map((clusterId, index) => (
                <><a href={`${base}/studio/clusters/${clusterId}/`}>{clusterTitles.get(clusterId) ?? clusterId}</a>{index < project.data.clusters.length - 1 ? ', ' : ''}</>
              ))}
            </p>
          )}
          {previewText && <p class="text-preview-copy">{previewText}</p>}
        </article>
      ))}
    </div>
  </article>
</StudioLayout>

<style>
  .listing { max-width:1500px; margin:0 auto; }
  .listing-head { position:sticky; top:calc(var(--studio-header-height) + 8px); z-index:20; align-self:start; display:flex; justify-content:space-between; align-items:end; gap:24px; padding:0 0 16px; background:var(--s-bg); }
  .listing-head h1 { margin:0; font-family:var(--s-serif); font-size:clamp(34px,4vw,54px); font-weight:500; line-height:1; }
  .project-grid { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); column-gap:clamp(24px,3vw,48px); row-gap:34px; padding-top:28px; }
  .project { min-width:0; padding-bottom:12px; border-bottom:1px solid var(--s-line); }
  .image-frame { position:relative; display:block; aspect-ratio:1; overflow:hidden; background:#fff; color:inherit; text-decoration:none; }
  .image-frame img { display:block; width:100%; height:100%; object-fit:cover; background:var(--project-image-background,#fff); }
  .video-short .image-frame img { transform:scale(1.8); }
  .placeholder { display:block; width:100%; height:100%; background:#fff; }
  .text-preview { display:grid; place-items:center; width:100%; height:100%; padding:clamp(18px,2.4vw,32px); box-sizing:border-box; border:1px solid var(--s-line); font-family:var(--s-serif); font-size:clamp(16px,1.25vw,20px); line-height:1.45; }
  .preview-grid { display:grid; grid-template-columns:repeat(2,1fr); grid-template-rows:repeat(2,1fr); gap:5px; width:100%; height:100%; }
  .preview-grid.count-2 { grid-template-rows:1fr; }
  .preview-grid.count-3 img:first-child { grid-row:1 / -1; }
  .caption { display:flex; align-items:baseline; justify-content:space-between; gap:10px; margin-top:11px; }
  .caption h2 { margin:0; min-width:0; font-family:var(--s-serif); font-size:clamp(18px,1.5vw,23px); line-height:1.15; font-weight:500; }
  .caption h2 a { color:inherit; text-decoration:none; }
  .caption time { flex:0 0 auto; }
  .details { margin:8px 0 0; line-height:1.5; }
  .clusters { margin:8px 0 0; line-height:1.55; }
  .clusters span { color:var(--s-grey); }
  .clusters a { color:inherit; text-decoration:underline; text-decoration-color:var(--s-line-strong, var(--s-grey)); text-underline-offset:3px; }
  .text-preview-copy { display:-webkit-box; margin:7px 0 0; overflow:hidden; color:var(--s-grey); font-family:var(--s-mono); font-size:10px; line-height:1.55; -webkit-box-orient:vertical; -webkit-line-clamp:2; }
  .project:hover .caption h2 a { text-decoration:underline; text-underline-offset:4px; }
  @media (max-width:1050px) { .project-grid { grid-template-columns:repeat(3,minmax(0,1fr)); } }
  @media (max-width:760px) { .project-grid { grid-template-columns:repeat(2,minmax(0,1fr)); gap:28px 14px; } }
  @media (max-width:480px) { .project-grid { grid-template-columns:1fr; } }
</style>
