---
import { getCollection } from 'astro:content';
import { getImage } from 'astro:assets';
import StudioLayout from '../../../layouts/StudioLayout.astro';
import { studioConfig } from '../../../data/studioConfig';

const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
const clusters = await getCollection('clusters');
const projects = (await getCollection('projects')).sort((a, b) => b.data.year - a.data.year);
const writing = (await getCollection('writing')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const books = (await getCollection('books')).sort((a, b) => {
  if (a.data.yearRead !== b.data.yearRead) return b.data.yearRead - a.data.yearRead;
  return (b.data.dateFinished ?? b.data.title).localeCompare(a.data.dateFinished ?? a.data.title);
});

const projectMedia = (project: (typeof projects)[number]) =>
  project.data.thumbnail ?? project.data.hero ?? project.data.videoPoster ?? project.data.gallery[0];

const clusterItems = await Promise.all(
  clusters.map(async (cluster) => {
    const related = projects.filter((project) => project.data.clusters.includes(cluster.id));
    const media = related.map(projectMedia).find(Boolean);
    const preview = media ? await getImage({ src: media, width: 112 }) : undefined;
    return { cluster, count: related.length, preview };
  }),
);

const projectItems = await Promise.all(
  projects.slice(0, 5).map(async (project) => {
    const media = projectMedia(project);
    return {
      project,
      preview: media ? await getImage({ src: media, width: 144 }) : undefined,
    };
  }),
);

const writingItems = await Promise.all(
  writing.slice(0, 4).map(async (entry) => {
    const media = entry.data.image ?? entry.data.gallery[0];
    return {
      entry,
      preview: media ? await getImage({ src: media, width: 112 }) : undefined,
    };
  }),
);

const readingItems = await Promise.all(
  books.slice(0, 4).map(async (book) => ({
    book,
    cover: await getImage({ src: book.data.cover, width: 80 }),
  })),
);

const sectionLink = (href: string) => `${base}${href}`;
const formatDate = (date: Date) =>
  date.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: '2-digit' });
---

<StudioLayout
  title={`${studioConfig.indexLabel} — ${studioConfig.name}`}
  section={studioConfig.indexLabel}
  viewportFit
>
  <div class="directory">
    <h1 class="page-title">{studioConfig.indexLabel}</h1>
    <section class="panel clusters-panel" aria-labelledby="clusters-heading">
      <header class="panel-head">
        <div>
          <span class="number s-meta">01</span>
          <h2 id="clusters-heading">Clusters</h2>
        </div>
        <a class="all-link s-meta" href={sectionLink('/studio/index/clusters/')}>view all <span aria-hidden="true">↗</span></a>
      </header>
      <div class="cluster-grid">
        {clusterItems.map(({ cluster, count, preview }) => (
          <a class="cluster" href={sectionLink(`/studio/clusters/${cluster.id}/`)}>
            {preview && <img src={preview.src} alt="" width={preview.attributes.width} height={preview.attributes.height} loading="eager" />}
            <span class="cluster-copy">
              <strong>{cluster.data.title}</strong>
              <small class="s-meta">{count} {count === 1 ? 'project' : 'projects'}</small>
            </span>
          </a>
        ))}
      </div>
    </section>

    <section class="panel projects-panel" aria-labelledby="projects-heading">
      <header class="panel-head">
        <div>
          <span class="number s-meta">02</span>
          <h2 id="projects-heading">Projects</h2>
        </div>
        <a class="all-link s-meta" href={sectionLink('/studio/index/projects/')}>view all <span aria-hidden="true">↗</span></a>
      </header>
      <div class="rows project-rows">
        {projectItems.map(({ project, preview }, index) => (
          <a class="project-row" href={sectionLink(`/studio/projects/${project.id}/`)}>
            <span class="row-index s-meta">{String(index + 1).padStart(2, '0')}</span>
            {preview ? (
              <img src={preview.src} alt="" width={preview.attributes.width} height={preview.attributes.height} loading="eager" />
            ) : <span class="image-placeholder" aria-hidden="true" />}
            <span class="row-title">{project.data.title}</span>
            <span class="row-detail s-meta">{project.data.types[0] ?? 'work'}</span>
            <time class="s-meta">{project.data.year}</time>
            <span aria-hidden="true">→</span>
          </a>
        ))}
      </div>
    </section>

    <section class="panel writing-panel" aria-labelledby="writing-heading">
      <header class="panel-head">
        <div>
          <span class="number s-meta">03</span>
          <h2 id="writing-heading">{studioConfig.writingLabel}</h2>
        </div>
        <a class="all-link s-meta" href={sectionLink('/studio/writing/')}>view all <span aria-hidden="true">↗</span></a>
      </header>
      <div class="writing-grid">
        {writingItems.map(({ entry, preview }) => (
          <a class="writing-card" href={sectionLink(`/studio/writing/${entry.id}/`)}>
            {preview && <img src={preview.src} alt="" width={preview.attributes.width} height={preview.attributes.height} loading="lazy" />}
            <span class="writing-copy">
              <span class="s-meta">{entry.data.type} · {formatDate(entry.data.date)}</span>
              <strong>{entry.data.title ?? entry.id.replace(/-/g, ' ')}</strong>
              {entry.data.excerpt && <small>{entry.data.excerpt}</small>}
            </span>
          </a>
        ))}
      </div>
    </section>

    <section class="panel reading-panel" aria-labelledby="reading-heading">
      <header class="panel-head">
        <div>
          <span class="number s-meta">04</span>
          <h2 id="reading-heading">Reading</h2>
        </div>
        <a class="all-link s-meta" href={sectionLink('/studio/bookshelf/')}>view all <span aria-hidden="true">↗</span></a>
      </header>
      <div class="book-grid">
        {readingItems.map(({ book, cover }) => (
          <a class="book" href={sectionLink(`/studio/bookshelf/${book.id}/`)}>
            <img src={cover.src} alt="" width={cover.attributes.width} height={cover.attributes.height} loading="lazy" />
            <span>
              <strong>{book.data.title}</strong>
              <small class="s-meta">{book.data.author}</small>
            </span>
          </a>
        ))}
      </div>
    </section>
  </div>
</StudioLayout>

<style>
  .directory {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.18fr);
    grid-template-rows: auto auto auto;
    align-content: start;
    gap: clamp(18px, 2.2vw, 34px);
    min-height: calc(100dvh - var(--studio-header-height) - var(--studio-footer-height) - 56px);
    padding: 0 0 8px;
  }

  .page-title {
    grid-column: 1 / -1;
    margin: 0;
    font-family: var(--s-serif);
    font-size: clamp(28px, 2.4vw, 38px);
    font-weight: 500;
    line-height: 1;
  }

  .panel {
    min-width: 0;
    overflow: hidden;
    border-top: 1px solid var(--s-ink);
  }

  .writing-panel,
  .reading-panel {
    margin-top: clamp(42px, 6vh, 78px);
  }

  .panel-head,
  .panel-head > div {
    display: flex;
    align-items: baseline;
  }

  .panel-head {
    justify-content: space-between;
    gap: 20px;
    min-height: 48px;
    padding: 8px 0 7px;
    border-bottom: 1px solid var(--s-line);
  }

  .panel-head > div { gap: 12px; }
  .number { color: var(--s-faint); }

  h2 {
    margin: 0;
    font-family: var(--s-serif);
    font-size: clamp(23px, 2vw, 30px);
    font-weight: 500;
    line-height: 1;
  }

  .all-link {
    color: var(--s-ink);
    text-decoration: none;
    white-space: nowrap;
  }

  .all-link:hover { text-decoration: underline; text-underline-offset: 3px; }

  .cluster-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .cluster {
    display: flex;
    min-width: 0;
    min-height: 66px;
    align-items: center;
    gap: 9px;
    padding: 6px 8px 6px 0;
    border-bottom: 1px solid var(--s-line);
    color: inherit;
    text-decoration: none;
  }

  .cluster img {
    width: 52px;
    height: 52px;
    flex: 0 0 auto;
    object-fit: cover;
    filter: saturate(.82);
  }

  .cluster-copy, .book > span, .writing-copy { min-width: 0; }
  .cluster strong, .cluster small, .book strong, .book small { display: block; }
  .cluster strong {
    overflow: hidden;
    font-family: var(--s-serif);
    font-size: 16px;
    font-weight: 500;
    line-height: 1.05;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .cluster small { margin-top: 3px; font-size: 9px; }
  .cluster:hover strong, .row-title:hover { text-decoration: underline; }

  .rows { display: grid; }
  .project-row {
    display: grid;
    grid-template-columns: 24px 48px minmax(120px, 1fr) minmax(64px, .5fr) 40px 16px;
    align-items: center;
    gap: 10px;
    min-height: 42px;
    border-bottom: 1px solid var(--s-line);
    color: inherit;
    text-decoration: none;
  }
  .project-row img, .image-placeholder {
    display: block;
    width: 48px;
    height: 32px;
    object-fit: cover;
    background: var(--s-line);
  }
  .row-title {
    overflow: hidden;
    font-family: var(--s-serif);
    font-size: 17px;
    line-height: 1.1;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .row-detail { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

  .writing-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: 18px;
  }
  .writing-card {
    display: flex;
    min-width: 0;
    height: 86px;
    gap: 10px;
    padding: 9px 0;
    border-bottom: 1px solid var(--s-line);
    color: inherit;
    text-decoration: none;
  }
  .writing-card img {
    width: 58px;
    height: 68px;
    flex: 0 0 auto;
    object-fit: cover;
  }
  .writing-copy { display: flex; flex-direction: column; }
  .writing-copy strong {
    margin-top: 4px;
    font-family: var(--s-serif);
    font-size: 17px;
    font-weight: 500;
    line-height: 1.05;
  }
  .writing-copy small {
    display: -webkit-box;
    overflow: hidden;
    margin-top: 4px;
    color: var(--s-grey);
    font-family: var(--s-mono);
    font-size: 9px;
    line-height: 1.35;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }
  .writing-card:hover strong, .book:hover strong { text-decoration: underline; }

  .book-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 14px;
    padding-top: 12px;
  }
  .book { color: inherit; text-decoration: none; min-width: 0; }
  .book img {
    display: block;
    width: auto;
    height: 105px;
    max-width: 100%;
    margin-bottom: 7px;
    object-fit: contain;
    object-position: left bottom;
    box-shadow: 0 2px 8px rgba(26, 25, 21, .12);
  }
  .book strong {
    overflow: hidden;
    font-family: var(--s-serif);
    font-size: 14px;
    font-weight: 500;
    line-height: 1.05;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .book small {
    overflow: hidden;
    margin-top: 3px;
    font-size: 8px;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  @media (max-width: 1000px) {
    .directory { grid-template-columns: 1fr; grid-template-rows: auto; min-height: 0; }
    .page-title { grid-column: 1; }
    .writing-panel, .reading-panel { margin-top: 0; }
    .panel { overflow: visible; }
  }

  @media (max-width: 620px) {
    .directory { gap: 32px; padding-top: 18px; }
    .cluster-grid { grid-template-columns: 1fr; }
    .project-row { grid-template-columns: 20px 48px minmax(0, 1fr) 34px 14px; }
    .project-row .row-detail { display: none; }
    .writing-grid { grid-template-columns: 1fr; }
    .writing-card { height: auto; min-height: 86px; }
    .book-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px 16px; }
    .book img { height: 140px; }
  }
</style>
