---
import { getCollection } from 'astro:content';
import { getImage } from 'astro:assets';
import BookCover from '../../../components/studio/BookCover.astro';
import StudioLayout from '../../../layouts/StudioLayout.astro';
import { studioConfig } from '../../../data/studioConfig';
import { clusterOrder } from '../../../data/clusterOrder';
import { projectOrder } from '../../../data/projectOrder';
import { sortWritingEntries } from '../../../data/writingOrder';
import { sortPhotographyProjects } from '../../../data/photographyOrder';
import { bookFavouriteOrder } from '../../../data/bookFavouriteOrder';
import { projectPreviewImages } from '../../../utils/projectPreviewImages';

const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
const allClusters = await getCollection('clusters');
const clusters = [...allClusters].filter((cluster) => cluster.id !== 'photography').sort((a, b) => {
  const ia = clusterOrder.indexOf(a.id);
  const ib = clusterOrder.indexOf(b.id);
  if (ia !== -1 || ib !== -1) {
    if (ia === -1) return 1;
    if (ib === -1) return -1;
    return ia - ib;
  }
  return a.id.localeCompare(b.id);
});

// Index total list: walk clusterOrder top→bottom, emit project only first time seen
const allProjects = await getCollection('projects');
// Photography has a dedicated gallery. It remains available there and via
// its canonical project route, but is omitted from the general project index.
const generalProjects = allProjects.filter((project) => !project.data.clusters.includes('photography'));
const byId = new Map(generalProjects.map((p) => [p.id, p]));
const seen = new Set<string>();
const orderedProjects: typeof allProjects = [];
for (const cid of clusterOrder) {
  const list = projectOrder[cid] ?? [];
  for (const pid of list) {
    if (!seen.has(pid) && byId.has(pid)) {
      seen.add(pid);
      orderedProjects.push(byId.get(pid)!);
    }
  }
}
// Append any projects not in any order (new ones)
for (const p of generalProjects) {
  if (!seen.has(p.id)) {
    orderedProjects.push(p);
    seen.add(p.id);
  }
}
const projects = orderedProjects;

const allWriting = await getCollection('writing');
const writing = sortWritingEntries(allWriting);
const allBooks = await getCollection('books');
const favouritePositions = new Map(bookFavouriteOrder.map((id, index) => [id, index] as const));
const favourites = allBooks
  .filter((book) => book.data.featured)
  .sort((a, b) => (favouritePositions.get(a.id) ?? Number.MAX_SAFE_INTEGER) - (favouritePositions.get(b.id) ?? Number.MAX_SAFE_INTEGER)
    || a.data.title.localeCompare(b.data.title));
const currentYear = Math.max(...allBooks.map((book) => book.data.yearRead ?? Number.NEGATIVE_INFINITY));
const currentYearBooks = allBooks
  .filter((book) => book.data.shelf !== 'others' && book.data.yearRead === currentYear)
  .sort((a, b) => {
    const aHasDate = Boolean(a.data.dateFinished);
    const bHasDate = Boolean(b.data.dateFinished);
    if (aHasDate !== bHasDate) return aHasDate ? -1 : 1;
    return (a.data.dateFinished ?? a.data.title).localeCompare(b.data.dateFinished ?? b.data.title);
  });
const books = [...favourites, ...currentYearBooks.filter((book) => !favourites.some((favourite) => favourite.id === book.id))];

const projectMedia = (project: (typeof projects)[number]) =>
  projectPreviewImages(project.data)[0];

const clusterItems = await Promise.all(
  clusters.slice(0, 6).map(async (cluster) => {
    const related = projects.filter((project) => project.data.clusters.includes(cluster.id));
    const order = projectOrder[cluster.id] ?? [];
    related.sort((a, b) => {
      const ia = order.indexOf(a.id);
      const ib = order.indexOf(b.id);
      if (ia !== -1 || ib !== -1) {
        if (ia === -1) return 1;
        if (ib === -1) return -1;
        return ia - ib;
      }
      const featured = Number(b.data.featured) - Number(a.data.featured);
      return featured || a.id.localeCompare(b.id);
    });
    const media = [cluster.data.previewImage, ...related.map(projectMedia)].filter(Boolean);
    const unique = media.filter((image, index) => media.findIndex((other) => other?.src === image?.src) === index).slice(0, 4);
    const previews = await Promise.all(unique.map((image) => getImage({ src: image!, width: 112, height: 112, fit: 'cover' })));
    return { cluster, previews };
  }),
);

const projectItems = await Promise.all(
  projects.slice(0, 9).map(async (project) => {
    const media = projectMedia(project);
    return {
      project,
      preview: media ? await getImage({ src: media, width: 112 }) : undefined,
    };
  }),
);

const photographyProjects = sortPhotographyProjects(
  allProjects.filter((project) => project.data.clusters.includes('photography')),
).slice(0, 4);
const photographyItems = await Promise.all(photographyProjects.map(async (project) => {
  const media = project.data.gallery[0] ?? project.data.hero ?? project.data.thumbnail;
  return { project, preview: media ? await getImage({ src: media, width: 180 }) : undefined };
}));

const writingItems = await Promise.all(
  writing.slice(0, 4).map(async (entry) => {
    const media = entry.data.preview?.image ?? entry.data.image ?? entry.data.gallery[0];
    return {
      entry,
      preview: media ? await getImage({ src: media, width: 112 }) : undefined,
    };
  }),
);

const readingItems = await Promise.all(
  books.slice(0, 4).map((book) => ({
    book,
    cover: book.data.cover,
  })),
);

const sectionLink = (href: string) => `${base}${href}`;
const formatDate = (date: Date) =>
  date.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: '2-digit' });
---

<StudioLayout
  title={`${studioConfig.indexLabel} — ${studioConfig.name}`}
  section={studioConfig.indexLabel}
  viewportFit
>
  <div class="directory">
    <h1 class="page-title">{studioConfig.indexLabel}</h1>
    <section class="panel clusters-panel" aria-labelledby="clusters-heading">
      <header class="panel-head">
        <div>
          <h2 id="clusters-heading"><a href={sectionLink('/studio/index/clusters/')}>Clusters</a></h2>
        </div>
      </header>
      <div class="cluster-grid">
        {clusterItems.map(({ cluster, previews }) => (
          <a class="cluster" href={sectionLink(`/studio/clusters/${cluster.id}/`)}>
            <span class:list={['cluster-gallery', `count-${previews.length}`]}>
              {previews.map((preview) => <img src={preview.src} alt="" width={preview.attributes.width} height={preview.attributes.height} loading="eager" />)}
            </span>
            <span class="cluster-copy">
              <strong>{cluster.data.title}</strong>
              <small class="s-meta">{cluster.data.description}</small>
            </span>
          </a>
        ))}
      </div>
      <a class="panel-more s-meta" href={sectionLink('/studio/index/clusters/')}>view all clusters <span aria-hidden="true">↗</span></a>
    </section>

    <section class="panel projects-panel" aria-labelledby="projects-heading">
      <header class="panel-head">
        <div>
          <h2 id="projects-heading"><a href={sectionLink('/studio/index/projects/')}>Projects</a></h2>
        </div>
      </header>
      <div class="project-grid">
        {projectItems.map(({ project, preview }) => (
          <a class="project-tile" href={sectionLink(`/studio/projects/${project.id}/`)}>
            {preview ? <img src={preview.src} alt="" width={preview.attributes.width} height={preview.attributes.height} loading="eager" /> : <span class="project-placeholder" aria-hidden="true" />}
            <span class="project-caption">
              <strong>{project.data.title}</strong>
              <time class="s-meta">{project.data.year}</time>
            </span>
          </a>
        ))}
      </div>
      <a class="panel-more s-meta" href={sectionLink('/studio/index/projects/')}>view all projects <span aria-hidden="true">↗</span></a>
    </section>

    <section class="panel photography-panel" aria-labelledby="photography-heading">
      <header class="panel-head"><div><h2 id="photography-heading"><a href={sectionLink('/studio/photography/')}>Photography</a></h2></div></header>
      <div class="photography-grid">
        {photographyItems.map(({ project, preview }) => (
          <a class="photography-tile" href={sectionLink(`/studio/projects/${project.id}/`)}>
            <span class="photography-media">
              {preview ? <img src={preview.src} alt="" width={preview.attributes.width} height={preview.attributes.height} loading="lazy" /> : <span class="project-placeholder" aria-hidden="true" />}
            </span>
            <span class="project-caption"><strong>{project.data.title}</strong><time class="s-meta">{project.data.year}</time></span>
          </a>
        ))}
      </div>
      <a class="panel-more s-meta" href={sectionLink('/studio/photography/')}>view all photography <span aria-hidden="true">↗</span></a>
    </section>

    <section class="panel writing-panel" aria-labelledby="writing-heading">
      <header class="panel-head">
        <div>
          <h2 id="writing-heading"><a href={sectionLink('/studio/writing/')}>{studioConfig.writingLabel}</a></h2>
        </div>
      </header>
      <div class="writing-grid">
        {writingItems.map(({ entry, preview }) => (
          <a class="writing-card" href={sectionLink(`/studio/writing/${entry.id}/`)}>
            {preview && <img src={preview.src} alt="" width={preview.attributes.width} height={preview.attributes.height} loading="lazy" />}
            <span class="writing-copy">
              <strong>{entry.data.title ?? entry.id.replace(/-/g, ' ')}</strong>
              <span class="s-meta">{formatDate(entry.data.date)}</span>
              {entry.data.excerpt && <small>{entry.data.excerpt}</small>}
            </span>
          </a>
        ))}
      </div>
      <a class="panel-more s-meta" href={sectionLink('/studio/writing/')}>view all writing <span aria-hidden="true">↗</span></a>
    </section>

    <section class="panel reading-panel" aria-labelledby="bookshelves-heading">
      <header class="panel-head">
        <div>
          <h2 id="bookshelves-heading"><a href={sectionLink('/studio/bookshelf/')}>Bookshelf</a></h2>
        </div>
      </header>
      <div class="book-grid">
        {readingItems.map(({ book, cover }) => (
          <a class="book" href={sectionLink(`/studio/bookshelf/${book.id}/`)}>
            <BookCover cover={cover} title={book.data.title} author={book.data.author} alt="" width={120} height={180} loading="lazy" coverLookup={book.data.coverLookup} />
            <span>
              <strong>{book.data.title}</strong>
              <small class="s-meta">{book.data.author}</small>
            </span>
          </a>
        ))}
      </div>
      <a class="panel-more s-meta" href={sectionLink('/studio/bookshelf/')}>view bookshelves <span aria-hidden="true">↗</span></a>
    </section>
  </div>
</StudioLayout>

<style>
  .directory {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    grid-template-rows: auto auto auto;
    align-content: start;
    column-gap: clamp(40px, 5vw, 80px);
    row-gap: clamp(30px, 4.2vh, 48px);
    min-height: calc(100dvh - var(--studio-header-height) - var(--studio-footer-height) - 56px);
    padding: 0 0 8px;
  }

  .page-title {
    grid-column: 1 / -1;
    order: -1;
    margin: 0;
    font-family: var(--s-serif);
    font-size: var(--studio-page-title-size);
    font-weight: 500;
    line-height: 1;
  }

  .clusters-panel, .projects-panel { grid-column: span 3; order: 0; }
  .writing-panel, .photography-panel { grid-column: span 2; }
  .reading-panel { grid-column: span 2; }
  .writing-panel { order: 1; }
  .photography-panel { order: 2; }
  .reading-panel { order: 3; }

  .panel {
    display: flex;
    flex-direction: column;
    min-width: 0;
    overflow: hidden;
    border-top: 0;
    border-bottom: 0;
  }

  .panel-head,
  .panel-head > div {
    display: flex;
    align-items: baseline;
  }

  .panel-head {
    justify-content: space-between;
    gap: 20px;
    min-height: 42px;
    padding: 0 0 7px;
    /* Keep the section divisions visible on the light index background. */
    border-bottom: 1px solid #bdbbb4;
  }

  .panel-head > div { gap: 12px; }

  h2 {
    margin: 0;
    font-family: var(--s-serif);
    font-size: clamp(23px, 2vw, 30px);
    font-weight: 500;
    line-height: 1;
  }

  h2 a { color: inherit; text-decoration: none; }
  h2 a:hover { text-decoration: underline; text-underline-offset: 4px; }

  .panel-more {
    display: block;
    width: max-content;
    margin: auto 0 0 auto;
    padding-top: 8px;
    color: var(--s-ink);
    text-decoration: none;
  }
  .panel-more:hover { text-decoration: underline; text-underline-offset: 3px; }

  .cluster-grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); column-gap:clamp(14px,1.7vw,26px); row-gap:8px; }
  .project-grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); column-gap:clamp(12px,1.7vw,26px); }

  .photography-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(8px, 1vw, 14px);
    padding-top: 10px;
  }

  .project-tile,
  .cluster {
    display: flex;
    min-width: 0;
    min-height: 66px;
    align-items: center;
    gap: 9px;
    padding: 6px 0;
    color: inherit;
    text-decoration: none;
  }

  .photography-tile { display: block; min-width: 0; color: inherit; text-decoration: none; }
  .photography-media { display: block; overflow: hidden; aspect-ratio: 1; background: #fff; }
  .photography-media img, .photography-media .project-placeholder { display: block; width: 100%; height: 100%; object-fit: cover; }
  .project-tile img,
  .project-tile .project-placeholder {
    display: block;
    width: 52px;
    height: 52px;
    flex: 0 0 auto;
    object-fit: cover;
  }
  .project-tile img, .photography-tile img { background: #fff; }
  .project-placeholder { background: var(--s-line); }
  .project-caption { display: flex; min-width: 0; flex-direction: column; }
  .project-caption strong { overflow: hidden; font-family: var(--s-serif); font-size: 16px; font-weight: 500; line-height: 1.05; text-overflow: ellipsis; white-space: nowrap; }
  .project-caption time { margin-top: 3px; font-size: 9px; }
  .photography-tile .project-caption { display: flex; flex-direction: row; justify-content: space-between; align-items: baseline; gap: 5px; margin-top: 5px; }
  .photography-tile .project-caption strong { font-size: 11px; }
  .photography-tile .project-caption time { flex: 0 0 auto; margin-top: 0; font-size: 8px; }
  .project-tile:hover strong, .photography-tile:hover strong { text-decoration: underline; }

  .cluster { padding-right: 0; align-items:flex-start; }
  .cluster-gallery { display:grid; grid-template-columns:repeat(2,1fr); grid-template-rows:repeat(2,1fr); gap:3px; width:58px; height:58px; flex:0 0 auto; overflow:hidden; background:#fff; }
  .cluster-gallery.count-1 { display:block; }
  .cluster-gallery.count-2 { grid-template-rows:1fr; }
  .cluster-gallery.count-3 img:first-child { grid-row:1 / -1; }
  .cluster-gallery img { display:block; width:100%; height:100%; object-fit:cover; background:#fff; filter:saturate(.82); }

  .cluster-copy, .book > span, .writing-copy { min-width: 0; }
  .cluster strong, .cluster small, .book strong, .book small { display: block; }
  .cluster strong {
    overflow: hidden;
    font-family: var(--s-serif);
    font-size: 16px;
    font-weight: 500;
    line-height: 1.05;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .cluster small { display:-webkit-box; margin-top: 5px; overflow:hidden; font-size:9px; line-height:1.35; -webkit-box-orient:vertical; -webkit-line-clamp:3; line-clamp:3; }

  .writing-panel, .photography-panel, .reading-panel { margin-top:clamp(12px,2vh,22px); }
  .cluster:hover strong, .row-title:hover { text-decoration: underline; }

  .rows { display: grid; }
  .project-row {
    display: grid;
    grid-template-columns: 24px 48px minmax(120px, 1fr) minmax(64px, .5fr) 40px 16px;
    align-items: center;
    gap: 10px;
    min-height: 42px;
    color: inherit;
    text-decoration: none;
  }
  .project-row img, .image-placeholder {
    display: block;
    width: 48px;
    height: 32px;
    object-fit: cover;
    background: var(--s-line);
  }
  .row-title {
    overflow: hidden;
    font-family: var(--s-serif);
    font-size: 17px;
    line-height: 1.1;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .row-detail { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

  .writing-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: 18px;
  }
  .writing-card {
    display: flex;
    min-width: 0;
    height: 86px;
    gap: 10px;
    padding: 9px 0;
    color: inherit;
    text-decoration: none;
  }
  .writing-card img {
    width: 58px;
    height: 68px;
    flex: 0 0 auto;
    object-fit: cover;
  }
  .writing-copy { display: flex; flex-direction: column; }
  .writing-copy strong {
    margin-top: 4px;
    font-family: var(--s-serif);
    font-size: 17px;
    font-weight: 500;
    line-height: 1.05;
  }
  .writing-copy small {
    display: -webkit-box;
    overflow: hidden;
    margin-top: 4px;
    color: var(--s-grey);
    font-family: var(--s-mono);
    font-size: 9px;
    line-height: 1.35;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }
  .writing-card:hover strong, .book:hover strong { text-decoration: underline; }

  .book-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 14px;
    padding-top: 12px;
  }
  .book { color: inherit; text-decoration: none; min-width: 0; }
  :global(.book img) {
    display: block;
    width: auto;
    height: 105px;
    max-width: 100%;
    margin-bottom: 7px;
    object-fit: contain;
    object-position: left bottom;
    box-shadow: 0 2px 8px rgba(26, 25, 21, .12);
  }
  .book strong {
    overflow: hidden;
    font-family: var(--s-serif);
    font-size: 14px;
    font-weight: 500;
    line-height: 1.05;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .book small {
    overflow: hidden;
    margin-top: 3px;
    font-size: 8px;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  @media (max-width: 1000px) {
    .directory { grid-template-columns: repeat(2, minmax(0, 1fr)); grid-template-rows: auto; min-height: 0; }
    .page-title { grid-column: 1 / -1; }
    .clusters-panel, .projects-panel { grid-column: span 1; }
    .writing-panel, .photography-panel, .reading-panel { grid-column: span 1; margin-top: 0; }
    .panel { overflow: visible; }
  }

  @media (max-width: 620px) {
    .directory { grid-template-columns: 1fr; gap: 32px; padding-top: 18px; }
    .clusters-panel, .projects-panel, .writing-panel, .photography-panel, .reading-panel { grid-column: 1; }
    .cluster-grid, .project-grid { grid-template-columns: 1fr; }
    .project-row { grid-template-columns: 20px 48px minmax(0, 1fr) 34px 14px; }
    .project-row .row-detail { display: none; }
    .photography-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .writing-grid { grid-template-columns: 1fr; }
    .writing-card { height: auto; min-height: 86px; }
    .book-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px 16px; }
    .book img { height: 140px; }
  }
</style>
