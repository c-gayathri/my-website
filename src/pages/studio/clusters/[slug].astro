---
import { getCollection } from 'astro:content';
import StudioLayout from '../../../layouts/StudioLayout.astro';
import { projectOrder } from '../../../data/projectOrder';

export async function getStaticPaths() {
  const clusters = await getCollection('clusters');
  return clusters.map((cluster) => ({ params: { slug: cluster.id }, props: { cluster } }));
}

const { cluster } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
const all = await getCollection('projects');
const order = projectOrder[cluster.id] ?? [];
const projects = all
  .filter((p) => p.data.clusters.includes(cluster.id))
  .sort((a, b) => {
    const ia = order.indexOf(a.id);
    const ib = order.indexOf(b.id);
    if (ia !== -1 || ib !== -1) {
      if (ia === -1) return 1;
      if (ib === -1) return -1;
      return ia - ib;
    }
    // Fallback: featured first, then id
    const fa = a.data.featured ? 1 : 0;
    const fb = b.data.featured ? 1 : 0;
    if (fa !== fb) return fb - fa;
    return a.id.localeCompare(b.id);
  });

const projectMedia = (project: (typeof projects)[number]) => {
  const d = project.data;
  // Featured image takes precedence
  if (d.featuredImage) {
    const pool = [d.hero, d.thumbnail, d.videoPoster, ...d.gallery].filter(Boolean) as NonNullable<typeof d.hero>[];
    const hit = pool.find((img) => String((img as any).src).includes(d.featuredImage!));
    if (hit) return hit;
  }
  return d.thumbnail ?? d.hero ?? d.gallery[0] ?? d.videoPoster;
};

const galleryPreviewImages = (project: (typeof projects)[number]) => {
  const d = project.data;
  const candidates = [d.hero, ...d.gallery].filter(Boolean) as NonNullable<typeof d.hero>[];
  return candidates.filter((image, index) => candidates.findIndex((other) => other.src === image.src) === index);
};

const galleryPreview = (project: (typeof projects)[number]) => {
  const d = project.data;
  const pool = galleryPreviewImages(project);
  // Use featuredImage first if present
  if (d.featuredImage) {
    const hit = pool.find((img) => String((img as any).src).includes(d.featuredImage!));
    if (hit) return [hit, ...pool.filter((x) => x !== hit)].slice(0, 3);
  }
  return pool.slice(0, 3);
};

const cards = projects;
---

<StudioLayout title={`${cluster.data.title} — Studio`}>
  <article class="cluster-page">
    <nav class="crumbs s-meta" aria-label="Breadcrumb">
      <a href={`${base}/studio/`}>← constellation</a>
      <a href={`${base}/studio/index/clusters/`}>← all clusters</a>
    </nav>

    <header class="cluster-header">
      <div class="heading">
        <h1>{cluster.data.title}</h1>
        {cluster.data.subtitle && <p class="s-meta sub">{cluster.data.subtitle}</p>}
      </div>
      <div class="intro">
        <p class="s-meta meta">
          {projects.length} {projects.length === 1 ? 'project' : 'projects'}
        </p>
        <p class="desc">{cluster.data.description}</p>
      </div>
    </header>

    <div class="cards">
      {
        cards.map((p, i) => {
          const d = p.data;
          const href = `${base}/studio/projects/${p.id}/`;
          const previews = galleryPreview(p);
          const previewImageCount = galleryPreviewImages(p).length;
          return (
            <a class:list={['card', `type-${d.previewType}`]} href={href}>
              <span class="num s-meta">{String(i + 1).padStart(2, '0')}.</span>
              <h2>{d.title}</h2>
              <span class="s-meta type">{[d.medium[0], d.year].filter(Boolean).join(' · ')}</span>
              {d.previewType === 'text' ? (
                <p class="s-meta excerpt">“{d.textExcerpt ?? d.summary}”</p>
              ) : previews.length ? (
                <span class="media">
                  {previews.length === 1 ? (
                    <img
                      src={previews[0].src}
                      alt={d.title}
                      width={previews[0].width}
                      height={previews[0].height}
                      loading={i < 3 ? 'eager' : 'lazy'}
                    />
                  ) : (
                    <span class="mini-grid">
                      {previews.map((im) => (
                        <img src={im.src} alt={d.title} width={im.width} height={im.height} loading="lazy" />
                      ))}
                    </span>
                  )}
                  {d.previewType === 'video' && <span class="play" aria-hidden="true">▶</span>}
                  {previewImageCount > previews.length && (
                    <span class="s-meta plus">+ {previewImageCount - previews.length}</span>
                  )}
                  {d.previewType === 'media-text' && d.summary && (
                    <span class="s-meta side">{d.summary}</span>
                  )}
                </span>
              ) : null}
              <span class="go s-meta" aria-hidden="true">→</span>
            </a>
          );
        })
      }
    </div>
  </article>
</StudioLayout>

<style>
  .cluster-page {
    min-height: calc(100dvh - 130px);
  }

  .crumbs a {
    color: var(--s-grey);
    text-decoration: none;
  }

  .crumbs a:hover {
    text-decoration: underline;
  }

  .cluster-header {
    position: relative;
    display: grid;
    grid-template-columns: minmax(260px, 0.85fr) minmax(280px, 1fr);
    gap: clamp(24px, 4vw, 72px);
    align-items: end;
    margin-top: 18px;
    padding-bottom: 18px;
    border-bottom: 1px solid var(--s-line);
  }

  .cluster-header h1 {
    font-family: var(--s-serif);
    font-weight: 500;
    font-size: clamp(34px, 3.7vw, 56px);
    line-height: 0.96;
    letter-spacing: 0.01em;
    margin: 0;
  }

  .sub {
    margin: 8px 0 0;
  }

  .meta {
    margin: 0;
  }

  .desc {
    font-family: var(--s-mono);
    font-size: 12.5px;
    line-height: 1.75;
    color: var(--s-grey);
    max-width: 52ch;
    margin: 8px 0 0;
  }

  /* Grid provides left-to-right order (1,2,3) without empty gaps. */
  .cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    margin-top: 20px;
    align-items: start;
  }

  .card {
    position: relative;
    border: 1px solid var(--s-line);
    padding: 16px 16px 40px;
    text-decoration: none;
    color: inherit;
    display: flex;
    flex-direction: column;
    min-width: 0;
    width: 100%;
    overflow: hidden;
    transition: border-color 0.25s ease;
  }

  .card:hover {
    border-color: var(--s-grey);
  }

  .card h2 {
    font-family: var(--s-serif);
    font-weight: 500;
    font-size: 24px;
    line-height: 1.1;
    margin: 8px 0 0;
  }

  .card .type {
    margin-top: 5px;
    text-transform: uppercase;
    font-size: 10.5px;
  }

  .card .excerpt {
    margin: 12px 0 0;
    line-height: 1.7;
    white-space: pre-line;
  }

  .card .go {
    position: absolute;
    right: 16px;
    bottom: 12px;
    color: var(--s-ink);
  }

  .media {
    position: relative;
    display: block;
    margin-top: 14px;
  }

  .media img {
    width: 100%;
    height: auto;
    max-height: 280px;
    object-fit: contain;
    object-position: left center;
    display: block;
  }

  .mini-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 6px;
  }

  .mini-grid img {
    width: 100%;
    height: 120px;
    object-fit: cover;
    display: block;
  }

  .mini-grid img:first-child {
    grid-column: 1 / -1;
    height: 160px;
  }

  .play {
    position: absolute;
    inset: 0;
    margin: auto;
    width: 42px;
    height: 42px;
    display: grid;
    place-items: center;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.85);
    color: #111;
    font-size: 13px;
  }

  .plus {
    position: absolute;
    right: 8px;
    bottom: 8px;
    background: var(--s-bg);
    border: 1px solid var(--s-line);
    padding: 2px 7px;
  }

  .side {
    display: block;
    margin-top: 10px;
    line-height: 1.6;
    white-space: pre-line;
  }

  /* writing cards read quieter */
  .card.writing {
    background: transparent;
  }

  @media (max-width: 900px) {
    .cluster-header {
      grid-template-columns: minmax(220px, 0.8fr) 1.2fr;
    }

    .cards {
      grid-template-columns: repeat(2, 1fr);
    }

  }

  @media (max-width: 680px) {
    .cluster-page {
      min-height: 0;
    }

    .cluster-header {
      display: block;
      margin-top: 14px;
      padding-bottom: 14px;
    }

    .intro {
      margin-top: 14px;
    }

    .cards {
      grid-template-columns: 1fr;
      margin-top: 16px;
    }

    .card {
      display: flex;
      min-height: 0;
      margin-bottom: 14px;
      padding: 14px 14px 38px;
    }

    .media img {
      max-height: min(52svh, 360px);
      object-position: center;
    }
  }
</style>
