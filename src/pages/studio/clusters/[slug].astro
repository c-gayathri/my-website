---
// One cluster: all its projects (and related writing) composed on one
// screen — asymmetric grid, heterogeneous cards, generous whitespace.
import { getCollection } from 'astro:content';
import StudioLayout from '../../../layouts/StudioLayout.astro';

export async function getStaticPaths() {
  const clusters = await getCollection('clusters');
  return clusters.map((cluster) => ({ params: { slug: cluster.id }, props: { cluster } }));
}

const { cluster } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
const all = await getCollection('projects');
const projects = all
  .filter((p) => p.data.clusters.includes(cluster.id))
  .sort((a, b) => (b.data.clusterPreview?.featured ? 1 : 0) - (a.data.clusterPreview?.featured ? 1 : 0));

const allWriting = await getCollection('writing');
const relatedWriting = allWriting
  .filter((w) =>
    w.data.relatedProjects.some((rid) => projects.some((p) => p.id === rid)),
  )
  .slice(0, 2);

/* deterministic placements cycling through the grid */
const PLACEMENTS = [
  '1 / span 5',
  '6 / span 4',
  '10 / span 3',
  '6 / span 3',
  '9 / span 4',
  '1 / span 4',
  '10 / span 3',
  '1 / span 5',
];

type Card =
  | { kind: 'project'; project: (typeof projects)[number] }
  | { kind: 'writing'; entry: (typeof relatedWriting)[number] };

const cards: Card[] = [
  ...projects.map((project) => ({ kind: 'project' as const, project })),
  ...relatedWriting.map((entry) => ({ kind: 'writing' as const, entry })),
];
---

<StudioLayout title={`${cluster.data.title} — Studio`}>
  <article class="cluster-page">
    <nav class="crumbs s-meta" aria-label="Breadcrumb">
      <a href={`${base}/studio/`}>← back to constellation</a>
    </nav>

    <header>
      <h1>{cluster.data.title}</h1>
      {cluster.data.subtitle && <p class="s-meta sub">{cluster.data.subtitle}</p>}
      <p class="s-meta meta">
        {projects.length} projects{relatedWriting.length ? ` · ${relatedWriting.length} writings` : ''}
      </p>
      <p class="desc">{cluster.data.description}</p>
    </header>

    <div class="cards">
      {
        cards.map((card, i) => {
          const place = PLACEMENTS[i % PLACEMENTS.length];
          if (card.kind === 'writing') {
            const w = card.entry;
            return (
              <a class="card writing" style={`grid-column: ${place}`} href={`${base}/studio/writing/${w.id}/`}>
                <span class="num s-meta">{String(i + 1).padStart(2, '0')}.</span>
                <h2>{w.data.title ?? w.id.replace(/-/g, ' ')}</h2>
                <span class="s-meta type">{w.data.type}</span>
                {w.data.excerpt && <p class="s-meta excerpt">{w.data.excerpt}</p>}
                <span class="go s-meta" aria-hidden="true">→</span>
              </a>
            );
          }
          const p = card.project;
          const d = p.data;
          const href = `${base}/studio/projects/${p.id}/`;
          const img = d.thumbnail ?? d.hero ?? d.videoPoster ?? d.gallery[0];
          return (
            <a class:list={['card', `type-${d.previewType}`]} style={`grid-column: ${place}`} href={href}>
              <span class="num s-meta">{String(i + 1).padStart(2, '0')}.</span>
              <h2>{d.title}</h2>
              <span class="s-meta type">{[d.medium[0], d.year].filter(Boolean).join(' · ')}</span>
              {d.previewType === 'text' ? (
                <p class="s-meta excerpt">“{d.textExcerpt ?? d.summary}”</p>
              ) : img ? (
                <span class="media">
                  <img
                    src={img.src}
                    alt={d.title}
                    width={img.width}
                    height={img.height}
                    loading={i < 3 ? 'eager' : 'lazy'}
                  />
                  {d.previewType === 'video' && <span class="play" aria-hidden="true">▶</span>}
                  {d.previewType === 'gallery' && d.gallery.length > 0 && (
                    <span class="s-meta plus">+ {d.gallery.length}</span>
                  )}
                  {d.previewType === 'media-text' && d.summary && (
                    <span class="s-meta side">{d.summary}</span>
                  )}
                </span>
              ) : null}
              <span class="go s-meta" aria-hidden="true">→</span>
            </a>
          );
        })
      }
    </div>
  </article>
</StudioLayout>

<style>
  .cluster-page {
    min-height: calc(100dvh - 130px);
    display: flex;
    flex-direction: column;
  }

  .crumbs a {
    color: var(--s-grey);
    text-decoration: none;
  }

  .crumbs a:hover {
    text-decoration: underline;
  }

  header h1 {
    font-family: var(--s-serif);
    font-weight: 500;
    font-size: clamp(44px, 5.4vw, 76px);
    line-height: 0.98;
    letter-spacing: 0.01em;
    margin: 26px 0 0;
  }

  .sub {
    margin: 10px 0 0;
  }

  .meta {
    margin: 6px 0 0;
  }

  .desc {
    font-family: var(--s-mono);
    font-size: 12.5px;
    line-height: 1.75;
    color: var(--s-grey);
    max-width: 52ch;
    margin: 14px 0 0;
  }

  /* one-screen asymmetric arrangement */
  .cards {
    flex: 1;
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    grid-auto-rows: minmax(200px, auto);
    gap: 22px;
    margin-top: 44px;
    align-content: start;
  }

  .card {
    position: relative;
    border: 1px solid var(--s-line);
    padding: 16px 16px 40px;
    text-decoration: none;
    color: inherit;
    display: flex;
    flex-direction: column;
    min-width: 0;
    transition: border-color 0.25s ease;
  }

  .card:hover {
    border-color: var(--s-grey);
  }

  .card h2 {
    font-family: var(--s-serif);
    font-weight: 500;
    font-size: 24px;
    line-height: 1.1;
    margin: 8px 0 0;
  }

  .card .type {
    margin-top: 5px;
    text-transform: uppercase;
    font-size: 10.5px;
  }

  .card .excerpt {
    margin: 12px 0 0;
    line-height: 1.7;
  }

  .card .go {
    position: absolute;
    right: 16px;
    bottom: 12px;
    color: var(--s-ink);
  }

  .media {
    position: relative;
    display: block;
    margin-top: 14px;
  }

  .media img {
    width: 100%;
    height: auto;
    max-height: 340px;
    object-fit: cover;
    display: block;
  }

  .play {
    position: absolute;
    inset: 0;
    margin: auto;
    width: 42px;
    height: 42px;
    display: grid;
    place-items: center;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.85);
    color: #111;
    font-size: 13px;
  }

  .plus {
    position: absolute;
    right: 8px;
    bottom: 8px;
    background: var(--s-bg);
    border: 1px solid var(--s-line);
    padding: 2px 7px;
  }

  .side {
    display: block;
    margin-top: 10px;
    line-height: 1.6;
  }

  /* writing cards read quieter */
  .card.writing {
    background: transparent;
  }

  @media (max-width: 900px) {
    .cluster-page {
      min-height: 0;
    }

    .cards {
      grid-template-columns: 1fr;
      grid-auto-rows: auto;
    }

    .card {
      grid-column: 1 / -1 !important;
    }
  }
</style>
