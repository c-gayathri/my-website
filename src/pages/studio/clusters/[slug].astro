---
import { getCollection } from 'astro:content';
import StudioLayout from '../../../layouts/StudioLayout.astro';

export async function getStaticPaths() {
  const clusters = await getCollection('clusters');
  return clusters.map((cluster) => ({ params: { slug: cluster.id }, props: { cluster } }));
}

const { cluster } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
const all = await getCollection('projects');
const projects = all
  .filter((p) => p.data.clusters.includes(cluster.id))
  .sort((a, b) => (b.data.clusterPreview?.featured ? 1 : 0) - (a.data.clusterPreview?.featured ? 1 : 0));

const projectMedia = (project: (typeof projects)[number]) => {
  const d = project.data;
  return d.thumbnail ?? d.hero ?? d.videoPoster ?? d.gallery[0];
};

const dominantProject =
  projects.find((project) => project.data.clusterPreview?.featured) ??
  projects.find((project) => project.data.size === 'large' && projectMedia(project)) ??
  projects.find(projectMedia) ??
  projects[0];

const allWriting = await getCollection('writing');
const relatedWriting = allWriting
  .filter((w) =>
    w.data.relatedProjects.some((rid) => projects.some((p) => p.id === rid)),
  )
  .slice(0, 2);

type Card =
  | { kind: 'project'; project: (typeof projects)[number] }
  | { kind: 'writing'; entry: (typeof relatedWriting)[number] };

const cards: Card[] = [
  ...projects
    .slice()
    .sort((a, b) => Number(b.id === dominantProject?.id) - Number(a.id === dominantProject?.id))
    .map((project) => ({ kind: 'project' as const, project })),
  ...relatedWriting.map((entry) => ({ kind: 'writing' as const, entry })),
];
---

<StudioLayout title={`${cluster.data.title} — Studio`}>
  <article class="cluster-page">
    <nav class="crumbs s-meta" aria-label="Breadcrumb">
      <a href={`${base}/studio/`}>← back to constellation</a>
    </nav>

    <header class="cluster-header">
      <div class="heading">
        <h1>{cluster.data.title}</h1>
        {cluster.data.subtitle && <p class="s-meta sub">{cluster.data.subtitle}</p>}
      </div>
      <div class="intro">
        <p class="s-meta meta">
          {projects.length} {projects.length === 1 ? 'project' : 'projects'}{relatedWriting.length ? ` · ${relatedWriting.length} writings` : ''}
        </p>
        <p class="desc">{cluster.data.description}</p>
      </div>
    </header>

    <div class="cards">
      {
        cards.map((card, i) => {
          if (card.kind === 'writing') {
            const w = card.entry;
            return (
              <a class="card writing" href={`${base}/studio/writing/${w.id}/`}>
                <span class="num s-meta">{String(i + 1).padStart(2, '0')}.</span>
                <h2>{w.data.title ?? w.id.replace(/-/g, ' ')}</h2>
                <span class="s-meta type">{w.data.type}</span>
                {w.data.excerpt && <p class="s-meta excerpt">{w.data.excerpt}</p>}
                <span class="go s-meta" aria-hidden="true">→</span>
              </a>
            );
          }
          const p = card.project;
          const d = p.data;
          const href = `${base}/studio/projects/${p.id}/`;
          const img = projectMedia(p);
          return (
            <a class:list={['card', `type-${d.previewType}`, { dominant: p.id === dominantProject?.id }]} href={href}>
              <span class="num s-meta">{String(i + 1).padStart(2, '0')}.</span>
              <h2>{d.title}</h2>
              <span class="s-meta type">{[d.medium[0], d.year].filter(Boolean).join(' · ')}</span>
              {d.previewType === 'text' ? (
                <p class="s-meta excerpt">“{d.textExcerpt ?? d.summary}”</p>
              ) : img ? (
                <span class="media">
                  <img
                    src={img.src}
                    alt={d.title}
                    width={img.width}
                    height={img.height}
                    loading={i < 3 ? 'eager' : 'lazy'}
                  />
                  {d.previewType === 'video' && <span class="play" aria-hidden="true">▶</span>}
                  {d.previewType === 'gallery' && d.gallery.length > 0 && (
                    <span class="s-meta plus">+ {d.gallery.length}</span>
                  )}
                  {d.previewType === 'media-text' && d.summary && (
                    <span class="s-meta side">{d.summary}</span>
                  )}
                </span>
              ) : null}
              <span class="go s-meta" aria-hidden="true">→</span>
            </a>
          );
        })
      }
    </div>
  </article>
</StudioLayout>

<style>
  .cluster-page {
    min-height: calc(100dvh - 130px);
  }

  .crumbs a {
    color: var(--s-grey);
    text-decoration: none;
  }

  .crumbs a:hover {
    text-decoration: underline;
  }

  .cluster-header {
    position: relative;
    display: grid;
    grid-template-columns: minmax(260px, 0.85fr) minmax(280px, 1fr);
    gap: clamp(24px, 4vw, 72px);
    align-items: end;
    margin-top: 18px;
    padding-bottom: 18px;
    border-bottom: 1px solid var(--s-line);
  }

  .cluster-header h1 {
    font-family: var(--s-serif);
    font-weight: 500;
    font-size: clamp(34px, 3.7vw, 56px);
    line-height: 0.96;
    letter-spacing: 0.01em;
    margin: 0;
  }

  .sub {
    margin: 8px 0 0;
  }

  .meta {
    margin: 0;
  }

  .desc {
    font-family: var(--s-mono);
    font-size: 12.5px;
    line-height: 1.75;
    color: var(--s-grey);
    max-width: 52ch;
    margin: 8px 0 0;
  }

  /* Columns provide compact masonry without measuring or overlapping cards. */
  .cards {
    columns: 3 260px;
    column-gap: 20px;
    margin-top: 20px;
  }

  .card {
    position: relative;
    border: 1px solid var(--s-line);
    padding: 16px 16px 40px;
    text-decoration: none;
    color: inherit;
    display: flex;
    flex-direction: column;
    min-width: 0;
    width: 100%;
    margin: 0 0 20px;
    break-inside: avoid;
    overflow: hidden;
    transition: border-color 0.25s ease;
  }

  .card.dominant {
    column-span: all;
    display: grid;
    grid-template-columns: minmax(220px, 0.72fr) minmax(320px, 1.28fr);
    grid-template-rows: auto auto 1fr;
    column-gap: clamp(24px, 4vw, 64px);
    min-height: 300px;
    padding: 20px 20px 42px;
  }

  .card.dominant .num,
  .card.dominant h2,
  .card.dominant > .type,
  .card.dominant > .excerpt {
    grid-column: 1;
  }

  .card.dominant .media {
    grid-column: 2;
    grid-row: 1 / span 3;
    margin-top: 0;
    align-self: center;
  }

  .card:hover {
    border-color: var(--s-grey);
  }

  .card h2 {
    font-family: var(--s-serif);
    font-weight: 500;
    font-size: 24px;
    line-height: 1.1;
    margin: 8px 0 0;
  }

  .card .type {
    margin-top: 5px;
    text-transform: uppercase;
    font-size: 10.5px;
  }

  .card .excerpt {
    margin: 12px 0 0;
    line-height: 1.7;
  }

  .card .go {
    position: absolute;
    right: 16px;
    bottom: 12px;
    color: var(--s-ink);
  }

  .media {
    position: relative;
    display: block;
    margin-top: 14px;
  }

  .media img {
    width: 100%;
    height: auto;
    max-height: 280px;
    object-fit: contain;
    object-position: left center;
    display: block;
  }

  .dominant .media img {
    max-height: 420px;
  }

  .play {
    position: absolute;
    inset: 0;
    margin: auto;
    width: 42px;
    height: 42px;
    display: grid;
    place-items: center;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.85);
    color: #111;
    font-size: 13px;
  }

  .plus {
    position: absolute;
    right: 8px;
    bottom: 8px;
    background: var(--s-bg);
    border: 1px solid var(--s-line);
    padding: 2px 7px;
  }

  .side {
    display: block;
    margin-top: 10px;
    line-height: 1.6;
  }

  /* writing cards read quieter */
  .card.writing {
    background: transparent;
  }

  @media (max-width: 900px) {
    .cluster-header {
      grid-template-columns: minmax(220px, 0.8fr) 1.2fr;
    }

    .cards {
      columns: 2 240px;
    }

    .card.dominant {
      grid-template-columns: minmax(190px, 0.7fr) minmax(260px, 1.3fr);
    }
  }

  @media (max-width: 680px) {
    .cluster-page {
      min-height: 0;
    }

    .cluster-header {
      display: block;
      margin-top: 14px;
      padding-bottom: 14px;
    }

    .intro {
      margin-top: 14px;
    }

    .cards {
      columns: 1;
      margin-top: 16px;
    }

    .card,
    .card.dominant {
      display: flex;
      min-height: 0;
      margin-bottom: 14px;
      padding: 14px 14px 38px;
    }

    .card.dominant .media {
      margin-top: 14px;
      align-self: stretch;
    }

    .media img,
    .dominant .media img {
      max-height: min(52svh, 360px);
      object-position: center;
    }
  }
</style>
