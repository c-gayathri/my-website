---
import { getCollection } from 'astro:content';
import StudioLayout from '../../../layouts/StudioLayout.astro';
import { projectOrder } from '../../../data/projectOrder';
import { summaryParts as parseSummaryParts } from '../../../utils/summaryLinks';

export async function getStaticPaths() {
  const clusters = await getCollection('clusters');
  return clusters.filter((cluster) => cluster.id !== 'photography').map((cluster) => ({ params: { slug: cluster.id }, props: { cluster } }));
}

const { cluster } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
const all = await getCollection('projects');
const order = projectOrder[cluster.id] ?? [];
const projects = all
  .filter((p) => p.data.clusters.includes(cluster.id))
  .sort((a, b) => {
    // Every project named in this cluster's projectOrder is featured. Those
    // projects stay at the top in the exact order authored there. The
    // remaining projects use the catalogue chronology.
    const ia = order.indexOf(a.id);
    const ib = order.indexOf(b.id);
    const fa = ia !== -1 || Boolean(a.data.featured || a.data.clusterPreview?.featured);
    const fb = ib !== -1 || Boolean(b.data.featured || b.data.clusterPreview?.featured);
    if (fa !== fb) return fa ? -1 : 1;
    if (fa && fb) {
      if (ia !== -1 || ib !== -1) {
        if (ia === -1) return 1;
        if (ib === -1) return -1;
        if (ia !== ib) return ia - ib;
      }
    }
    return b.data.year - a.data.year
      || a.data.title.localeCompare(b.data.title)
      || a.id.localeCompare(b.id);
  });

const galleryPreviewImages = (project: (typeof projects)[number]) => {
  const d = project.data;
  const youtubeId = d.youtubeUrls[0]?.match(/(?:youtu\.be\/|[?&]v=|\/shorts\/|\/embed\/)([A-Za-z0-9_-]{11})/)?.[1];
  const youtubePoster = youtubeId ? { src: `https://i.ytimg.com/vi/${youtubeId}/hqdefault.jpg`, width: 480, height: 360 } : undefined;
  const candidates = d.previewType === 'video'
    ? [d.thumbnail ?? d.videoPoster ?? d.hero ?? d.gallery[0] ?? youtubePoster].filter(Boolean) as NonNullable<typeof d.hero>[]
    : [d.hero, ...d.gallery].filter(Boolean) as NonNullable<typeof d.hero>[];
  return candidates.filter((image, index) => candidates.findIndex((other) => other.src === image.src) === index);
};

const galleryPreview = (project: (typeof projects)[number]) => {
  const d = project.data;
  const pool = galleryPreviewImages(project);
  // Use featuredImage first if present
  if (d.featuredImage) {
    const hit = pool.find((img) => String((img as any).src).includes(d.featuredImage!));
    if (hit) return [hit, ...pool.filter((x) => x !== hit)].slice(0, 4);
  }
  return pool.slice(0, 4);
};

const cards = projects;
---

<StudioLayout title={`${cluster.data.title} — Studio`}>
  <article class="cluster-page">
    <aside class="cluster-sidebar">
      <nav class="crumbs s-meta" aria-label="Breadcrumb">
        <a href={`${base}/studio/`}>← constellation</a>
        <a href={`${base}/studio/index/clusters/`}>← all clusters</a>
      </nav>
      <header class="cluster-header">
      <div class="heading">
        <h1>{cluster.data.title}</h1>
        {cluster.data.subtitle && <p class="s-meta sub">{cluster.data.subtitle}</p>}
      </div>
      <p class="desc">{cluster.data.description}</p>
      </header>
    </aside>

    <section class="cards" aria-label={`${cluster.data.title} projects`}>
      {
        cards.map((p, i) => {
          const d = p.data;
          const href = `${base}/studio/projects/${p.id}/`;
          const previews = galleryPreview(p);
          const previewImageCount = galleryPreviewImages(p).length;
          const previewText = parseSummaryParts(d.summary ?? d.textExcerpt ?? '')
            .map((part) => part.text)
            .join('')
            .trim();
          return (
            <article class:list={['card', `type-${d.previewType}`]}>
              <h2>
                <a href={href}>{d.title}</a>
                {(order.includes(p.id) || d.featured || d.clusterPreview?.featured) && <span class="featured-mark" title="Featured project" aria-label="Featured project">★ featured</span>}
              </h2>
              <span class="s-meta type">{[d.medium[0], d.year].filter(Boolean).join(' · ')}</span>
              {d.previewType === 'text' ? (
                <a class="media-link text-tile" href={href} aria-label={`Open ${d.title}`}>
                  <span>“{d.textExcerpt ?? d.summary ?? d.title}”</span>
                </a>
              ) : previews.length ? (
                <span class="media">
                  <a class="media-link" href={href} aria-label={`Open ${d.title}`}>
                  {previews.length === 1 ? (
                    <img
                      src={previews[0].src}
                      alt={d.title}
                      width={previews[0].width}
                      height={previews[0].height}
                      loading={i < 3 ? 'eager' : 'lazy'}
                    />
                  ) : (
                    <span class:list={['mini-grid', `count-${previews.length}`]}>
                      {previews.map((im) => (
                        <img src={im.src} alt={d.title} width={im.width} height={im.height} loading="lazy" />
                      ))}
                    </span>
                  )}
                  {d.previewType === 'video' && <span class="play" aria-hidden="true">▶</span>}
                  {previewImageCount > previews.length && (
                    <span class="s-meta plus">+ {previewImageCount - previews.length}</span>
                  )}
                  </a>
                </span>
              ) : null}
              <div class="card-footer">
                <p class="card-preview" aria-hidden={previewText ? undefined : 'true'}>{previewText}</p>
                <a class="go s-meta" href={href} aria-label={`Open ${d.title}`}>→</a>
              </div>
            </article>
          );
        })
      }
    </section>
  </article>
</StudioLayout>

<style>
  .cluster-page { min-height:calc(100dvh - var(--studio-header-height) - var(--studio-footer-height)); }

  .crumbs a {
    color: var(--s-grey);
    text-decoration: none;
  }

  .crumbs a:hover {
    text-decoration: underline;
  }

  .cluster-sidebar { min-width:0; }
  .cluster-header { margin-top:18px; }

  .cluster-header h1 {
    font-family: var(--s-serif);
    font-weight: 500;
    font-size: clamp(34px, 3.7vw, 56px);
    line-height: 0.96;
    letter-spacing: 0.01em;
    margin: 0;
  }

  .sub {
    margin: 8px 0 0;
  }

  .desc {
    font-family: var(--s-mono);
    font-size: 12.5px;
    line-height: 1.75;
    color: var(--s-grey);
    max-width:36ch;
    margin:18px 0 0;
  }

  .cards {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    column-gap: clamp(28px, 3vw, 52px);
    row-gap: 24px;
    align-items: start;
  }

  .card {
    position: relative;
    border: 0;
    padding:0;
    text-decoration: none;
    color: inherit;
    display: flex;
    flex-direction: column;
    min-width: 0;
    width: 100%;
    height: auto;
    overflow: visible;
    transition: opacity 0.25s ease;
  }

  .card h2 {
    display: flex;
    align-items: baseline;
    gap: 8px;
    font-family: var(--s-serif);
    font-weight: 500;
    font-size: clamp(19px, 1.55vw, 24px);
    line-height: 1.1;
    margin: 8px 0 0;
  }
  .card h2 a { color: inherit; text-decoration: none; }
  .card h2 a:hover { text-decoration: underline; text-underline-offset: 3px; }

  .featured-mark {
    color: var(--s-grey);
    font-family: var(--s-mono);
    font-size: 11px;
    line-height: 1;
    flex: 0 0 auto;
  }

  .card .type {
    margin-top: 5px;
    text-transform: uppercase;
    font-size: 10.5px;
  }

  .card-footer { display:flex; align-items:flex-end; gap:10px; margin-top:9px; }
  .card-preview { display:-webkit-box; flex:1; margin:0; overflow:hidden; color:var(--s-grey); font-family:var(--s-mono); font-size:10px; line-height:1.6; -webkit-box-orient:vertical; -webkit-line-clamp:2; }
  .card .go { flex:0 0 auto; padding-bottom:1px; color: var(--s-ink); text-decoration:none; }
  .card .go:hover { text-decoration:underline; text-underline-offset:3px; }

  .media {
    position: relative;
    display: block;
    margin-top: 14px;
  }

  .media-link { position: relative; display: block; color: inherit; text-decoration: none; }

  .media > .media-link,
  .text-tile {
    aspect-ratio: 1;
    overflow: hidden;
    background: #fff;
  }

  .media img {
    width: 100%;
    max-width: none;
    height: 100%;
    max-height: none;
    object-fit: cover;
    display: block;
    background: #fff;
    box-shadow: 0 3px 30px rgba(20, 18, 10, 0.13);
  }

  .mini-grid {
    width: 100%;
    height: 100%;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    grid-template-rows: repeat(2, 1fr);
    gap: 6px;
  }

  .mini-grid img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .mini-grid.count-2 { grid-template-rows: 1fr; }
  .mini-grid.count-3 img:first-child { grid-row: 1 / -1; }

  .text-tile {
    display: grid;
    place-items: center;
    margin-top: 14px;
    padding: clamp(18px, 2.4vw, 32px);
    box-sizing: border-box;
    border: 1px solid var(--s-line);
  }
  .text-tile span {
    font-family: var(--s-serif);
    font-size: clamp(16px, 1.35vw, 21px);
    line-height: 1.45;
    display: -webkit-box;
    -webkit-line-clamp: 8;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .play {
    position: absolute;
    inset: 0;
    margin: auto;
    width: 42px;
    height: 42px;
    display: grid;
    place-items: center;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.85);
    color: #111;
    font-size: 13px;
  }

  .plus {
    position: absolute;
    right: 8px;
    bottom: 8px;
    background: var(--s-bg);
    border: 1px solid var(--s-line);
    padding: 2px 7px;
  }

  @media (min-width: 901px) {
    .cluster-page { display:grid; grid-template-columns:minmax(180px, .42fr) minmax(0, 2.58fr); column-gap:clamp(30px,3.5vw,60px); height:calc(100dvh - var(--studio-header-height) - var(--studio-footer-height)); overflow:hidden; }
    .cluster-sidebar { padding-top:0; }
    .cards { overflow-y:auto; overscroll-behavior:contain; padding:24px 4px 32px 0; scrollbar-gutter:stable; }
  }

  @media (max-width: 900px) {
    .cards { grid-template-columns: repeat(2, 1fr); column-gap: 28px; }
    .cards { margin-top: 22px; }

  }

  @media (max-width: 680px) {
    .cluster-page { min-height:0; }

    .cluster-header {
      margin-top: 14px;
    }

    .cards {
      grid-template-columns: 1fr;
    }

    .card {
      display: flex;
      min-height: 0;
      margin-bottom:14px;
    }

    .media img {
      max-height: min(52svh, 360px);
      object-position: center;
    }
  }
</style>
