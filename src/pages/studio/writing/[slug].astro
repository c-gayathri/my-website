---
import { getCollection, render } from 'astro:content';
import StudioLayout from '../../../layouts/StudioLayout.astro';
import { studioConfig } from '../../../data/studioConfig';
import { studioBlocks } from '../../../components/studio/blocks';

export async function getStaticPaths() {
  const entries = await getCollection('writing');
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const d = entry.data;
const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
const { Content } = await render(entry);
const allProjects = await getCollection('projects');
const related = allProjects.filter((p) => d.relatedProjects.includes(p.id));

const fmt = (dt: Date) =>
  [String(dt.getDate()).padStart(2, '0'), String(dt.getMonth() + 1).padStart(2, '0'), String(dt.getFullYear()).slice(2)].join(' / ');
---

<StudioLayout title={`${d.title ?? studioConfig.writingLabel} — ${studioConfig.name}`} slim>
  <article class:list={['reading', `layout-${d.pageLayout}`]}>
    <div class="detail-head">
      <div class="head-copy">
        <nav class="crumbs" aria-label="Breadcrumb">
          <a class="s-link" href={`${base}/studio/writing/`}>← all writing</a>
        </nav>
        <header>
          <div class="entry-meta">
            {d.preview?.showDate !== false && <span class="s-meta">{fmt(d.date)}</span>}
            {d.preview?.showType !== false && <span class="s-meta">{d.type}</span>}
          </div>
          {d.title && <h1>{d.title}</h1>}
        </header>
      </div>
    </div>

    {d.image && <img class="lead" src={d.image.src} alt={d.title ?? ''} width={d.image.width} height={d.image.height} loading="eager" />}

    <div class="prose">
      <Content components={studioBlocks} />
    </div>

    {
      related.length > 0 && (
        <aside class="related">
          <span class="s-meta">related projects</span>
          {related.map((p) => (
            <a class="s-link" href={`${base}/studio/projects/${p.id}/`}>
              {p.data.title}
            </a>
          ))}
        </aside>
      )
    }
  </article>
</StudioLayout>

<style>
  .reading {
    max-width: 760px;
    margin: 0 auto;
  }

  .detail-head {
    display: block;
    padding-bottom: 18px;
    border-bottom: 1px solid var(--s-line);
  }

  .head-copy {
    align-self: start;
  }

  .crumbs {
    margin: 2px 0 18px;
  }

  .crumbs a {
    color: var(--s-grey);
  }

  .entry-meta {
    display: flex;
    gap: 18px;
    align-items: baseline;
  }

  h1 {
    font-family: var(--s-serif);
    font-weight: 500;
    max-width: 14ch;
    margin: 6px 0 0;
    font-size: clamp(34px, 4.2vw, 49px);
    line-height: 1;
  }

  .lead {
    width: 100%;
    height: auto;
    margin-top: 28px;
  }

  .prose {
    margin-top: 30px;
  }

  /* essay: readable serif column */
  .layout-essay .prose {
    font-family: var(--s-serif);
    font-size: 19.5px;
    line-height: 1.75;
  }

  .layout-essay .prose p {
    margin: 0 0 1.2em;
  }

  /* poem: mono, narrow, more air */
  .layout-poem {
    max-width: 560px;
  }

  .layout-poem .prose {
    font-family: var(--s-mono);
    font-size: 13.5px;
    line-height: 2;
    color: var(--s-ink);
    padding-top: 26px;
  }

  .layout-poem .prose p {
    margin: 0 0 1.6em;
  }

  /* fragment: very sparse */
  .layout-fragment {
    max-width: 560px;
  }

  .layout-fragment .prose {
    font-family: var(--s-mono);
    font-size: 14px;
    line-height: 2.1;
    padding-top: 40px;
  }

  .prose em {
    font-style: italic;
  }

  .related {
    margin-top: 56px;
    display: flex;
    flex-direction: column;
    gap: 6px;
    align-items: flex-start;
  }

  @media (max-width: 760px) {
    .reading {
      max-width: 680px;
    }

    .detail-head {
      display: block;
      min-height: 0;
      padding-bottom: 16px;
    }

    h1 {
      font-size: clamp(32px, 10vw, 43px);
    }

    .lead,
    .prose {
      margin-top: 24px;
    }

    .layout-essay .prose {
      font-size: 18px;
      line-height: 1.68;
    }

    .layout-poem .prose,
    .layout-fragment .prose {
      padding-top: 10px;
    }
  }
</style>
