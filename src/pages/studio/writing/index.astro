---
// Writing pad index.
// Desktop: a spatial, scattered composition — deterministic placements from
// preview.desktop overrides, else seeded defaults (layoutSeed shuffles them).
// Mobile: the ordered stack.
import { getCollection } from 'astro:content';
import StudioLayout from '../../../layouts/StudioLayout.astro';
import { studioConfig } from '../../../data/studioConfig';

const entries = (await getCollection('writing')).sort((a, b) => {
  const fa = a.data.preview?.featured ? 1 : 0;
  const fb = b.data.preview?.featured ? 1 : 0;
  if (fa !== fb) return fb - fa;
  return b.data.date.valueOf() - a.data.date.valueOf();
});
const base = import.meta.env.BASE_URL.replace(/\/+$/, '');

const fmt = (d: Date) =>
  [String(d.getDate()).padStart(2, '0'), String(d.getMonth() + 1).padStart(2, '0'), String(d.getFullYear()).slice(2)].join(' / ');

/* deterministic seeded placement (same composition every build) */
function mulberry32(seed: number) {
  let a = seed >>> 0;
  return () => {
    a |= 0;
    a = (a + 0x6d2b79f5) | 0;
    let t = Math.imul(a ^ (a >>> 15), 1 | a);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}

const rand = mulberry32(studioConfig.layoutSeed * 2654435761);
const COLUMN_X = [3, 36, 66];

const placed = entries.map((e, i) => {
  const manual = e.data.preview?.desktop;
  const isBig = e.data.type === 'essay' || e.data.gallery.length > 0;
  const width = manual?.width ?? (isBig ? 30 : 23);
  /* rows of ~three entries share a height band, slightly staggered */
  const row = Math.floor(i / 3);
  const x = manual?.x ?? clamp(COLUMN_X[i % 3] + (rand() - 0.5) * 7, 1, 74);
  const y = manual?.y ?? clamp(row * 26 + (rand() - 0.5) * 5 + (i % 3) * 2, 0, 92);
  return { e, x, y, width };
});

function clamp(v: number, lo: number, hi: number) {
  return Math.min(hi, Math.max(lo, v));
}

const canvasH = Math.max(Math.ceil(placed.length / 3) * 430 + 320, 900);

/* decorative field — fixed-pixel sparkles positioned by percentage, so
   shapes never stretch. Sprinkled star clusters + stardust. */
const markRand = mulberry32(studioConfig.layoutSeed + 11);
const sparklePath = (s: number) => {
  const v = s;
  const h = s * 0.55;
  const k = s * 0.1;
  return `M10,${10 - v} Q${10 + k},${10 - k} ${10 + h},10 Q${10 + k},${10 + k} 10,${10 + v} Q${10 - k},${10 + k} ${10 - h},10 Q${10 - k},${10 - k} 10,${10 - v} Z`;
};

type DecoMark = {
  x: number;
  y: number;
  w: number;
  h: number;
  svg: string;
};

const deco: DecoMark[] = [];
for (let i = 0; i < 9; i++) {
  const s = 9 + markRand() * 13;
  deco.push({
    x: 2 + markRand() * 94,
    y: 2 + markRand() * 92,
    w: s * 2,
    h: s * 2,
    svg: `<path d="${sparklePath(s)}" fill="var(--s-ink)" opacity="0.75"/>`,
  });
}
for (let g = 0; g < 5; g++) {
  /* small random star clusters joined by dashed segments */
  const gx = 4 + markRand() * 86;
  const gy = 6 + markRand() * 82;
  const n = 2 + Math.floor(markRand() * 3);
  const pts: Array<[number, number, number]> = [];
  for (let k = 0; k <= n; k++) {
    pts.push([
      (markRand() - 0.5) * 90,
      (markRand() - 0.5) * 64,
      3 + markRand() * 5.5,
    ]);
  }
  const w = 150;
  const h = 110;
  let svg = '';
  for (let k = 1; k < pts.length; k++) {
    svg += `<line x1="${pts[k - 1][0] + 10}" y1="${pts[k - 1][1] + 10}" x2="${pts[k][0] + 10}" y2="${pts[k][1] + 10}" stroke="var(--s-ink)" stroke-opacity="0.4" stroke-dasharray="1 3" stroke-width="0.8"/>`;
  }
  for (const [dx, dy, s] of pts) {
    svg += `<path d="${sparklePath(s)}" transform="translate(${dx} ${dy})" fill="var(--s-ink)" opacity="0.8"/>`;
  }
  deco.push({ x: gx, y: gy, w, h, svg });
}
for (let i = 0; i < 24; i++) {
  const r = 1.2 + markRand() * 1.6;
  deco.push({
    x: 2 + markRand() * 95,
    y: 2 + markRand() * 94,
    w: r * 2,
    h: r * 2,
    svg: `<circle cx="${r}" cy="${r}" r="${r}" fill="var(--s-ink)" opacity="${0.2 + markRand() * 0.4}"/>`,
  });
}
---

<StudioLayout title={studioConfig.writingLabel + ' — ' + studioConfig.name} section={studioConfig.writingLabel}>
  <p class="s-meta" style="margin-top: 26px">{entries.length} entries</p>

  <div class="canvas" style={`--canvas-h: ${canvasH}px`}>
    {
      deco.map((m, i) => (
        <svg
          class="deco-mark"
          style={`left: ${m.x}%; top: ${m.y}%;`}
          width={m.w}
          height={m.h}
          viewBox="0 0 20 20"
          aria-hidden="true"
          set:html={m.svg}
        />
      ))
    }

    {
      placed.map(({ e, x, y, width }) => {
        const img = e.data.image ?? e.data.gallery[0];
        const isImageText = Boolean(img) || e.data.preview?.variant === 'image-text';
        return (
          <a
            class="entry"
            href={`${base}/studio/writing/${e.id}/`}
            style={`--x: ${x}%; --y: ${y}%; --w: ${width}%`}
          >
            {e.data.preview?.showDate !== false && (
              <span class="s-meta date">{fmt(e.data.date)}</span>
            )}
            {e.data.preview?.showType !== false && <span class="s-meta type">{e.data.type}</span>}
            {img && (
              <img
                class="thumb"
                src={img.src}
                alt={e.data.title ?? ''}
                width={img.width}
                height={img.height}
                loading="lazy"
              />
            )}
            {e.data.title && <h2>{e.data.title}</h2>}
            {e.data.excerpt && <p class="excerpt">{e.data.excerpt}</p>}
            <span class="go" aria-hidden="true">↗</span>
          </a>
        );
      })
    }
  </div>
</StudioLayout>

<style>
  .writing-head {
    display: flex;
    align-items: baseline;
    gap: 26px;
  }

  .writing-head p {
    margin: 40px 0 0;
  }

  /* desktop: spatial canvas */
  @media (min-width: 900px) {
    .canvas {
      position: relative;
      height: var(--canvas-h);
    }

    .deco-mark {
      position: absolute;
      overflow: visible;
      pointer-events: none;
    }

    .entry {
      position: absolute;
      left: var(--x);
      top: var(--y);
      width: var(--w);
    }
  }

  /* mobile: ordered stack */
  .entry {
    position: relative;
    display: block;
    text-decoration: none;
    color: inherit;
    margin: 0 0 56px;
    max-width: 560px;
    background: var(--s-bg);
    padding: 6px 10px 10px;
    margin-left: -10px;
  }

  @media (min-width: 900px) {
    .entry {
      margin-left: 0;
      padding-left: 0;
    }
  }

  .date,
  .type {
    display: inline-block;
    margin-right: 18px;
  }

  .thumb {
    width: 100%;
    max-width: 300px;
    height: auto;
    display: block;
    margin: 12px 0 4px;
  }

  h2 {
    font-family: var(--s-serif);
    font-weight: 500;
    font-size: clamp(26px, 3vw, 36px);
    line-height: 1.12;
    margin: 8px 0 0;
  }

  .excerpt {
    font-family: var(--s-mono);
    font-size: 12.5px;
    line-height: 1.7;
    color: var(--s-grey);
    margin: 10px 0 0;
    max-width: 44ch;
  }

  .go {
    position: absolute;
    right: 10px;
    bottom: 8px;
    font-size: 20px;
    color: var(--s-ink);
  }

  @media (min-width: 900px) {
    .entry {
      position: absolute;
      left: var(--x);
      top: var(--y);
      width: var(--w);
    }
  }

  .entry:hover h2 {
    text-decoration: underline;
    text-underline-offset: 4px;
    text-decoration-thickness: 1px;
  }
</style>
