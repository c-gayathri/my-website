---
import { getCollection } from 'astro:content';
import { studioConfig } from '../../../data/studioConfig';
import StudioLayout from '../../../layouts/StudioLayout.astro';

const entries = (await getCollection('writing')).sort((a, b) => {
  const featuredA = a.data.preview?.featured ? 1 : 0;
  const featuredB = b.data.preview?.featured ? 1 : 0;
  if (featuredA !== featuredB) return featuredB - featuredA;
  return b.data.date.valueOf() - a.data.date.valueOf();
});
const base = import.meta.env.BASE_URL.replace(/\/+$/, '');

const formatDate = (date: Date) =>
  [
    String(date.getDate()).padStart(2, '0'),
    String(date.getMonth() + 1).padStart(2, '0'),
    String(date.getFullYear()).slice(2),
  ].join(' / ');

---

<StudioLayout title={`${studioConfig.writingLabel} — ${studioConfig.name}`} section={studioConfig.writingLabel}>
  <header class="pad-intro">
    <h1>{studioConfig.writingLabel}</h1>
    <p class="s-meta">{entries.length} entries</p>
  </header>

  <div class="canvas">
    {
      entries.map((entry) => {
        const image = entry.data.image ?? entry.data.gallery[0];
        const variant = entry.data.preview?.variant ?? 'title-excerpt';
        return (
          <a
            class:list={['entry', `entry-${variant}`, { featured: entry.data.preview?.featured }]}
            href={`${base}/studio/writing/${entry.id}/`}
          >
            <span class="entry-meta">
              {entry.data.preview?.showDate !== false && (
                <span class="s-meta">{formatDate(entry.data.date)}</span>
              )}
              {entry.data.preview?.showType !== false && <span class="s-meta">{entry.data.type}</span>}
            </span>
            {image && (
              <img
                class="thumb"
                src={image.src}
                alt=""
                width={image.width}
                height={image.height}
                loading="lazy"
              />
            )}
            {entry.data.title && <h2>{entry.data.title}</h2>}
            {entry.data.excerpt && variant !== 'minimal' && <p class="excerpt">{entry.data.excerpt}</p>}
            <span class="read-mark" aria-hidden="true">↗</span>
          </a>
        );
      })
    }
  </div>
</StudioLayout>

<style>
  .pad-intro {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 24px;
    margin: 0 0 18px;
    padding-bottom: 14px;
  }

  .pad-intro p {
    margin: 0;
  }

  .pad-intro h1 { margin:0; font-family:var(--s-serif); font-size:var(--studio-page-title-size); font-weight:500; line-height:1; }

  .canvas {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(28px, 4vw, 64px) clamp(20px, 3vw, 48px);
  }

  .entry {
    position: relative;
    display: flex;
    flex-direction: column;
    width: 100%;
    min-height: 230px;
    color: inherit;
    text-decoration: none;
    padding: 0 34px 24px 0;
    margin: 0;
    border-bottom: 1px solid var(--s-line);
  }

  .entry-meta {
    display: flex;
    gap: 18px;
    align-items: baseline;
  }

  .thumb {
    display: block;
    width: 100%;
    height: 150px;
    object-fit: cover;
    margin: 12px 0 5px;
  }

  h2 {
    max-width: 15ch;
    margin: 7px 0 0;
    font-family: var(--s-serif);
    font-size: clamp(27px, 3vw, 37px);
    font-weight: 500;
    line-height: 1.05;
  }

  .excerpt {
    max-width: 43ch;
    margin: 9px 0 0;
    color: var(--s-grey);
    font-family: var(--s-mono);
    font-size: 11.5px;
    line-height: 1.65;
  }

  .entry-fragment .excerpt {
    max-width: 30ch;
    font-family: var(--s-serif);
    font-size: 16px;
    line-height: 1.45;
  }

  .read-mark {
    position: absolute;
    right: 2px;
    bottom: 22px;
    font-family: var(--s-mono);
    font-size: 21px;
    font-weight: 400;
  }

  .entry:hover h2 {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
  }

  @media (max-width: 960px) { .canvas { grid-template-columns:repeat(2,minmax(0,1fr)); } }
  @media (max-width: 620px) { .pad-intro { align-items:end; } .canvas { grid-template-columns:1fr; } .entry { min-height:0; } }
</style>
