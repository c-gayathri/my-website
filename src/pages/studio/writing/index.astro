---
import { getCollection } from 'astro:content';
import ConstellationFragment from '../../../components/studio/ConstellationFragment.astro';
import { studioConfig } from '../../../data/studioConfig';
import StudioLayout from '../../../layouts/StudioLayout.astro';

const entries = (await getCollection('writing')).sort((a, b) => {
  const featuredA = a.data.preview?.featured ? 1 : 0;
  const featuredB = b.data.preview?.featured ? 1 : 0;
  if (featuredA !== featuredB) return featuredB - featuredA;
  return b.data.date.valueOf() - a.data.date.valueOf();
});
const base = import.meta.env.BASE_URL.replace(/\/+$/, '');

const formatDate = (date: Date) =>
  [
    String(date.getDate()).padStart(2, '0'),
    String(date.getMonth() + 1).padStart(2, '0'),
    String(date.getFullYear()).slice(2),
  ].join(' / ');

function mulberry32(seed: number) {
  let value = seed >>> 0;
  return () => {
    value |= 0;
    value = (value + 0x6d2b79f5) | 0;
    let result = Math.imul(value ^ (value >>> 15), 1 | value);
    result = (result + Math.imul(result ^ (result >>> 7), 61 | result)) ^ result;
    return ((result ^ (result >>> 14)) >>> 0) / 4294967296;
  };
}

const clamp = (value: number, low: number, high: number) =>
  Math.min(high, Math.max(low, value));
const random = mulberry32(studioConfig.layoutSeed * 2654435761);
const columns = [2, 36, 68];
const placed = entries.map((entry, index) => {
  const manual = entry.data.preview?.desktop;
  const substantial = entry.data.type === 'essay' || entry.data.gallery.length > 0;
  const row = Math.floor(index / 3);

  return {
    entry,
    x: manual?.x ?? clamp(columns[index % 3] + (random() - 0.5) * 6, 1, 76),
    y: manual?.y ?? clamp(row * 27 + (random() - 0.5) * 4 + (index % 3) * 2, 0, 90),
    width: manual?.width ?? (substantial ? 29 : 23),
    mobileOrder: entry.data.preview?.mobile?.order ?? index,
  };
});
const canvasHeight = Math.max(Math.ceil(placed.length / 3) * 420 + 260, 860);
---

<StudioLayout title={`${studioConfig.writingLabel} — ${studioConfig.name}`} section={studioConfig.writingLabel}>
  <header class="pad-intro">
    <p class="s-meta">{entries.length} entries / poems, essays, fragments</p>
    <p class="intro-note">Loose pages, kept in the order they arrived.</p>
  </header>

  <div class="canvas" style={`--canvas-height: ${canvasHeight}px`}>
    <ConstellationFragment
      class="index-fragment fragment-one"
      seed={`writing-pad:${studioConfig.layoutSeed}:one`}
      variant="big-plus-one"
    />
    <ConstellationFragment
      class="index-fragment fragment-two"
      seed={`writing-pad:${studioConfig.layoutSeed}:two`}
      variant="big"
    />
    <ConstellationFragment
      class="index-fragment fragment-three"
      seed={`writing-pad:${studioConfig.layoutSeed}:three`}
      variant="big-plus-two"
    />

    {
      placed.map(({ entry, x, y, width, mobileOrder }) => {
        const image = entry.data.image ?? entry.data.gallery[0];
        const variant = entry.data.preview?.variant ?? 'title-excerpt';
        return (
          <a
            class:list={['entry', `entry-${variant}`, { featured: entry.data.preview?.featured }]}
            href={`${base}/studio/writing/${entry.id}/`}
            style={`--x: ${x}%; --y: ${y}%; --entry-width: ${width}%; --mobile-order: ${mobileOrder}`}
          >
            <span class="entry-meta">
              {entry.data.preview?.showDate !== false && (
                <span class="s-meta">{formatDate(entry.data.date)}</span>
              )}
              {entry.data.preview?.showType !== false && <span class="s-meta">{entry.data.type}</span>}
            </span>
            {image && (
              <img
                class="thumb"
                src={image.src}
                alt=""
                width={image.width}
                height={image.height}
                loading="lazy"
              />
            )}
            {entry.data.title && <h2>{entry.data.title}</h2>}
            {entry.data.excerpt && variant !== 'minimal' && <p class="excerpt">{entry.data.excerpt}</p>}
            <span class="read-mark" aria-hidden="true">↗</span>
          </a>
        );
      })
    }
  </div>
</StudioLayout>

<style>
  .pad-intro {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 24px;
    margin-top: 18px;
    padding-bottom: 10px;
    border-bottom: 1px solid var(--s-line);
  }

  .pad-intro p {
    margin: 0;
  }

  .intro-note {
    font-family: var(--s-serif);
    font-size: 17px;
  }

  .canvas {
    display: flex;
    flex-direction: column;
    margin-top: 22px;
  }

  :global(.index-fragment) {
    display: none;
  }

  .entry {
    position: relative;
    order: var(--mobile-order);
    display: block;
    width: 100%;
    color: inherit;
    text-decoration: none;
    padding: 0 34px 28px 0;
    margin-bottom: 28px;
    border-bottom: 1px solid var(--s-line);
  }

  .entry-meta {
    display: flex;
    gap: 18px;
    align-items: baseline;
  }

  .thumb {
    display: block;
    width: min(100%, 300px);
    height: auto;
    margin: 12px 0 5px;
  }

  h2 {
    max-width: 15ch;
    margin: 7px 0 0;
    font-family: var(--s-serif);
    font-size: clamp(27px, 3vw, 37px);
    font-weight: 500;
    line-height: 1.05;
  }

  .excerpt {
    max-width: 43ch;
    margin: 9px 0 0;
    color: var(--s-grey);
    font-family: var(--s-mono);
    font-size: 11.5px;
    line-height: 1.65;
  }

  .entry-fragment .excerpt {
    max-width: 30ch;
    font-family: var(--s-serif);
    font-size: 16px;
    line-height: 1.45;
  }

  .read-mark {
    position: absolute;
    right: 2px;
    bottom: 27px;
    font-family: var(--s-mono);
    font-size: 14px;
  }

  .entry:hover h2 {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
  }

  @media (min-width: 900px) {
    .canvas {
      position: relative;
      display: block;
      height: var(--canvas-height);
      margin-top: 0;
    }

    .entry {
      position: absolute;
      z-index: 2;
      left: var(--x);
      top: var(--y);
      width: var(--entry-width);
      min-width: 210px;
      max-width: 430px;
      margin: 0;
      padding: 5px 22px 10px 0;
      border: 0;
      background: var(--s-bg);
    }

    .entry.featured h2 {
      font-size: clamp(32px, 3.2vw, 43px);
    }

    .read-mark {
      right: 0;
      bottom: 8px;
    }

    :global(.index-fragment) {
      position: absolute;
      z-index: 1;
      display: block;
      color: var(--s-ink);
      pointer-events: none;
    }

    :global(.fragment-one) {
      top: 16%;
      left: 25%;
      width: 150px;
      height: 150px;
    }

    :global(.fragment-two) {
      top: 48%;
      right: 4%;
      width: 118px;
      height: 118px;
    }

    :global(.fragment-three) {
      bottom: 5%;
      left: 43%;
      width: 168px;
      height: 168px;
    }
  }

  @media (max-width: 899px) {
    .pad-intro {
      display: block;
    }

    .intro-note {
      margin-top: 7px !important;
    }
  }
</style>
