---
import { getCollection } from 'astro:content';
import { getImage } from 'astro:assets';
import StudioLayout from '../../../layouts/StudioLayout.astro';
import { studioConfig } from '../../../data/studioConfig';
import { photographyOrder, sortPhotographyProjects } from '../../../data/photographyOrder';

const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
const projects = sortPhotographyProjects(
  (await getCollection('projects')).filter((project) => project.data.clusters.includes('photography')),
);
const items = await Promise.all(projects.map(async (project) => {
  const firstPhoto = project.data.gallery[0] ?? project.data.hero ?? project.data.thumbnail;
  const image = firstPhoto ? await getImage({ src: firstPhoto, width: 620, height: 620, fit: 'cover' }) : undefined;
  return { project, image, featured: photographyOrder.includes(project.id) };
}));
---

<StudioLayout title={`Photography — ${studioConfig.name}`} section="Photography" dark>
  <article class="photography">
    <header class="heading">
      <h1>Photography</h1>
      <p class="s-meta">{items.length} projects</p>
    </header>

    <div class="photo-grid">
      {items.map(({ project, image }) => (
        <a class="photo" href={`${base}/studio/projects/${project.id}/`} aria-label={`${project.data.title}, ${project.data.year}`}>
          <span class="image-frame">
            {image && <img src={image.src} alt="" width={image.attributes.width} height={image.attributes.height} loading="lazy" />}
          </span>
          <span class="caption">
            <span class="title">{project.data.title}</span>
            <time class="s-meta year">{project.data.year}</time>
          </span>
        </a>
      ))}
    </div>
  </article>
</StudioLayout>

<style>
  .photography { max-width: 1760px; margin: 0 auto; }
  .heading { position: sticky; top: calc(var(--studio-header-height) + 8px); z-index: 20; align-self: start; display: flex; align-items: baseline; justify-content: space-between; gap: 24px; padding: 0 0 16px; margin-bottom: 26px; background: var(--s-bg); border-bottom: 1px solid var(--s-line); }
  h1 { margin: 0; font-family: var(--s-serif); font-size: var(--studio-page-title-size); font-weight: 500; line-height: 1; }
  .heading p { margin: 0; }
  .photo-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: clamp(18px, 2.4vw, 38px); }
  .photo { display: block; min-width: 0; color: var(--s-ink); text-decoration: none; }
  .image-frame { display: block; aspect-ratio: 1; overflow: hidden; background: #2b2d30; }
  .image-frame img { display: block; width: 100%; height: 100%; object-fit: cover; }
  .caption { display: flex; align-items: baseline; justify-content: space-between; gap: 8px; margin-top: 9px; }
  .title { font-family: var(--s-mono); font-size: 11px; line-height: 1.45; }
  .photo:hover .title { text-decoration: underline; text-underline-offset: 3px; }
  .year { flex: 0 0 auto; font-size: 9px; }
  @media (max-width: 1050px) { .photo-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  @media (max-width: 720px) { .photo-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px 12px; } .heading { align-items: end; } }
  @media (max-width: 420px) { .photo-grid { grid-template-columns: 1fr 1fr; } .title { font-size: 10px; } }
</style>
