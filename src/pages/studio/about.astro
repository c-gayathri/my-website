---
import { getImage } from 'astro:assets';
import StudioLayout from '../../layouts/StudioLayout.astro';
import { studioConfig } from '../../data/studioConfig';
import { studioAbout } from '../../data/studioAbout';
import { externalLinks } from '../../data/externalLinks';
import aboutPhoto from '../../assets/about.jpg';

const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
const portraitImage = await getImage({ src: aboutPhoto, width: 560 });
const elsewhere = Object.entries(externalLinks).filter(([key, href]) => key !== 'research' && href);
const sampleImages = import.meta.glob<{ default: import('astro').ImageMetadata }>(
  '../../assets/studio/Influences/*.{png,jpg,jpeg,webp}',
  { eager: true },
);

const influences = await Promise.all(
  studioAbout.influences.map(async (influence) => {
    const image = Object.entries(sampleImages).find(([path]) => path.endsWith(`/${influence.file}`));
    if (!image) return null;
    const preview = await getImage({ src: image[1].default, width: 180 });
    const href = influence.href
      ? influence.href.startsWith('/') ? `${base}${influence.href}` : influence.href
      : undefined;
    return { ...influence, href, preview };
  }),
).then((items) => items.filter(Boolean) as Array<{
  title: string;
  href?: string;
  preview: Awaited<ReturnType<typeof getImage>>;
}>);
---

<StudioLayout title={`About — ${studioConfig.name}`} section="About" viewportFit>
  <article class="about">
    <h1 class="page-title">About</h1>
    <section class="intro" aria-labelledby="about-statement">
      <div class="copy">
        <h2 id="about-statement" class="statement">{studioAbout.statement}</h2>
        <div class="paragraphs">
          {studioAbout.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
        </div>
      </div>
      <figure class="portrait">
        <img
          src={portraitImage.src}
          alt={`Portrait of ${studioConfig.name}`}
          width={portraitImage.attributes.width}
          height={portraitImage.attributes.height}
          loading="eager"
        />
      </figure>
    </section>

    <div class="band">
      <section class="band-section education" aria-labelledby="education-title">
        <header class="section-head">
          <span class="s-meta">01</span>
          <h2 id="education-title">Education</h2>
        </header>
        {studioAbout.education.map((item) => (
          <div class="education-item">
            <strong>{item.title}</strong>
            <span class="s-meta">{item.place} · {item.period}</span>
          </div>
        ))}
        <p class="skills s-meta"><span>Working with</span> {studioAbout.skills.join(' · ')}</p>
      </section>

      <section class="band-section news" aria-labelledby="news-title">
        <header class="section-head">
          <span class="s-meta">02</span>
          <h2 id="news-title">News</h2>
        </header>
        <div class="news-scroll" tabindex="0" aria-label="News, scroll for more">
          {studioAbout.news.length ? (
            studioAbout.news.map((item) => (
              <article class="news-item">
                <time class="s-meta">{item.date}</time>
                <p>{item.text}</p>
              </article>
            ))
          ) : (
            <p class="s-meta" style="padding:8px 0; color:var(--s-faint);">No news yet.</p>
          )}
        </div>
      </section>

      <section class="band-section elsewhere" aria-labelledby="elsewhere-title">
        <header class="section-head">
          <span class="s-meta">03</span>
          <h2 id="elsewhere-title">Elsewhere</h2>
        </header>
        <div class="link-list">
          {elsewhere.map(([label, href]) => (
            <a href={href} target="_blank" rel="external">
              <span>{label}</span><span aria-hidden="true">↗</span>
            </a>
          ))}
          <a href={`${base}${externalLinks.research}`} target="_blank">
            <span>research</span><span aria-hidden="true">↗</span>
          </a>
        </div>
      </section>

      <section class="band-section influence-section" aria-labelledby="influences-title" data-influences>
        <header class="section-head">
          <span class="s-meta">04</span>
          <h2 id="influences-title">Influences</h2>
        </header>
        <div class="influence-grid">
          {influences.map((influence, index) => (
            <figure class="influence" data-extra={index >= 3 ? '' : undefined} hidden={index >= 3}>
              {influence.href ? (
                <a href={influence.href} aria-label={`${influence.title}, open related work`}>
                  <img src={influence.preview.src} alt="" width={influence.preview.attributes.width} height={influence.preview.attributes.height} loading="lazy" />
                  <figcaption>{influence.title} <span aria-hidden="true">↗</span></figcaption>
                </a>
              ) : (
                <div>
                  <img src={influence.preview.src} alt="" width={influence.preview.attributes.width} height={influence.preview.attributes.height} loading="lazy" />
                  <figcaption>{influence.title}</figcaption>
                </div>
              )}
            </figure>
          ))}
        </div>
        {influences.length > 3 && (
          <button class="influence-toggle s-meta" type="button" aria-expanded="false">
            <span data-more>view more +</span><span data-less hidden>view less −</span>
          </button>
        )}
      </section>
    </div>
  </article>
</StudioLayout>

<script>
  document.querySelectorAll<HTMLElement>('[data-influences]').forEach((section) => {
    const button = section.querySelector<HTMLButtonElement>('.influence-toggle');
    if (!button) return;
    button.addEventListener('click', () => {
      const expanded = button.getAttribute('aria-expanded') !== 'true';
      button.setAttribute('aria-expanded', String(expanded));
      section.querySelectorAll<HTMLElement>('[data-extra]').forEach((item) => {
        item.hidden = !expanded;
      });
      const more = button.querySelector<HTMLElement>('[data-more]');
      const less = button.querySelector<HTMLElement>('[data-less]');
      if (more) more.hidden = expanded;
      if (less) less.hidden = !expanded;
    });
  });
</script>

<style>
  .about {
    display: grid;
    grid-template-rows: auto minmax(0, 1.15fr) minmax(190px, .85fr);
    height: calc(100dvh - var(--studio-header-height) - var(--studio-footer-height) - 40px);
    min-height: 0;
    padding: 0 0 8px;
  }

  .page-title {
    margin: 0 0 4px;
    font-family: var(--s-serif);
    font-size: var(--studio-page-title-size);
    font-weight: 500;
    line-height: 1;
  }

  .intro {
    display: grid;
    grid-template-columns: minmax(400px, 1.1fr) minmax(210px, .9fr);
    align-items: center;
    gap: clamp(30px, 5vw, 90px);
    min-height: 0;
    padding: 8px 5vw 18px;
  }

  .portrait {
    min-width: 0;
    margin: 0;
  }

  .portrait img {
    display: block;
    width: 100%;
    max-width: 360px;
    aspect-ratio: 3 / 4;
    max-height: min(46dvh, 520px);
    object-fit: cover;
    object-position: center top;
  }

  .copy { min-width: 0; max-width: 650px; }

  .statement {
    max-width: 20ch;
    margin: 0;
    font-family: var(--s-serif);
    font-size: clamp(28px, 3vw, 45px);
    font-weight: 500;
    line-height: 1.04;
  }

  .paragraphs {
    display: grid;
    grid-template-columns: 1fr;
    gap: 10px;
    margin-top: 14px;
  }

  .paragraphs p {
    margin: 0;
    color: var(--s-grey);
    font-family: var(--s-mono);
    font-size: 10px;
    line-height: 1.55;
    max-width: 62ch;
  }

  .band {
    display: grid;
    grid-template-columns: 1.15fr 1fr .62fr 1.65fr;
    min-height: 0;
  }

  .band-section {
    min-width: 0;
    padding: 10px clamp(12px, 1.6vw, 25px) 0;
    border-left: 0;
  }
  .band-section:first-child { padding-left: 0; border-left: 0; }

  .section-head {
    display: flex;
    align-items: baseline;
    gap: 9px;
    padding-bottom: 8px;
  }

  h2 {
    margin: 0;
    font-family: var(--s-serif);
    font-size: 20px;
    font-weight: 500;
  }

  .demo-note { margin-left: auto; font-size: 8px; text-transform: uppercase; }
  .education-item { padding: 12px 0; border-bottom: 1px solid var(--s-line); }
  .education-item strong {
    display: block;
    font-family: var(--s-serif);
    font-size: 16px;
    font-weight: 500;
    line-height: 1.18;
  }
  .education-item span { display: block; margin-top: 5px; font-size: 9px; }
  .skills { margin: 12px 0 0; font-size: 9px; line-height: 1.55; }
  .skills span { display: block; margin-bottom: 4px; color: var(--s-ink); text-transform: uppercase; }

  .news-scroll {
    max-height: 190px;
    overflow-y: auto;
    overscroll-behavior: contain;
    scrollbar-width: thin;
  }
  .news-item {
    position: relative;
    padding: 8px 38px 8px 0;
    border-bottom: 1px solid var(--s-line);
  }
  .news-item p {
    margin: 3px 0 0;
    font-family: var(--s-serif);
    font-size: 14px;
    line-height: 1.15;
  }
  .news-item time { font-size: 8px; }
  .demo-badge {
    position: absolute;
    top: 9px;
    right: 3px;
    padding: 1px 3px;
    border: 1px solid var(--s-line);
    font-size: 7px;
    letter-spacing: .08em;
    text-transform: uppercase;
  }

  .link-list { display: grid; }
  .link-list a {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    padding: 9px 0;
    border-bottom: 1px solid var(--s-line);
    color: inherit;
    font-family: var(--s-mono);
    font-size: 10px;
    text-decoration: none;
  }
  .link-list a:hover span:first-child { text-decoration: underline; text-underline-offset: 3px; }

  .influence-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 8px;
    padding-top: 10px;
  }
  .influence { min-width: 0; margin: 0; }
  .influence[hidden] { display: none; }
  .influence a { display: block; color: inherit; text-decoration: none; }
  .influence img {
    display: block;
    width: 100%;
    height: 72px;
    object-fit: cover;
    filter: saturate(.85);
  }
  .influence figcaption {
    overflow: hidden;
    margin-top: 4px;
    font-family: var(--s-mono);
    font-size: 8px;
    line-height: 1.25;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .influence a:hover figcaption { text-decoration: underline; }
  .influence-toggle {
    margin-top: 10px;
    padding: 0 0 2px;
    border: 0;
    border-bottom: 1px solid currentColor;
    background: transparent;
    color: var(--s-ink);
    cursor: pointer;
    font-size: 9px;
  }

  @media (max-width: 1000px) {
    .about { display: block; height: auto; min-height: 0; padding-top: 4px; }
    .intro { grid-template-columns: minmax(320px, 1.1fr) minmax(190px, .9fr); padding-inline: 0; }
    .band { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .band-section { min-height: 260px; border-bottom: 0; }
    .band-section:nth-child(3) { padding-left: 0; border-left: 0; }
    .news-scroll { max-height: 190px; }
  }

  @media (max-width: 680px) {
    .intro { display: flex; flex-direction: column; align-items: stretch; padding-bottom: 36px; }
    .portrait { display: block; }
    .portrait img { max-height: none; }
    .statement { font-size: clamp(31px, 9vw, 42px); }
    .paragraphs { grid-template-columns: 1fr; gap: 12px; }
    .band { display: block; }
    .band-section, .band-section:nth-child(3) {
      min-height: 0;
      padding: 22px 0 28px;
      border-left: 0;
    }
    .news-scroll { max-height: 210px; }
    .influence img { height: 100px; }
  }
</style>
