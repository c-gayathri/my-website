---
// About page — photo, statement, numbered band (education / news /
// elsewhere / influences). Star clusters fill the empty spaces.
import { getImage } from 'astro:assets';
import StudioLayout from '../../layouts/StudioLayout.astro';
import { studioConfig } from '../../data/studioConfig';
import { studioAbout } from '../../data/studioAbout';
import { externalLinks } from '../../data/externalLinks';
import portrait from '../../assets/portrait.png';

const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
const elsewhere = Object.entries(externalLinks).filter(([k, v]) => k !== 'research' && v);

const sampleImages = import.meta.glob<{ default: import('astro').ImageMetadata }>(
  '../assets/studio/sample/*.{png,jpg,jpeg,webp}',
  { eager: true },
);
const influences = await Promise.all(
  studioAbout.influences.map(async (inf) => {
    const entry = Object.entries(sampleImages).find(([p]) => p.endsWith('/' + inf.file));
    if (!entry) return null;
    const g = await getImage({ src: entry[1].default, width: 320 });
    return { src: g.src, title: inf.title };
  }),
).then((list) => list.filter(Boolean) as Array<{ src: string; title: string }>);

function mulberry32(seed: number) {
  let a = seed >>> 0;
  return () => {
    a |= 0;
    a = (a + 0x6d2b79f5) | 0;
    let t = Math.imul(a ^ (a >>> 15), 1 | a);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}
const rand = mulberry32(studioConfig.layoutSeed + 29);
const sparkle = (x: number, y: number, s: number) => {
  const v = s;
  const h = s * 0.55;
  const k = s * 0.1;
  return `M${x},${y - v} Q${x + k},${y - k} ${x + h},${y} Q${x + k},${y + k} x,${y + v} Q${x - k},${y + k} ${x - h},${y} Q${x - k},${y - k} x,${y - v} Z`;
};
const groups: string[] = [];
for (let g = 0; g < 6; g++) {
  const gx = 20 + rand() * 60;
  const gy = 8 + rand() * 82;
  const n = 3 + Math.floor(rand() * 4);
  const parts: string[] = [];
  let px = 0;
  let py = 0;
  for (let k = 0; k <= n; k++) {
    const x = gx + (rand() - 0.5) * 8;
    const y = gy + (rand() - 0.5) * 10;
    if (k > 0)
      parts.push(`<path d="${sparkle(x, y, 1.6 + rand() * 2.4)}" fill="var(--s-ink)" opacity="0.6"/>`);
    px = x;
    py = y;
  }
  groups.push(parts.join(''));
}
const dust: string[] = [];
for (let i = 0; i < 30; i++) {
  dust.push(`<circle cx="${(rand() * 100).toFixed(1)}" cy="${(rand() * 100).toFixed(1)}" r="${(0.12 + rand() * 0.2).toFixed(2)}" fill="var(--s-ink)" opacity="${(0.2 + rand() * 0.4).toFixed(2)}"/>`);
}
---

<StudioLayout title={`About — ${studioConfig.name}`} section="About">
  <div class="about-page">
    <div class="about-canvas">
      {
        groups.map((g, i) => (
          <svg
            class="deco-mark"
            style={`left: ${(3 + ((i * 37) % 92)).toFixed(1)}%; top: ${(5 + ((i * 53) % 88)).toFixed(1)}%;`}
            width="110"
            height="110"
            viewBox="0 0 20 20"
            aria-hidden="true"
            set:html={g}
          />
        ))
      }
      {
        dust.map((d, i) => (
          <svg
            class="deco-mark"
            style={`left: ${(2 + ((i * 29) % 96)).toFixed(1)}%; top: ${(3 + ((i * 41) % 94)).toFixed(1)}%;`}
            width="5"
            height="5"
            viewBox="0 0 5 5"
            aria-hidden="true"
            set:html={d}
          />
        ))
      }

      <div class="about-grid">
        <div class="about-copy">
          <p class="statement">{studioAbout.statement}</p>
          {studioAbout.paragraphs.map((p) => (
            <p class="para">{p}</p>
          ))}
        </div>
        <figure class="about-photo">
          <img src={portrait.src} alt={`Portrait of ${studioConfig.name}`} width={portrait.width} height={portrait.height} loading="eager" />
        </figure>
      </div>

      <div class="band">
        <section>
          <header class="sec-head">
            <span class="sec-num s-meta">01</span>
            <span class="sec-title s-meta">education</span>
          </header>
          {
            studioAbout.education.map((e) => (
              <div class="edu">
                <p class="edu-title">{e.title}</p>
                <p class="s-meta">{e.place}</p>
                <p class="s-meta">{e.period}</p>
              </div>
            ))
          }
          <p class="s-meta skills-label">skills</p>
          <p class="s-meta skills">{studioAbout.skills.join(' · ')}</p>
        </section>

        <section>
          <header class="sec-head">
            <span class="sec-num s-meta">02</span>
            <span class="sec-title s-meta">news</span>
          </header>
          {
            studioAbout.news.map((n) => (
              <div class="news-item">
                <p class="s-meta">{n.date}</p>
                <p class="news-text">{n.text}</p>
              </div>
            ))
          }
        </section>

        <section>
          <header class="sec-head">
            <span class="sec-num s-meta">03</span>
            <span class="sec-title s-meta">elsewhere</span>
          </header>
          <div class="else-list">
            {
              elsewhere.map(([key, href]) => (
                <a class="s-meta el" href={href} target="_blank">
                  {key} ↗
                </a>
              ))
            }
            <a class="s-meta el" href={base + externalLinks.research} target="_blank">
              research ↗
            </a>
          </div>
        </section>

        <section class="influences">
          <header class="sec-head">
            <span class="sec-num s-meta">04</span>
            <span class="sec-title s-meta">influences</span>
          </header>
          <div class="inf-grid">
            {
              influences.map((inf) => (
                <figure>
                  <img src={inf.src} alt={inf.title} loading="lazy" />
                  <figcaption class="s-meta">{inf.title}</figcaption>
                </figure>
              ))
            }
          </div>
        </section>
      </div>
    </div>
  </div>
</StudioLayout>

<style>
  .about-page {
    position: relative;
    padding-bottom: 40px;
  }

  .about-canvas {
    position: relative;
  }

  .deco-mark {
    position: absolute;
    overflow: visible;
    pointer-events: none;
  }

  .about-grid {
    position: relative;
    display: grid;
    grid-template-columns: minmax(280px, 420px) minmax(0, 1fr);
    gap: clamp(32px, 5vw, 96px);
    align-items: center;
    padding-top: 24px;
  }

  .about-copy h1 {
    font-family: var(--s-serif);
    font-weight: 500;
    font-size: clamp(56px, 7vw, 100px);
    line-height: 0.95;
    margin: 10px 0 26px;
  }

  .statement {
    font-family: var(--s-serif);
    font-weight: 500;
    font-size: clamp(22px, 2.2vw, 30px);
    line-height: 1.35;
    margin: 0 0 26px;
  }

  .para {
    font-family: var(--s-mono);
    font-size: 12.5px;
    line-height: 1.85;
    color: var(--s-grey);
    margin: 0 0 16px;
    max-width: 46ch;
  }

  .about-photo {
    margin: 0;
  }

  .about-photo img {
    width: 100%;
    max-width: 480px;
    height: auto;
    display: block;
    margin: 0 auto;
  }

  .band {
    position: relative;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: clamp(24px, 3vw, 56px);
    margin-top: 90px;
    border-top: 1px solid var(--s-line);
    padding-top: 30px;
  }

  .sec-head {
    display: flex;
    align-items: baseline;
    gap: 10px;
    border-bottom: 1px solid var(--s-line);
    padding-bottom: 8px;
    margin-bottom: 16px;
  }

  .sec-num {
    color: var(--s-faint);
  }

  .sec-title {
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--s-ink);
  }

  .edu-title {
    font-family: var(--s-mono);
    font-size: 12.5px;
    line-height: 1.7;
    color: var(--s-ink);
    margin: 0 0 4px;
  }

  .edu p {
    margin: 0;
  }

  .edu + .edu {
    margin-top: 16px;
  }

  .skills-label {
    margin: 20px 0 6px;
    color: var(--s-faint);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    font-size: 10px;
  }

  .skills {
    line-height: 1.8;
    color: var(--s-grey);
  }

  .news-item {
    padding: 8px 0 12px;
    border-bottom: 1px solid var(--s-line);
  }

  .news-item p {
    margin: 0 0 4px;
  }

  .news-text {
    font-family: var(--s-mono);
    font-size: 12px;
    line-height: 1.6;
    color: var(--s-ink);
  }

  .else-list {
    display: flex;
    flex-direction: column;
    gap: 10px;
    align-items: flex-start;
  }

  .el {
    color: var(--s-ink);
  }

  .inf-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
  }

  .inf-grid figure {
    margin: 0;
  }

  .inf-grid img {
    width: 100%;
    height: 74px;
    object-fit: cover;
    display: block;
  }

  .inf-grid figcaption {
    margin-top: 4px;
    font-size: 10px;
    color: var(--s-grey);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  @media (max-width: 900px) {
    .about-grid {
      grid-template-columns: 1fr;
    }

    .band {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 560px) {
    .band {
      grid-template-columns: 1fr;
    }
  }
</style>
