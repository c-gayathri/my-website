---
import { getCollection, render } from 'astro:content';
import StudioLayout from '../../../layouts/StudioLayout.astro';
import { studioConfig } from '../../../data/studioConfig';

export async function getStaticPaths() {
  const books = await getCollection('books');
  return books.map((book) => ({ params: { slug: book.id }, props: { book } }));
}

const { book } = Astro.props;
const d = book.data;
const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
const hasReview = Boolean(book.body?.trim());
const { Content } = hasReview ? await render(book) : { Content: null };
const metadata = [
  d.rating != null ? `${d.rating} / 5` : 'not rated',
  d.dateFinished ? `finished ${d.dateFinished}` : `read ${d.yearRead}`,
];
---

<StudioLayout title={`${d.title} — ${studioConfig.bookshelfLabel}`} slim>
  <nav class="crumbs" aria-label="Breadcrumb">
    <a class="s-link" href={`${base}/studio/bookshelf/`}>← all books</a>
  </nav>

  <article class="book">
    <div class="cover-wrap">
      <img class="cover" src={d.cover.src} alt={`${d.title} by ${d.author}`} width={d.cover.width} height={d.cover.height} />
    </div>

    <div class="info">
      {hasReview && <p class="s-meta status">reviewed</p>}
      <h1 class={d.title.length > 40 ? 'long-title' : undefined}>{d.title}</h1>
      <p class="author">{d.author}</p>
      <p class="s-meta metadata">{metadata.join(' · ')}</p>
      {d.goodreadsLink && <a class="s-link external" href={d.goodreadsLink} target="_blank" rel="external">goodreads ↗</a>}

      {hasReview && Content ? (
        <section class="review" aria-label="Review">
          <Content />
        </section>
      ) : (
        <p class="empty s-meta">No review yet.</p>
      )}
    </div>
  </article>
</StudioLayout>

<style>
  .crumbs { margin: 2px 0 20px; }
  .crumbs a { color: var(--s-grey); }

  .book {
    display: grid;
    grid-template-columns: clamp(150px, 22vw, 250px) minmax(0, 620px);
    gap: clamp(28px, 5vw, 68px);
    align-items: start;
    max-width: 980px;
  }

  .cover-wrap { display: grid; gap: 8px; }
  .cover { display: block; width: 100%; height: auto; box-shadow: 0 4px 22px rgba(20, 18, 10, 0.16); }
  .cover-wrap .s-meta { color: var(--s-faint); }
  .status { margin: 2px 0 16px; color: var(--s-ink); letter-spacing: 0.13em; text-transform: uppercase; }

  h1 {
    margin: 0;
    font-family: var(--s-serif);
    font-size: clamp(34px, 5vw, 55px);
    font-weight: 500;
    line-height: 0.98;
  }

  h1.long-title {
    font-size: clamp(26px, 4vw, 40px);
    line-height: 1.02;
  }

  .author { margin: 9px 0 0; font-family: var(--s-serif); font-size: 21px; }
  .metadata { margin: 16px 0 0; }
  .external { display: inline-block; margin-top: 12px; }

  .review {
    max-width: 55ch;
    margin-top: 28px;
    border-top: 1px solid var(--s-line);
    padding-top: 18px;
    font-family: var(--s-serif);
    font-size: 18px;
    line-height: 1.65;
  }

  .review :global(p:first-child) { margin-top: 0; }
  .empty { margin-top: 28px; border-top: 1px solid var(--s-line); padding-top: 18px; }

  @media (max-width: 620px) {
    .book { grid-template-columns: minmax(110px, 36vw) minmax(0, 1fr); gap: 22px; }
    h1 { font-size: clamp(28px, 9vw, 40px); }
    .author { font-size: 18px; }
    .review, .empty { grid-column: 1 / -1; }
  }
</style>
