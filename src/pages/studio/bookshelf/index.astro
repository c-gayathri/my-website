---
import { getCollection } from 'astro:content';
import { getImage } from 'astro:assets';
import StudioLayout from '../../../layouts/StudioLayout.astro';
import { studioConfig } from '../../../data/studioConfig';
import { externalLinks } from '../../../data/externalLinks';

const books = await getCollection('books');
const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
const years = [...new Set(books.map((book) => book.data.yearRead))].sort((a, b) => b - a);
const challenge = studioConfig.readingChallenge as Record<number, { goal: number }>;
const palette = ['#ff4f9a', '#ffe600', '#35ef7d', '#ff643d', '#42d7ff', '#b68cff'];

const byYear = years.map((year) => ({
  year,
  goal: challenge[year]?.goal ?? books.filter((book) => book.data.yearRead === year).length,
  list: books
    .filter((book) => book.data.yearRead === year)
    .sort((a, b) => {
      const aHas = Boolean(a.data.dateFinished);
      const bHas = Boolean(b.data.dateFinished);
      if (aHas !== bHas) return aHas ? -1 : 1;
      return (a.data.dateFinished ?? a.data.title).localeCompare(b.data.dateFinished ?? b.data.title);
    }),
}));
const favourites = books.filter((book) => book.data.featured);
const favouriteThumbs = await Promise.all(
  favourites.map(async (book) => ({
    book,
    thumb: await getImage({ src: book.data.cover, width: 96 }),
  })),
);

const ratingOf = (rating?: number) => rating == null ? 'not rated' : `${rating} / 5`;
---

<StudioLayout title={`${studioConfig.bookshelfLabel} — ${studioConfig.name}`} section={studioConfig.bookshelfLabel}>
  <div class="bookshelf-page">
    <header class="shelf-intro">
      <h1>{studioConfig.bookshelfLabel}</h1>
      <p class="s-meta">{books.length} books</p>
    </header>

    <nav class="year-switcher" aria-label="Reading year">
      {years.map((year, index) => (
        <button class="s-link" type="button" data-year-button={year} aria-pressed={index === 0 ? 'true' : 'false'}>{year}</button>
      ))}
    </nav>

    {
      byYear.map(({ year, list, goal }, yearIndex) => (
        <section class="year" id={`y${year}`} aria-labelledby={`year-${year}`} data-year-panel={year} hidden={yearIndex !== 0}>
          <aside class="rail">
            <p class="s-meta rail-label">reading challenge</p>
            <p class="challenge-num" id={`year-${year}`}>
              <span class="big">{list.length}</span>
              <span class="s-meta"> / {goal} books</span>
            </p>
            <div class="bar" aria-label={`${list.length} of ${goal} books`}>
              <div class="fill" style={`width: ${Math.min(100, (list.length / goal) * 100)}%`} />
            </div>
            {favourites.length > 0 && (
              <section class="favourites" aria-labelledby="favourites-title">
                <h2 id="favourites-title">All time favourites</h2>
                <div class="favourite-covers">
                  {favouriteThumbs.map(({ book, thumb }) => (
                    <a href={`${base}/studio/bookshelf/${book.id}/`} aria-label={`${book.data.title} by ${book.data.author}`}>
                      <img src={thumb.src} alt="" width={thumb.attributes.width} height={thumb.attributes.height} loading="lazy" />
                    </a>
                  ))}
                </div>
              </section>
            )}
            {externalLinks.goodreads && (
              <a class="s-link goodreads-link" href={externalLinks.goodreads} target="_blank" rel="external">Goodreads ↗</a>
            )}
          </aside>

          <div class="shelf-wrap">
            <div class="covers" aria-label={`${year} books`}>
              {list.map((book, bookIndex) => {
                const hasReview = Boolean(book.body?.trim());
                const color = palette[(yearIndex * 3 + bookIndex) % palette.length];
                return (
                  <a
                    class="book-card"
                    href={`${base}/studio/bookshelf/${book.id}/`}
                    style={`--card-color: ${color}`}
                    data-book-card
                  >
                    <img
                      src={book.data.cover.src}
                      alt={`${book.data.title} by ${book.data.author}`}
                      width={book.data.cover.width}
                      height={book.data.cover.height}
                      loading="lazy"
                    />
                    {hasReview && <span class="reviewed s-meta">reviewed</span>}
                    <span class="overlay">
                      <span class={`title ${book.data.title.length > 32 ? 'title-long' : ''}`}>{book.data.title}</span>
                      <span class="author">{book.data.author}</span>
                      <span class="meta s-meta">
                        {ratingOf(book.data.rating)}<br />
                        {book.data.dateFinished ?? book.data.yearRead}
                      </span>
                      <span class="status s-meta">
                        {hasReview
                          ? book.data.excerpt ?? 'review available →'
                          : 'review not written yet →'}
                      </span>
                    </span>
                  </a>
                );
              })}
            </div>
          </div>
        </section>
      ))
    }
  </div>
</StudioLayout>

<script>
  const yearButtons = [...document.querySelectorAll<HTMLButtonElement>('[data-year-button]')];
  const yearPanels = [...document.querySelectorAll<HTMLElement>('[data-year-panel]')];
  const availableYears = yearButtons.map((button) => button.dataset.yearButton).filter(Boolean);

  const selectYear = (year: string, updateHash = true) => {
    if (!availableYears.includes(year)) year = availableYears[0] ?? '';
    yearButtons.forEach((button) => button.setAttribute('aria-pressed', String(button.dataset.yearButton === year)));
    yearPanels.forEach((panel) => { panel.hidden = panel.dataset.yearPanel !== year; });
    if (updateHash && year) history.pushState(null, '', `#y${year}`);
  };

  yearButtons.forEach((button) => button.addEventListener('click', () => selectYear(button.dataset.yearButton ?? '')));
  const syncHash = () => selectYear(location.hash.replace(/^#y/, ''), false);
  window.addEventListener('hashchange', syncHash);
  syncHash();

  const coarsePointer = window.matchMedia('(hover: none), (pointer: coarse)');
  const cards = [...document.querySelectorAll<HTMLElement>('[data-book-card]')];

  document.addEventListener('click', (event) => {
    if (!coarsePointer.matches) return;
    const card = (event.target as Element).closest<HTMLElement>('[data-book-card]');

    if (!card) {
      cards.forEach((item) => item.removeAttribute('data-revealed'));
      return;
    }

    if (!card.hasAttribute('data-revealed')) {
      event.preventDefault();
      cards.forEach((item) => item.toggleAttribute('data-revealed', item === card));
    }
  });
</script>

<style>
  .bookshelf-page {
    height: calc(100dvh - var(--studio-header-height) - var(--studio-footer-height) - 24px);
    min-height: 540px;
    overflow: hidden;
  }

  .shelf-intro {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 24px;
    margin: 0 0 10px;
    padding-bottom: 8px;
  }

  .shelf-intro p { margin: 0; }
  .shelf-intro h1 { margin:0; font-family:var(--s-serif); font-size:var(--studio-page-title-size); font-weight:500; line-height:1; }

  .year-switcher { display:flex; gap:16px; margin:0 0 16px; }
  .year-switcher button { padding:0 0 3px; border:0; border-bottom:1px solid transparent; background:transparent; cursor:pointer; }
  .year-switcher button[aria-pressed='true'] { border-bottom-color:currentColor; }

  .year[hidden] { display:none; }

  .year {
    display: grid;
    grid-template-columns: clamp(180px, 18vw, 250px) minmax(0, 1fr);
    gap: clamp(24px, 4vw, 64px);
    align-items: start;
    margin-top: 0;
    height: calc(100% - 92px);
  }

  .rail { position: sticky; left: 0; padding-top: 3px; }
  .rail-label { color: var(--s-ink); letter-spacing: 0.16em; text-transform: uppercase; }
  .challenge-num { margin: 12px 0 0; }
  .challenge-num .big { font-family: var(--s-serif); font-size: 52px; line-height: 1; }
  .bar { width: min(100%, 190px); height: 5px; border: 1px solid var(--s-ink); margin-top: 13px; }
  .fill { height: 100%; background: var(--s-ink); }
  .favourites { margin-top:28px; }
  .favourites h2 { margin:0 0 12px; font-family:var(--s-serif); font-size:22px; font-weight:500; }
  .favourite-covers { display:flex; gap:7px; flex-wrap:wrap; max-height:220px; overflow-y:auto; overscroll-behavior:contain; scrollbar-width:thin; padding-right:4px; }
  .favourite-covers a { display:block; }
  .favourite-covers img { display:block; width:48px; height:72px; object-fit:cover; box-shadow:0 2px 8px rgba(20,18,10,.12); }
  .goodreads-link { display:inline-block; margin-top:14px; }

  .shelf-wrap {
    min-width: 0;
    overflow-x: auto;
    overscroll-behavior-inline: contain;
    overflow-y: hidden;
    padding: 3px 3px 10px;
  }

  .covers {
    display: grid;
    --cover-height: clamp(132px, calc((100dvh - var(--studio-header-height) - var(--studio-footer-height) - 150px) / 3), 182px);
    --cover-width: calc(var(--cover-height) * .667);
    grid-template-rows: repeat(3, var(--cover-height));
    grid-auto-flow: column;
    grid-auto-columns: var(--cover-width);
    gap: 10px 15px;
    width: max-content;
  }

  .book-card {
    position: relative;
    display: block;
    width: var(--cover-width);
    height: calc(var(--cover-height) - 7px);
    color: #16130f;
    text-decoration: none;
    overflow: hidden;
    box-shadow: 0 3px 13px rgba(20, 18, 10, 0.16);
    isolation: isolate;
    transition: transform 180ms ease, box-shadow 180ms ease;
  }

  .book-card:hover,
  .book-card:focus-visible,
  .book-card[data-revealed] {
    transform: translateY(-3px) rotate(-0.2deg);
    box-shadow: 0 7px 18px rgba(20, 18, 10, 0.19);
  }

  .book-card img { display: block; width: 100%; height: 100%; object-fit: cover; }

  .reviewed {
    position: absolute;
    top: 7px;
    right: 0;
    z-index: 4;
    padding: 3px 6px 3px 7px;
    color: var(--s-bg);
    background: rgba(18, 17, 14, 0.86);
    font-size: 8px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .overlay {
    position: absolute;
    inset: 0;
    z-index: 3;
    display: flex;
    flex-direction: column;
    padding: 14px 12px;
    background: var(--card-color);
    transform: translateY(101%);
    transition: transform 220ms cubic-bezier(0.22, 0.75, 0.28, 1);
  }

  .book-card:hover .overlay,
  .book-card:focus-visible .overlay,
  .book-card[data-revealed] .overlay { transform: translateY(0); }

  .title { font-family: var(--s-serif); font-size: 21px; font-weight: 600; line-height: 0.98; }
  .title-long { font-size: 15px; line-height: 1.02; }
  .author { margin-top: 7px; font-family: var(--s-mono); font-size: 9px; line-height: 1.35; }
  .meta { margin-top: 13px; color: currentColor; font-size: 8px; line-height: 1.55; }
  .status { margin-top: auto; color: currentColor; font-size: 8px; line-height: 1.45; }

  @media (prefers-reduced-motion: reduce) {
    .overlay, .book-card { transition: none; }
    .book-card:hover, .book-card:focus-visible, .book-card[data-revealed] { transform: none; }
  }

  @media (max-width: 700px) {
    .bookshelf-page { height: auto; min-height: 0; overflow: visible; }
    .shelf-intro { display: block; }
    .shelf-intro p:last-child { margin-top: 8px; }
    .year { grid-template-columns: 1fr; gap: 18px; height: auto; }
    .rail { position: static; }
    .covers { grid-template-rows: repeat(2, 184px); grid-auto-columns: 114px; }
    .book-card { width: 114px; height: 171px; }
  }
</style>
