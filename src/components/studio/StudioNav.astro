---
// Studio navigation. Labels come from studioConfig so sections can be
// renamed without touching this file. All links are base-path aware.
//
// variant "full"  — standard pages: small STUDIO wordmark + prominent name
// variant "slim"  — detail pages: everything on one quiet line
import { studioConfig } from '../../data/studioConfig';

interface Props {
  variant?: 'full' | 'slim';
}

const { variant = 'full' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
const path = Astro.url.pathname;

const navItems = [
  { label: 'Constellation', href: `${base}/studio/` },
  { label: studioConfig.writingLabel, href: `${base}/studio/writing/` },
  { label: studioConfig.bookshelfLabel, href: `${base}/studio/bookshelf/` },
  { label: studioConfig.indexLabel, href: `${base}/studio/index/` },
];

const isActive = (href: string) => {
  const clean = href.replace(/\/$/, '');
  return path === href || path === clean || path.startsWith(clean);
};
---

<header class:list={['studio-nav', variant]}>
  <div class="nav-left">
    <a class="wordmark" href={`${base}/studio/`}>STUDIO</a>
    <a class="name" href={`${base}/studio/`}>{studioConfig.name}</a>
    {
      variant === 'full' && (
        <span class="tagline">{studioConfig.tagline}</span>
      )
    }
  </div>

  <nav class="nav-right" aria-label="Studio">
    {
      navItems.map((item) => (
        <a
          class:list={['s-link', { active: isActive(item.href) }]}
          href={item.href}
          aria-current={isActive(item.href) ? 'page' : undefined}
        >
          {item.label}
        </a>
      ))
    }
  </nav>
</header>

<style>
  .studio-nav {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 24px;
    padding: 24px clamp(24px, 4vw, 72px) 0;
  }

  .nav-left {
    display: flex;
    align-items: baseline;
    gap: 18px;
    min-width: 0;
    flex-wrap: wrap;
  }

  .wordmark {
    font-family: var(--s-mono);
    font-size: 12px;
    letter-spacing: 0.22em;
    text-decoration: none;
    color: var(--s-grey);
  }

  .name {
    font-family: var(--s-serif);
    font-weight: 500;
    font-size: 24px;
    letter-spacing: 0.01em;
    text-decoration: none;
    color: var(--s-ink);
    line-height: 1;
  }

  /* constellation page: the name is the identity — larger */
  .studio-nav.full .name {
    font-size: clamp(28px, 3vw, 40px);
  }

  .tagline {
    font-family: var(--s-mono);
    font-size: 11.5px;
    color: var(--s-grey);
    white-space: nowrap;
  }

  .nav-right {
    display: flex;
    align-items: baseline;
    gap: clamp(18px, 3vw, 44px);
    flex-wrap: wrap;
    justify-content: flex-end;
  }

  .s-link.active {
    text-decoration: underline;
    text-underline-offset: 5px;
  }

  @media (max-width: 760px) {
    .studio-nav {
      flex-direction: column;
      gap: 12px;
    }

    .nav-left {
      flex-direction: column;
      gap: 6px;
    }
  }
</style>
