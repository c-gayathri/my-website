---
// Studio navigation. The name is leftmost; STUDIO lives in the footer.
// The active state matches exactly — the Constellation link is only
// underlined on /studio itself, not across the whole /studio section.
import { studioConfig } from '../../data/studioConfig';

interface Props {
  variant?: 'full' | 'slim';
}

const { variant = 'full' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
const path = Astro.url.pathname.replace(/\/+$/, '');

const navItems = [
  { label: 'Constellation', href: `${base}/studio`, exact: true },
  { label: studioConfig.writingLabel, href: `${base}/studio/writing`, exact: false },
  { label: studioConfig.bookshelfLabel, href: `${base}/studio/bookshelf`, exact: false },
  { label: studioConfig.indexLabel, href: `${base}/studio/index`, exact: false },
];

const isActive = (item: (typeof navItems)[number]) =>
  item.exact ? path === item.href : path === item.href || path.startsWith(item.href);
---

<header class:list={['studio-nav', variant]}>
  <div class="nav-left">
    <a class="name" href={`${base}/studio/`}>{studioConfig.name}</a>
    {
      variant === 'full' && (
        <span class="tagline">{studioConfig.tagline}</span>
      )
    }
  </div>

  <nav class="nav-right" aria-label="Studio">
    {
      navItems.map((item) => (
        <a
          class:list={['s-link', { active: isActive(item) }]}
          href={`${item.href}/`}
          aria-current={isActive(item) ? 'page' : undefined}
        >
          {item.label}
        </a>
      ))
    }
  </nav>
</header>

<style>
  .studio-nav {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 24px;
    padding: 24px clamp(24px, 4vw, 72px) 0;
  }

  .nav-left {
    display: flex;
    align-items: baseline;
    gap: 18px;
    min-width: 0;
    flex-wrap: wrap;
  }

  .name {
    font-family: var(--s-serif);
    font-weight: 500;
    font-size: clamp(28px, 3vw, 40px);
    letter-spacing: 0.01em;
    text-decoration: none;
    color: var(--s-ink);
    line-height: 1;
  }

  /* detail pages: the name steps back */
  .studio-nav.slim .name {
    font-size: 20px;
  }

  .tagline {
    font-family: var(--s-mono);
    font-size: 11.5px;
    color: var(--s-grey);
    white-space: nowrap;
  }

  .nav-right {
    display: flex;
    align-items: baseline;
    gap: clamp(18px, 3vw, 44px);
    flex-wrap: wrap;
    justify-content: flex-end;
  }

  .s-link.active {
    text-decoration: underline;
    text-underline-offset: 5px;
  }

  @media (max-width: 760px) {
    .studio-nav {
      flex-direction: column;
      gap: 12px;
    }

    .nav-left {
      flex-direction: column;
      gap: 6px;
    }
  }
</style>
