---
// Studio navigation. Labels come from studioConfig so sections can be
// renamed without touching this file. All links are base-path aware.
import { studioConfig } from '../../data/studioConfig';
import { externalLinks } from '../../data/externalLinks';

const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
const path = Astro.url.pathname;

const navItems = [
  { label: studioConfig.writingLabel, href: `${base}/studio/writing/` },
  { label: studioConfig.bookshelfLabel, href: `${base}/studio/bookshelf/` },
  { label: studioConfig.indexLabel, href: `${base}/studio/index/` },
];

const isActive = (href: string) =>
  path === href || path === href.replace(/\/$/, '') || path.startsWith(href);
---

<header class="studio-nav">
  <div class="nav-left">
    <a class="wordmark s-wordmark" href={`${base}/studio/`}>STUDIO</a>
    <div class="who">
      <span class="name">{studioConfig.name}</span>
      <span class="tagline">{studioConfig.tagline}</span>
    </div>
  </div>

  <nav class="nav-right" aria-label="Studio">
    {
      navItems.map((item) => (
        <a
          class:list={['s-link', { active: isActive(item.href) }]}
          href={item.href}
          aria-current={isActive(item.href) ? 'page' : undefined}
        >
          {item.label}
        </a>
      ))
    }
    <a class="s-link research" href={externalLinks.research}>Research ↗</a>
  </nav>
</header>

<style>
  .studio-nav {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 24px;
    padding: 26px clamp(24px, 4vw, 72px) 0;
  }

  .nav-left {
    display: flex;
    align-items: baseline;
    gap: 28px;
    min-width: 0;
  }

  .wordmark {
    font-size: 30px;
    letter-spacing: 0.06em;
    text-decoration: none;
    color: var(--s-ink);
    line-height: 1;
  }

  .who {
    display: flex;
    flex-direction: column;
    gap: 3px;
    font-family: var(--s-mono);
    font-size: 11.5px;
    color: var(--s-grey);
    white-space: nowrap;
  }

  .nav-right {
    display: flex;
    align-items: baseline;
    gap: clamp(18px, 3vw, 44px);
    flex-wrap: wrap;
    justify-content: flex-end;
  }

  .s-link.active {
    text-decoration: underline;
    text-underline-offset: 5px;
  }

  .research {
    color: var(--s-grey);
  }

  @media (max-width: 760px) {
    .studio-nav {
      flex-direction: column;
      gap: 14px;
    }

    .nav-left {
      flex-direction: column;
      gap: 8px;
    }
  }
</style>
