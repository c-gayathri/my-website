---
// Shared Studio navigation. Page names live in each page's content area.
import { studioConfig } from '../../data/studioConfig';

interface Props {
  variant?: 'full' | 'compact';
  section?: string;
}

const { variant = 'compact' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
const path = Astro.url.pathname.replace(/\/+$/, '');

const navItems = [
  { label: 'Constellation', href: base + '/studio', exact: true },
  { label: studioConfig.writingLabel, href: base + '/studio/writing', exact: false },
  { label: studioConfig.bookshelfLabel, href: base + '/studio/bookshelf', exact: false },
  { label: studioConfig.indexLabel, href: base + '/studio/index', exact: false },
  { label: 'About', href: base + '/studio/about', exact: false },
];

const isActive = (item: (typeof navItems)[number]) =>
  item.exact ? path === item.href : path === item.href || path.startsWith(item.href);
---

<header class:list={['studio-nav', `nav-${variant}`]}>
  <div class="nav-left">
    <a class="name" href={base + '/studio/'}>{studioConfig.name}</a>
    <span class="tagline">{studioConfig.tagline}</span>
  </div>

  <nav class="nav-right" aria-label="Studio">
    {navItems.map((item) => (
      <a
        class:list={['s-link', { active: isActive(item) }]}
        href={item.href + '/'}
        aria-current={isActive(item) ? 'page' : undefined}
      >
        {item.label}
      </a>
    ))}
  </nav>
</header>

<style>
  .studio-nav {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 24px;
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 30;
    padding: 18px var(--studio-gutter) 0;
    background: var(--s-bg);
  }

  .nav-left {
    display: flex;
    align-items: baseline;
    gap: 18px;
    flex-wrap: wrap;
  }

  .name {
    font-family: var(--s-serif);
    font-weight: 500;
    font-size: clamp(22px, 2vw, 28px);
    color: var(--s-ink);
    text-decoration: none;
    line-height: 1;
  }

  .nav-full .name {
    font-size: clamp(34px, 3.5vw, 52px);
  }

  .nav-compact .nav-left {
    gap: 14px;
  }

  .tagline {
    font-family: var(--s-mono);
    font-size: 11.5px;
    color: var(--s-grey);
    white-space: nowrap;
  }

  .nav-right {
    display: flex;
    align-items: baseline;
    gap: clamp(18px, 3vw, 44px);
    flex-wrap: wrap;
    justify-content: flex-end;
  }

  .s-link.active {
    text-decoration: underline;
    text-underline-offset: 5px;
  }

  @media (max-width: 900px) {
    .studio-nav {
      flex-direction: column;
      gap: 12px;
    }

    .nav-left {
      flex-direction: column;
      gap: 8px 12px;
    }

    .nav-right { width: 100%; justify-content: flex-start; gap: 9px 16px; }
    .nav-right .s-link { font-size: 10px; }
    .tagline { font-size: 9.5px; }
  }
</style>
