---
// Studio navigation.
// - Constellation: name leftmost (prominent) + tagline.
// - Inner pages: section title topmost, name smaller beside it.
import { studioConfig } from '../../data/studioConfig';

interface Props {
  variant?: string;
  section?: string;
}

const { section } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
const path = Astro.url.pathname.replace(/\/+$/, '');

const navItems = [
  { label: 'Constellation', href: base + '/studio', exact: true },
  { label: studioConfig.writingLabel, href: base + '/studio/writing', exact: false },
  { label: studioConfig.bookshelfLabel, href: base + '/studio/bookshelf', exact: false },
  { label: studioConfig.indexLabel, href: base + '/studio/index', exact: false },
  { label: 'About', href: base + '/studio/about', exact: false },
];

const isActive = (item: (typeof navItems)[number]) =>
  item.exact ? path === item.href : path === item.href || path.startsWith(item.href);
---

<header class="studio-nav">
  <div class="nav-left">
    {section ? (
      <span class="section-title">{section}</span>
    ) : (
      <a class="name" href={base + '/studio/'}>{studioConfig.name}</a>
    )}
    {section && <a class="name-small s-meta" href={base + '/studio/'}>{studioConfig.name}</a>}
    {section ? null : <span class="tagline">{studioConfig.tagline}</span>}
  </div>

  <nav class="nav-right" aria-label="Studio">
    {navItems.map((item) => (
      <a
        class:list={['s-link', { active: isActive(item) }]}
        href={item.href + '/'}
        aria-current={isActive(item) ? 'page' : undefined}
      >
        {item.label}
      </a>
    ))}
  </nav>
</header>

<style>
  .studio-nav {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 24px;
    padding: 24px clamp(24px, 4vw, 72px) 0;
  }

  .nav-left {
    display: flex;
    align-items: baseline;
    gap: 18px;
    flex-wrap: wrap;
  }

  .name {
    font-family: var(--s-serif);
    font-weight: 500;
    font-size: clamp(28px, 3vw, 40px);
    color: var(--s-ink);
    text-decoration: none;
    line-height: 1;
  }

  .section-title {
    font-family: var(--s-serif);
    font-weight: 500;
    font-size: clamp(30px, 3.2vw, 44px);
    color: var(--s-ink);
    line-height: 1;
  }

  .name-small {
    color: var(--s-grey);
  }

  .name-small:hover {
    color: var(--s-ink);
  }

  .tagline {
    font-family: var(--s-mono);
    font-size: 11.5px;
    color: var(--s-grey);
    white-space: nowrap;
  }

  .nav-right {
    display: flex;
    align-items: baseline;
    gap: clamp(18px, 3vw, 44px);
    flex-wrap: wrap;
    justify-content: flex-end;
  }

  .s-link.active {
    text-decoration: underline;
    text-underline-offset: 5px;
  }

  @media (max-width: 760px) {
    .studio-nav {
      flex-direction: column;
      gap: 12px;
    }

    .nav-left {
      flex-direction: column;
      gap: 6px;
    }
  }
</style>
