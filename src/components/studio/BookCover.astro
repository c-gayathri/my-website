---
import type { ImageMetadata } from 'astro';
import placeholderCover from '../../assets/studio/covers/book-cover-placeholder.svg';

interface Props {
  cover: ImageMetadata | string;
  title: string;
  author: string;
  alt?: string;
  width?: number;
  height?: number;
  loading?: 'eager' | 'lazy';
  class?: string;
  coverLookup?: boolean;
  fallbackSrc?: string;
}

const {
  cover,
  title,
  author,
  alt = `${title} by ${author}`,
  width,
  height,
  loading = 'lazy',
  class: className,
  coverLookup = false,
  fallbackSrc,
} = Astro.props;
const localCover = typeof cover !== 'string';
const src = localCover ? cover.src : cover;
const imageWidth = width ?? (localCover ? cover.width : 600);
const imageHeight = height ?? (localCover ? cover.height : 900);
---

<img
  src={src}
  alt={alt}
  width={imageWidth}
  height={imageHeight}
  loading={loading}
  class={className}
  data-book-cover-search={coverLookup ? '' : undefined}
  data-cover-title={coverLookup ? title : undefined}
  data-cover-author={coverLookup ? author : undefined}
  data-cover-fallback={coverLookup ? placeholderCover.src : undefined}
  data-cover-recovery={fallbackSrc}
/>

<script>
  const requestLargeCover = async (img: HTMLImageElement) => {
    if (img.dataset.coverSearchState) return;
    img.dataset.coverSearchState = 'loading';
    const title = img.dataset.coverTitle ?? '';
    const author = img.dataset.coverAuthor ?? '';
    const queryTitle = title.replace(/\s*\([^)]*\)\s*$/, '');
    const query = new URLSearchParams({
      q: `intitle:"${queryTitle}" inauthor:"${author}"`,
      maxResults: '5',
      projection: 'full',
      printType: 'books',
    });

    try {
      const response = await fetch(`https://www.googleapis.com/books/v1/volumes?${query}`);
      if (!response.ok) throw new Error(`Google Books returned ${response.status}`);
      const result = await response.json();
      const books = Array.isArray(result.items) ? result.items : [];
      const titleKey = queryTitle.toLocaleLowerCase().replace(/[^\p{L}\p{N}]+/gu, ' ').trim();
      const authorKey = author.toLocaleLowerCase().replace(/[^\p{L}\p{N}]+/gu, ' ').trim();
      const match = books.find((book: any) => {
        const info = book.volumeInfo ?? {};
        const resultTitle = String(info.title ?? '').toLocaleLowerCase().replace(/[^\p{L}\p{N}]+/gu, ' ').trim();
        const resultAuthors = (info.authors ?? []).join(' ').toLocaleLowerCase().replace(/[^\p{L}\p{N}]+/gu, ' ').trim();
        return (resultTitle.includes(titleKey) || titleKey.includes(resultTitle))
          && (!authorKey || resultAuthors.includes(authorKey) || authorKey.includes(resultAuthors))
          && info.imageLinks;
      }) ?? books.find((book: any) => book.volumeInfo?.imageLinks);
      const images = match?.volumeInfo?.imageLinks;
      const imageUrl = images?.extraLarge ?? images?.large ?? images?.medium ?? images?.small;
      if (!imageUrl) throw new Error('No cover image in Google Books results');
      img.src = String(imageUrl).replace(/^http:/, 'https:');
      img.dataset.coverSearchState = 'loaded';
    } catch {
      img.dataset.coverSearchState = 'failed';
    }
  };

const coverImages = [...document.querySelectorAll<HTMLImageElement>('[data-book-cover-search], [data-cover-recovery]')];
  coverImages.forEach((img) => {
    const handleCoverError = () => {
      if (img.dataset.coverRecovery && !img.dataset.coverRecoveryTried) {
        img.dataset.coverRecoveryTried = 'true';
        img.src = img.dataset.coverRecovery;
        return;
      }
      if (img.dataset.coverFallback) {
        img.src = img.dataset.coverFallback;
        void requestLargeCover(img);
      }
    };
    img.addEventListener('error', handleCoverError);

    if (img.complete && img.naturalWidth === 0) handleCoverError();
  });
</script>
