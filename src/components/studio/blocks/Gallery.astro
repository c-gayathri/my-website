---
// MDX block: an irregular gallery — varying widths, alternating baselines.
import Place from './Place.astro';
import type { ImageMetadata } from 'astro';

interface Props {
  images: Array<ImageMetadata | string>;
  alts?: string[];
  captions?: string[];
  caption?: string;
  /** Set to override the existing staggered variable-width gallery layout. */
  columns?: 1 | 2 | 3 | 4;
  preset?: 'centered' | 'large' | 'left' | 'right';
}

const { images, alts = [], captions = [], caption, columns, preset = 'large' } = Astro.props;
const WIDTHS = [38, 27, 45, 30, 36, 26];
---

<Place {preset}>
  <div class:list={['gallery', columns ? 'gallery--columns' : '']} style={columns ? `--gallery-columns:${columns}` : undefined}>
    {
      images.map((im, i) => {
        const url = typeof im === 'string' ? im : im.src;
        const dims = typeof im === 'string' ? {} : { width: im.width, height: im.height };
        const itemCaption = captions[i];
        return (
          <figure class="gallery-item" style={!columns ? `width: ${WIDTHS[i % WIDTHS.length]}%; margin-top: ${i % 2 === 1 ? 34 : 0}px;` : undefined}>
            <img
              src={url}
              alt={alts[i] ?? ''}
              {...dims}
              loading="lazy"
            />
            {itemCaption && <figcaption class="s-meta">{itemCaption}</figcaption>}
          </figure>
        );
      })
    }
  </div>
  {caption && <p class="gallery-caption s-meta">{caption}</p>}
</Place>

<style>
  .gallery {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    align-items: flex-start;
  }

  .gallery-item { margin: 0; }
  .gallery-item img { width: 100%; }
  .gallery-item figcaption, .gallery-caption { margin: 8px 0 0; }
  .gallery--columns { display: grid; grid-template-columns: repeat(var(--gallery-columns), minmax(0, 1fr)); }
  .gallery--columns .gallery-item { width: auto; margin-top: 0; }
  .gallery--columns img { width: 100% !important; margin-top: 0 !important; }

  img {
    height: auto;
    display: block;
    box-shadow: 0 2px 18px rgba(20, 18, 10, 0.08);
  }

  @media (max-width: 640px) {
    .gallery-item { width: 100% !important; margin-top: 0 !important; }
    img {
      width: 100% !important;
      margin-top: 0 !important;
    }
  }
</style>
