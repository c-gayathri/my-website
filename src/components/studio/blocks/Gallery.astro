---
// MDX block: an irregular gallery — varying widths, alternating baselines.
import Place from './Place.astro';
import type { ImageMetadata } from 'astro';

interface Props {
  images: Array<ImageMetadata | string>;
  alts?: string[];
  preset?: 'centered' | 'large' | 'left' | 'right';
}

const { images, alts = [], preset = 'large' } = Astro.props;
const WIDTHS = [38, 27, 45, 30, 36, 26];
---

<Place {preset}>
  <div class="gallery">
    {
      images.map((im, i) => {
        const url = typeof im === 'string' ? im : im.src;
        const dims = typeof im === 'string' ? {} : { width: im.width, height: im.height };
        return (
          <img
            src={url}
            alt={alts[i] ?? ''}
            {...dims}
            loading="lazy"
            style={`width: ${WIDTHS[i % WIDTHS.length]}%; margin-top: ${i % 2 === 1 ? 34 : 0}px;`}
          />
        );
      })
    }
  </div>
</Place>

<style>
  .gallery {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    align-items: flex-start;
  }

  img {
    height: auto;
    display: block;
    box-shadow: 0 2px 18px rgba(20, 18, 10, 0.08);
  }

  @media (max-width: 640px) {
    img {
      width: 100% !important;
      margin-top: 0 !important;
    }
  }
</style>
