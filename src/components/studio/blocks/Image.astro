---
// MDX block: a single image with editorial placement.
import Place from './Place.astro';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata | string;
  alt?: string;
  preset?: 'centered' | 'left' | 'right' | 'offset-left' | 'offset-right' | 'narrow' | 'narrow-left' | 'large' | 'full-bleed';
  colStart?: number;
  colSpan?: number;
  offsetY?: number;
  offsetX?: number;
  /** Resize the image within its grid cell, e.g. "72%", "420px", "85%" */
  width?: string;
  /** Optional CSS height for the image, e.g. "480px" or "70vh" */
  height?: string;
  /** Scale factor 0.5–1.5 for fine tuning */
  scale?: number;
  caption?: string;
  class?: string;
}

const { src, alt = '', preset, colStart, colSpan, offsetY, offsetX, width, height, scale, caption, class: className } = Astro.props;
const url = typeof src === 'string' ? src : src.src;
const w = typeof src === 'string' ? undefined : src.width;
const h = typeof src === 'string' ? undefined : src.height;
const imgStyle = [width ? `width:${width};` : '', height ? `height:${height};` : '', scale ? `transform:scale(${scale}); transform-origin:center;` : ''].join('');
---

<Place {preset} {colStart} {colSpan} {offsetY} {offsetX} class={className}>
  <figure class="blk-image">
    <img src={url} {alt} width={w} height={h} loading="lazy" style={imgStyle || undefined} />
    {caption && <figcaption class="s-meta">{caption}</figcaption>}
  </figure>
</Place>

<style>
  .blk-image {
    margin: 0;
  }

  img {
    width: 100%;
    height: auto;
    display: block;
    box-shadow: 0 2px 18px rgba(20, 18, 10, 0.08);
  }

  figcaption {
    margin-top: 8px;
  }
</style>
