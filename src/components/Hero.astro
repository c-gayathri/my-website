---
// Hero area: portrait, name, role, short introduction, profile links.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { profile } from '../data/profile';

const { name, intro, links } = profile;

// The portrait is picked up automatically: drop a file named
// portrait.(png|jpg|jpeg|webp|svg) into src/assets/ — no code change
// needed. Astro optimizes and resizes it at build time.
const candidates = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/portrait.{png,jpg,jpeg,webp,svg}',
  { eager: true },
);
const portraitPath = ['png', 'jpg', 'jpeg', 'webp', 'svg']
  .map((ext) => `../assets/portrait.${ext}`)
  .find((path) => path in candidates);

if (!portraitPath) {
  throw new Error(
    'No portrait found. Add src/assets/portrait.(png|jpg|jpeg|webp|svg)',
  );
}
const portrait = candidates[portraitPath].default;
---

<div class="hero">
  <div class="hero-id">
    <Image
      src={portrait}
      alt={`Portrait of ${name}`}
      width={480}
      height={600}
      class="portrait"
      loading="eager"
    />
    <h1>{name}</h1>
  </div>
  {intro.map((paragraph) => <p class="intro-line">{paragraph}</p>)}

  <ul class="links-row profile-links">
    <li>
      <a href={links.github} rel="me noopener noreferrer" target="_blank">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path
            d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"
          />
        </svg>
        GitHub
      </a>
    </li>
    <li>
      <a href={links.linkedin} rel="me noopener noreferrer" target="_blank">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path
            d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"
          />
        </svg>
        LinkedIn
      </a>
    </li>
    <li>
      <a href={links.scholar} rel="me noopener noreferrer" target="_blank">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M12 2 1.5 8l4.1 2.35V16h2.2v-4.4L12 14l10.5-6L12 2Zm7.2 9.65v5.1c0 1.65-3.25 3.25-7.2 3.25s-7.2-1.6-7.2-3.25v-5.1L12 15.8l7.2-4.15Z" />
        </svg>
        Google Scholar
      </a>
    </li>
  </ul>
</div>

<style>
  .hero-id {
    display: flex;
    align-items: flex-end;
    gap: 22px;
  }

  .portrait {
    width: min(170px, 42vw);
    height: auto;
  }

  h1 {
    font-size: clamp(26px, 2.4vw, 36px);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.12;
    margin: 0 0 8px;
  }

  .intro-line {
    font-size: 13.5px;
    line-height: 1.55;
    color: var(--ink-soft);
    margin: 11px 0 0;
  }

  .profile-links {
    margin-top: 16px;
  }

  .profile-links a {
    display: inline-flex;
    align-items: center;
    gap: 7px;
  }

  svg {
    width: 15px;
    height: 15px;
    fill: currentColor;
  }
</style>
